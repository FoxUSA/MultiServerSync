<Application
  x:Class="MultiServerSync.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:core="clr-namespace:MultiServerSync.Core"
  xmlns:sys="clr-namespace:System;assembly=mscorlib"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="/Themes/DataGridStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--  кнопки-значки во всей программе — один размер: шапки панелей проводника, окна команд,
            шапка вывода, лупа. Правится здесь, а не в каждом месте  -->
      <sys:Double x:Key="IconButtonSize">36</sys:Double>
      <sys:Double x:Key="IconGlyphSize">20</sys:Double>

      <!--  длинные и многострочные команды в выпадающих списках показываются одной короткой строкой  -->
      <core:ShortLineConverter x:Key="ShortLine" />

      <!--  свитч «Везде» рядом с «Выполнить»: включён — красным, как была кнопка «Выполнить везде».
            Тема та же, подменены только кисти включённой заливки; обводки у включённого нет  -->
      <Style
        x:Key="DangerSwitchStyle"
        BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}"
        TargetType="ui:ToggleSwitch">
        <Style.Resources>
          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#E5483B" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#EE5A4D" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#C93A2F" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent" />
        </Style.Resources>
      </Style>

      <!--
        Выделение строки: полупрозрачный акцент вместо системного «Highlight».
        Системный красит строку сплошным цветом и заодно меняет цвет текста на белый —
        в тёмной теме строка становится нечитаемой. Полупрозрачный работает в обеих темах:
        текст остаётся своего цвета.
      -->
      <SolidColorBrush x:Key="AppRowSelectedBrush" Color="#554CA6FF" />
      <SolidColorBrush x:Key="AppRowHoverBrush" Color="#224CA6FF" />

      <!--  WPF UI не оформляет шапку GridView — по умолчанию она светлая в любой теме  -->
      <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="GridViewColumnHeader">
              <Border
                x:Name="Bd"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,1">
                <ContentPresenter
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="Role" Value="Padding">
                  <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,1" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--  крестик «убрать эту строку из истории» внутри выпадающего списка  -->
      <Style x:Key="HistoryRemoveButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="ToolTip" Value="Удалить из истории" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border
                x:Name="Bd"
                Background="{TemplateBinding Background}"
                CornerRadius="4">
                <TextBlock
                  x:Name="Glyph"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="11"
                  Foreground="{TemplateBinding Foreground}"
                  Text="&#x2715;" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                  <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--  значки в конце строки таблицы («Копирование», «Скачивание»): копировать и вписать путь —
            как в адресной строке «Проводника», только мельче, под высоту строки  -->
      <Style x:Key="RowPathButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border
                x:Name="Bd"
                Background="{TemplateBinding Background}"
                CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--  значок кнопки «Исключения»: белый на плашке — фиолетовой, если заданы только общие исключения,
            тускло-зелёной, если есть свои у вкладки (с общими или без); иначе обычный.
            Плашка есть всегда, только прозрачная: кнопка не меняет размер. Зелёный триггер ниже — он и перебивает  -->
      <Style x:Key="ExcludeBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding HasGlobalExcludes}" Value="True">
            <Setter Property="Background" Value="#6B4FA8" />
          </DataTrigger>
          <DataTrigger Binding="{Binding HasExcludes}" Value="True">
            <Setter Property="Background" Value="#2E7D3E" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="ExcludeGlyphStyle" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Symbol" Value="Filter24" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding HasGlobalExcludes}" Value="True">
            <Setter Property="Foreground" Value="White" />
          </DataTrigger>
          <DataTrigger Binding="{Binding HasExcludes}" Value="True">
            <Setter Property="Foreground" Value="White" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!--  карандаш «изменить эту запись» — рядом с крестиком в выпадающем списке  -->
      <Style x:Key="RowEditButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="ToolTip" Value="Изменить название и код" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border
                x:Name="Bd"
                Background="{TemplateBinding Background}"
                CornerRadius="4">
                <TextBlock
                  x:Name="Glyph"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="11"
                  Foreground="{TemplateBinding Foreground}"
                  Text="&#x270E;" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                  <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Style>

      <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
