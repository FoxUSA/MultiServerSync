<Application
  x:Class="MultiServerSync.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:core="clr-namespace:MultiServerSync.Core"
  xmlns:pages="clr-namespace:MultiServerSync.Views.Pages"
  xmlns:sys="clr-namespace:System;assembly=mscorlib"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="/Themes/DataGridStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--  кнопки-значки во всей программе — один размер: шапки панелей проводника, окна команд,
            шапка вывода, лупа. Правится здесь, а не в каждом месте  -->
      <sys:Double x:Key="IconButtonSize">36</sys:Double>
      <sys:Double x:Key="IconGlyphSize">20</sys:Double>

      <!--  подпись сервера: у правого края ряда разделов и в шапке вынесенного окна «Мониторинга»; подсветка под мышью  -->
      <Style x:Key="ServerTagStyle" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <!--  сервер «Проводника» — как отмеченный сервер в панели слева: тусклая оранжевая рамка
                    на тусклом оранжевом фоне; под мышью и при нажатии фон чуть плотнее  -->
              <Border
                x:Name="Bd"
                Padding="10,5"
                Background="{DynamicResource Pick.Fill}"
                BorderBrush="{DynamicResource Pick.Stroke}"
                BorderThickness="1"
                CornerRadius="6">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pick.FillHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pick.FillPressed}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--
        WPF UI 4.3: при нажатии шаблон кнопки берёт цвет привязкой к TemplatedParent на самой кнопке. Её там нет,
        и текст откатывается к системному чёрному. Триггер стиля сильнее триггера шаблона, поэтому цвет задаём здесь.
        У акцентной кнопки текст и так тёмный — её цвет остаётся темы. Страницы наследуют это через BasedOn.
        База — именованный стиль темы: {x:Type ui:Button} здесь сослался бы на этот же стиль, и кнопки стали бы системными.
      -->
      <Style BasedOn="{StaticResource DefaultUiButtonStyle}" TargetType="ui:Button">
        <Style.Triggers>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundPressed}" />
          </Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsPressed" Value="True" />
              <Condition Property="Appearance" Value="Primary" />
            </MultiTrigger.Conditions>
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
          </MultiTrigger>
        </Style.Triggers>
      </Style>

      <!--
        Подсказки: в WPF UI тень висит на рамке вместе с текстом, текст рисуется через эффект и расплывается.
        Здесь тень у отдельной подложки, а числа и кисти те же, что в теме.
      -->
      <Style BasedOn="{StaticResource DefaultToolTipStyle}" TargetType="ToolTip">
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToolTip">
              <ui:EffectThicknessDecorator Thickness="15">
                <Grid>
                  <Border Background="{TemplateBinding Background}" CornerRadius="4">
                    <Border.Effect>
                      <DropShadowEffect
                        BlurRadius="10"
                        Direction="270"
                        Opacity="0.135"
                        ShadowDepth="5"
                        Color="{DynamicResource Tooltip.Shadow.Color}" />
                    </Border.Effect>
                  </Border>
                  <Border
                    Padding="8"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <ContentPresenter
                      Margin="4"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                      <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                          <Setter Property="TextWrapping" Value="WrapWithOverflow" />
                        </Style>
                      </ContentPresenter.Resources>
                    </ContentPresenter>
                  </Border>
                </Grid>
              </ui:EffectThicknessDecorator>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--
        Значки поверх поля ввода, в его правом верхнем углу: места на странице не занимают,
        а действие относится ровно к тому полю, над которым висят. «Команда» и мини-терминал «Копирования».
      -->
      <Style x:Key="EditorIconStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border
                x:Name="Bd"
                Background="{TemplateBinding Background}"
                CornerRadius="4"
                TextElement.Foreground="{TemplateBinding Foreground}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
                <!--  пока команда идёт, запуск погашен — видно, что второй раз не нажать  -->
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.35" />
                </Trigger>
                <!--  делать нечего: значок тусклый, но жмётся — нажатие мигает рамкой окна  -->
                <Trigger Property="pages:CommandPage.Idle" Value="True">
                  <Setter Property="Opacity" Value="0.35" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--  длинные и многострочные команды в выпадающих списках показываются одной короткой строкой  -->
      <core:ShortLineConverter x:Key="ShortLine" />

      <!--  Цветов здесь нет: всё, что зависит от темы, лежит в Themes\Dark и Themes\Light (см. Core\AppTheme).
            Оттуда же — DangerSwitchStyle и кисти строк таблиц AppRowSelectedBrush, AppRowHoverBrush, AppRowAltBrush:
            выделение строки — полупрозрачный цвет вместо системного «Highlight», текст остаётся своего цвета  -->

      <!--  WPF UI не оформляет шапку GridView — по умолчанию она светлая в любой теме  -->
      <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="GridViewColumnHeader">
              <Border
                x:Name="Bd"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,1">
                <ContentPresenter
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="Role" Value="Padding">
                  <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,1" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--  крестик «убрать эту строку из истории» внутри выпадающего списка  -->
      <Style x:Key="HistoryRemoveButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="ToolTip" Value="Удалить из истории" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border
                x:Name="Bd"
                Background="{TemplateBinding Background}"
                CornerRadius="4">
                <TextBlock
                  x:Name="Glyph"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="11"
                  Foreground="{TemplateBinding Foreground}"
                  Text="&#x2715;" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Danger.Fill}" />
                  <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Danger.OnFill}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--  значок у строки списка (избранное, история) — рядом с ✎ и ✕, того же размера и с той же заливкой под мышью  -->
      <Style x:Key="RowIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border
                x:Name="Bd"
                Background="{TemplateBinding Background}"
                CornerRadius="4"
                TextElement.Foreground="{TemplateBinding Foreground}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                  <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource Accent.OnFill}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--  значки в конце строки таблицы («Копирование», «Скачивание»): копировать и вписать путь —
            как в адресной строке «Проводника», только мельче, под высоту строки  -->
      <Style x:Key="RowPathButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border
                x:Name="Bd"
                Background="{TemplateBinding Background}"
                CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--  стрелки отмены и значок в ряду разделов: без дела тусклые  -->
      <Style
        x:Key="UndoButtonStyle"
        BasedOn="{StaticResource RowPathButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="26" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.35" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!--  значок кнопки «Исключения»: белый на плашке — фиолетовой, если заданы только общие исключения,
            тускло-зелёной, если есть свои у вкладки (с общими или без); иначе обычный.
            Плашка есть всегда, только прозрачная: кнопка не меняет размер. Зелёный триггер ниже — он и перебивает  -->
      <Style x:Key="ExcludeBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding HasGlobalExcludes}" Value="True">
            <Setter Property="Background" Value="{DynamicResource Exclude.Global}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding HasExcludes}" Value="True">
            <Setter Property="Background" Value="{DynamicResource Exclude.Own}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="ExcludeGlyphStyle" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Symbol" Value="Filter24" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding HasGlobalExcludes}" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource Exclude.OnBadge}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding HasExcludes}" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource Exclude.OnBadge}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!--  карандаш «изменить эту запись» — рядом с крестиком в выпадающем списке  -->
      <Style x:Key="RowEditButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="ToolTip" Value="Изменить название и код" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border
                x:Name="Bd"
                Background="{TemplateBinding Background}"
                CornerRadius="4">
                <TextBlock
                  x:Name="Glyph"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="11"
                  Foreground="{TemplateBinding Foreground}"
                  Text="&#x270E;" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                  <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent.OnFill}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Style>

      <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
