<?xml version="1.0"?>
<!--  YAML: docker-compose, ansible, netplan, k8s  -->
<SyntaxDefinition name="YAML" extensions=".yml;.yaml" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="Green" />
  <Color name="String" foreground="Brown" />
  <Color name="FieldName" foreground="SteelBlue" />
  <Color name="Bool" foreground="Blue" />
  <Color name="NumberLiteral" foreground="DarkGreen" />
  <Color name="Variable" foreground="DarkCyan" />
  <Color name="Punctuation" foreground="Gray" />

  <RuleSet ignoreCase="true">
    <Span color="Comment" begin="(?&lt;=^|\s)#" />

    <Span color="String" begin="&quot;" end="&quot;">
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>
    <Span color="String" begin="(?&lt;![\w])'" end="'" />

    <Rule color="FieldName">^\s*(-\s+)?[^\s#'"\-][^:#]*?(?=:(\s|$))</Rule>
    <Rule color="Punctuation">^(---|\.\.\.)\s*$</Rule>
    <Rule color="Variable">[&amp;*][\w-]+|\{\{[^}]*\}\}|\$\{[^}]*\}</Rule>

    <Keywords color="Bool">
      <Word>true</Word><Word>false</Word><Word>yes</Word><Word>no</Word><Word>on</Word><Word>off</Word><Word>null</Word>
    </Keywords>

    <Rule color="NumberLiteral">(?&lt;=[\s:\[,-])-?\d+(\.\d+)?(?=\s*($|[,\]#]))</Rule>
    <Rule color="Punctuation">^\s*-(?=\s)|[|&gt;](?=\s*$)</Rule>
  </RuleSet>
</SyntaxDefinition>
