<!--  Оформление таблиц взято из проекта ReSeeder  -->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="AppDataGridStyle" TargetType="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="SelectionMode" Value="Extended" />
    <Setter Property="SelectionUnit" Value="FullRow" />

    <!--  нативные линии выключены — сетка рисуется шаблонами ячеек  -->
    <Setter Property="GridLinesVisibility" Value="None" />

    <Setter Property="RowHeight" Value="26" />
    <Setter Property="ColumnHeaderHeight" Value="28" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="AlternationCount" Value="2" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource ControlFillColorDefaultBrush}" />

    <Setter Property="RowHeaderWidth" Value="0" />
    <Setter Property="HeadersVisibility" Value="Column" />

    <Setter Property="CanUserResizeRows" Value="False" />
    <!--  Ширины столбцов — по содержимому (Auto) и одна звёздочка; тянуть их руками не даём,
          но не здесь: с CanUserResizeColumns=False таблица перестаёт расширять Auto-столбцы
          под текст ячеек, и они остаются шириной с заголовок. Растягивание убрано в шапке —
          у хваталок на границах столбцов (ColResizeGripperStyle)  -->
    <Setter Property="CanUserResizeColumns" Value="True" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="ColumnWidth" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
    <Setter Property="ClipboardCopyMode" Value="IncludeHeader" />
  </Style>

  <Style x:Key="AppDataGridRowStyle" TargetType="DataGridRow">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="24" />
    <Style.Triggers>
      <Trigger Property="AlternationIndex" Value="1">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource AppRowHoverBrush}" />
      </Trigger>
      <!--  цвет текста не трогаем: подсветка полупрозрачная, строка остаётся читаемой  -->
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource AppRowSelectedBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--  хваталка на границе столбцов спрятана: ширину руками не меняют — она по содержимому  -->
  <Style x:Key="ColResizeGripperStyle" TargetType="Thumb">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AppDataGridCellStyle" TargetType="DataGridCell">
    <!--  окно полупрозрачное (Mica), и без подсказки WPF рисует текст на прозрачном фоне серым
          сглаживанием — он выходит тоньше и мутнее, чем в поле вывода рядом, где ClearType есть  -->
    <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,1">
            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!--  У выделенной ячейки системная тема WPF красит текст «цветом текста выделения» —
            в тёмной теме WPF UI он почти чёрный, и на синей строке текст становился мутным.
            Цвет текста — как у остальных строк; цветной статус задаёт сам столбец и остаётся  -->
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="AppColumnHeaderStyle" TargetType="DataGridColumnHeader">
    <!--  высоту задаёт сама таблица (ColumnHeaderHeight) — иначе шапка не совпадает со строками  -->
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SeparatorVisibility" Value="Collapsed" />
    <Setter Property="SeparatorBrush" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border
              x:Name="Bd"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="0,1,1,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  RecognizesAccessKey="True" />
                <!--  стрелка, как в проводнике: по какому столбцу и в какую сторону отсортировано  -->
                <Path
                  x:Name="SortArrow"
                  Grid.Column="1"
                  Width="8"
                  Height="5"
                  Margin="6,0,0,0"
                  VerticalAlignment="Center"
                  Data="M0,5 L4,1 L8,5"
                  Stretch="None"
                  Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                  StrokeThickness="1.2"
                  Visibility="Collapsed" />
              </Grid>
            </Border>
            <Thumb
              x:Name="PART_RightHeaderGripper"
              Width="8"
              HorizontalAlignment="Right"
              Style="{StaticResource ColResizeGripperStyle}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SortDirection" Value="Ascending">
              <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="SortDirection" Value="Descending">
              <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
              <Setter TargetName="SortArrow" Property="Data" Value="M0,0 L4,4 L8,0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style
    x:Key="FirstColumnCellStyle"
    BasedOn="{StaticResource AppDataGridCellStyle}"
    TargetType="DataGridCell">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1,0,1,1">
            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style
    x:Key="FirstColumnHeaderStyle"
    BasedOn="{StaticResource AppColumnHeaderStyle}"
    TargetType="DataGridColumnHeader">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border
              x:Name="Bd"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1,1,1,1">
              <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                RecognizesAccessKey="True" />
            </Border>
            <Thumb
              x:Name="PART_RightHeaderGripper"
              Width="8"
              HorizontalAlignment="Right"
              Style="{StaticResource ColResizeGripperStyle}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
