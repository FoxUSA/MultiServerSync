<!--
  СВЕТЛАЯ ТЕМА — свои значения кистей библиотеки WPF UI, которыми пользуется программа.
  В тёмной теме этого нет: там кисти библиотеки берутся как есть (Themes\Dark\Library.xaml пуст).
  Стандарт — .dev\THEME-STANDARD.md. Три ступени поверхности: окно серое, карточка почти белая,
  рабочая поверхность (таблицы, вывод) белая — текст читается на самом светлом. Ступени близкие,
  поэтому у каждой поверхности тонкая рамка. Текст не чёрный и не полупрозрачный: сплошные серо-синие тона.
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--  поверхности  -->
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F0F2F5" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F0F2F5" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#F8F9FB" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FFFFFF" />

  <!--  текст: основной 15:1, второй 7.5:1, третий 5:1, выключенный 2.6:1 (на белом)  -->
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1F2328" />
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#4A5560" />
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#626C77" />
  <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#9AA2AC" />

  <!--  рамки: тонкая — у полей, таблиц и ячеек; заметнее — у карточек  -->
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#DCE0E5" />
  <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#CBD1D8" />
  <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#DCE0E5" />

  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />

  <!--
    ПОДСВЕТКА ПОД МЫШЬЮ — ОДНА НА ВСЁ (23.11, «делай везде одинаковый»): кнопки, разделы, ярлыки,
    строки списков, меню. Полупрозрачное затемнение 12%, нажатие — 18%: одинаково заметно и на белой
    кнопке, и на сером окне, и на полосе разделов. У библиотеки в светлой своё — почти белое #80F9F9F9,
    на белой кнопке его не видно; здесь оно заменено.
    Цвет задан ОДИН РАЗ ниже (Hover / Pressed) — все кисти подсветки ссылаются на него, менять только здесь.
  -->
  <Color x:Key="Light.Hover">#1F1F3A5C</Color>
  <Color x:Key="Light.Pressed">#2E1F3A5C</Color>
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource Light.Hover}" />
  <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource Light.Pressed}" />
  <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource Light.Hover}" />
  <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource Light.Pressed}" />
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Light.Hover}" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Light.Pressed}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{StaticResource Light.Hover}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{StaticResource Light.Pressed}" />
  <SolidColorBrush x:Key="CardBackgroundPointerOver" Color="{StaticResource Light.Hover}" />
  <SolidColorBrush x:Key="CardBackgroundPressed" Color="{StaticResource Light.Pressed}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource Light.Hover}" />
  <SolidColorBrush x:Key="TimePickerButtonBackgroundPointerOver" Color="{StaticResource Light.Hover}" />
  <SolidColorBrush x:Key="TimePickerButtonBackgroundPressed" Color="{StaticResource Light.Pressed}" />
  <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="{StaticResource Light.Hover}" />
  <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="{StaticResource Light.Pressed}" />
  <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{StaticResource Light.Hover}" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{StaticResource Light.Hover}" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{StaticResource Light.Pressed}" />
  <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="{StaticResource Light.Hover}" />
  <SolidColorBrush x:Key="MenuBarItemBackgroundPressed" Color="{StaticResource Light.Pressed}" />

</ResourceDictionary>
