<UserControl
  x:Class="MultiServerSync.Views.Controls.AnswerBar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <!--  строка ответа: видна, пока команда сервера идёт и принимает ввод;
        подсвечивается, когда команда остановилась на вопросе  -->
  <Border
    Padding="6,5"
    BorderThickness="0,1,0,0"
    Visibility="{Binding CanAnswer, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsWaitingInput}" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ui:TextBox
        x:Name="AnswerBox"
        Grid.Column="0"
        MinHeight="0"
        Padding="8,3"
        ClearButtonEnabled="False"
        FontFamily="Consolas"
        FontSize="12"
        PlaceholderText="Ответ команде — Enter: этому серверу, Ctrl+Enter: всем, Ctrl+D: конец ввода"
        PreviewKeyDown="OnAnswerKeyDown" />

      <ui:Button
        Grid.Column="1"
        Margin="6,0,0,0"
        Padding="9,2"
        Appearance="Primary"
        Click="OnSendAnswer"
        Content="Ответить"
        FontSize="11"
        ToolTip="Отправить строку команде этого сервера (Enter). Пустая строка — просто Enter, ответ по умолчанию" />

      <ui:Button
        Grid.Column="2"
        Margin="6,0,0,0"
        Padding="9,2"
        Click="OnSendAnswerAll"
        Content="Всем серверам"
        FontSize="11"
        ToolTip="Отправить ту же строку командам всех серверов, где они ещё идут (Ctrl+Enter)" />
    </Grid>
  </Border>
</UserControl>
