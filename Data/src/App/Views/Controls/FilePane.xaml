<UserControl
  x:Class="MultiServerSync.Views.Controls.FilePane"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Focusable="False">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  кнопки панели инструментов: квадратные, только значок, как в проводнике  -->
    <Style
      x:Key="PaneButtonStyle"
      BasedOn="{StaticResource {x:Type ui:Button}}"
      TargetType="ui:Button">
      <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
      <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="FontSize" Value="{StaticResource IconGlyphSize}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Appearance" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
    </Style>

    <!--  часть адреса: плоский текст, подсветка под мышью  -->
    <Style x:Key="CrumbButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <!--  размер шрифта — от ряда частей пути: он ужимается, чтобы адрес влез целиком  -->
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Padding="4,2"
              Background="Transparent"
              CornerRadius="4">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  крестик сброса маски: виден, пока маска не пустая, — забытый фильтр молча прячет файлы  -->
    <Style x:Key="MaskClearButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="Transparent"
              CornerRadius="4">
              <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                FontSize="10"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="&#xE711;" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      значки в контейнерах у адреса и в ряду под ним: прозрачные, подсветка под мышью.
      Значки — SymbolIcon WPF UI (один набор везде), белые; размер задаёт сам значок: у адреса 16, в ряду 20
    -->
    <Style x:Key="PathIconButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style
      x:Key="GroupIconButtonStyle"
      BasedOn="{StaticResource PathIconButtonStyle}"
      TargetType="Button">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="32" />
    </Style>

    <!--  контейнер значков у адреса — тот же фон и рамка, что у самого пути  -->
    <Style x:Key="PathGroupStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="4,0" />
    </Style>

    <!--  стрелка раскрытия в дереве  -->
    <Style x:Key="TreeExpanderStyle" TargetType="ToggleButton">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border
              Width="16"
              Height="16"
              Background="Transparent">
              <Path
                x:Name="Arrow"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="M 5 2 L 10 7 L 5 12"
                RenderTransformOrigin="0.5,0.5"
                Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="1.4">
                <Path.RenderTransform>
                  <RotateTransform Angle="0" />
                </Path.RenderTransform>
              </Path>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Arrow" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="90" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  строка списка: скрытые файлы приглушены, как в проводнике. Курсор — рамкой: он
          отдельно от галочек, щелчок по строке её не отмечает. Рамка есть у всех строк,
          прозрачная, — чтобы строка с курсором не становилась выше  -->
    <Style
      x:Key="PaneRowStyle"
      BasedOn="{StaticResource AppDataGridRowStyle}"
      TargetType="DataGridRow">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsHidden}" Value="True">
          <Setter Property="Opacity" Value="0.6" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCursor}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </DataTrigger>
        <!--  папка, на которую сейчас бросят перетаскиваемое  -->
        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
          <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <!--  рамка активной панели — цветом акцента: видно, куда пойдут клавиши  -->
  <Border
    x:Name="Frame"
    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="4">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--
        Адрес — первой строкой. У сервера слева его значок (щелчок — список серверов) и домашняя
        папка. В самом адресе: у компьютера слева «Открыть», справа — копировать и вписать путь.
        Части пути — кнопки, щелчок по пустому месту (Ctrl+L, F4) открывает ввод пути на месте частей.
      -->
      <Grid
        x:Name="AddressRow"
        Grid.Row="0"
        Height="{StaticResource IconButtonSize}"
        Margin="8,4,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
          x:Name="ServerGroup"
          Grid.Column="0"
          Margin="0,0,4,0"
          Style="{StaticResource PathGroupStyle}"
          Visibility="Collapsed">
          <StackPanel
            x:Name="ServerIcons"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button
              x:Name="TitleButton"
              Click="OnTitleClick"
              Cursor="Arrow"
              Style="{StaticResource PathIconButtonStyle}">
              <Image
                x:Name="TitleIcon"
                Width="16"
                Height="16" />
            </Button>
            <Button
              Click="OnHome"
              Style="{StaticResource PathIconButtonStyle}"
              ToolTip="Домашняя папка">
              <ui:SymbolIcon FontSize="16" Symbol="Home24" />
            </Button>
          </StackPanel>
        </Border>

        <!--  фон светлее кнопок — путь читается полем адреса, а не ещё одной кнопкой  -->
        <Border
          x:Name="CrumbBar"
          Grid.Column="1"
          Cursor="IBeam"
          MouseLeftButtonDown="OnCrumbBarClick"
          Style="{StaticResource PathGroupStyle}"
          ToolTip="Щелчок по части пути — перейти, по пустому месту — вписать путь">
          <DockPanel>
            <!--  у компьютера — системное окно «Открыть папку»  -->
            <Button
              x:Name="WindowsExplorerButton"
              VerticalAlignment="Center"
              Click="OnOpenInWindows"
              DockPanel.Dock="Left"
              Style="{StaticResource PathIconButtonStyle}"
              ToolTip="Выбрать папку в окне Windows — она откроется здесь"
              Visibility="Collapsed">
              <ui:SymbolIcon FontSize="16" Symbol="FolderOpen24" />
            </Button>
            <StackPanel
              x:Name="PathTools"
              VerticalAlignment="Center"
              DockPanel.Dock="Right"
              Orientation="Horizontal">
              <Button
                Click="OnCopyPath"
                Style="{StaticResource PathIconButtonStyle}"
                ToolTip="Копировать путь">
                <ui:SymbolIcon FontSize="16" Symbol="Copy24" />
              </Button>
              <Button
                Click="OnEditPath"
                Style="{StaticResource PathIconButtonStyle}"
                ToolTip="Вписать путь (Ctrl+L)">
                <ui:SymbolIcon FontSize="16" Symbol="Edit24" />
              </Button>
            </StackPanel>

            <!--  части пути и на их месте — ввод пути; поле скрыто, но не убрано: ничего не прыгает  -->
            <Grid>
              <ScrollViewer
                x:Name="CrumbScroll"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Disabled">
                <StackPanel
                  x:Name="Crumbs"
                  Margin="2,0"
                  TextElement.FontSize="13"
                  VerticalAlignment="Center"
                  Orientation="Horizontal" />
              </ScrollViewer>
              <ui:TextBox
                x:Name="PathBox"
                MinHeight="0"
                Margin="0,2"
                Padding="8,0,34,0"
                VerticalContentAlignment="Center"
                ClearButtonEnabled="False"
                KeyDown="OnPathKeyDown"
                LostKeyboardFocus="OnPathLostFocus"
                PreviewKeyDown="OnPathPreviewKeyDown"
                TextChanged="OnPathTextChanged"
                ToolTip="Адрес папки. Впишите путь и нажмите Enter"
                Visibility="Hidden" />
              <Button
                x:Name="PathGoButton"
                Margin="0,0,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="OnPathGo"
                Style="{StaticResource PathIconButtonStyle}"
                ToolTip="Перейти (Enter)"
                Visibility="Hidden">
                <ui:SymbolIcon FontSize="16" Symbol="ArrowRight24" />
              </Button>
            </Grid>
          </DockPanel>
        </Border>

        <!--  подсказки подпапок, пока вписывают путь  -->
        <Popup
          x:Name="SuggestPopup"
          AllowsTransparency="True"
          Placement="Bottom"
          PlacementTarget="{Binding ElementName=PathBox}"
          StaysOpen="False">
          <Border
            MinWidth="{Binding ActualWidth, ElementName=PathBox}"
            MaxHeight="260"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ListBox
              x:Name="SuggestList"
              Focusable="False"
              MouseUp="OnSuggestPicked" />
          </Border>
        </Popup>
      </Grid>

      <!--  навигация и действия: слева ходьба по папкам и правка/удаление, справа обновить, дерево, закладки  -->
      <Grid
        Grid.Row="1"
        Height="{StaticResource IconButtonSize}"
        Margin="8,4,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border
          Grid.Column="0"
          Margin="0,0,4,0"
          Style="{StaticResource PathGroupStyle}">
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Button
              x:Name="BackButton"
              Click="OnBack"
              Style="{StaticResource GroupIconButtonStyle}"
              ToolTip="Назад (Alt+←)">
              <ui:SymbolIcon FontSize="20" Symbol="ArrowLeft24" />
            </Button>
            <Button
              x:Name="ForwardButton"
              Click="OnForward"
              Style="{StaticResource GroupIconButtonStyle}"
              ToolTip="Вперёд (Alt+→)">
              <ui:SymbolIcon FontSize="20" Symbol="ArrowRight24" />
            </Button>
            <Button
              Click="OnUp"
              Style="{StaticResource GroupIconButtonStyle}"
              ToolTip="На уровень вверх (Backspace)">
              <ui:SymbolIcon FontSize="20" Symbol="ArrowUp24" />
            </Button>
            <Button
              Click="OnRoot"
              Style="{StaticResource GroupIconButtonStyle}"
              ToolTip="В корень: на сервере — /, на компьютере — корень диска, из него — «Этот компьютер»">
              <ui:SymbolIcon FontSize="20" Symbol="ArrowUpload24" />
            </Button>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PathGroupStyle}">
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Button
              Click="OnEdit"
              Style="{StaticResource GroupIconButtonStyle}"
              ToolTip="Править файл под курсором во встроенном редакторе: номера строк, подсветка, поиск. Права и кодировка не меняются">
              <ui:SymbolIcon FontSize="20" Symbol="DocumentEdit24" />
            </Button>
            <Button
              Click="OnDelete"
              Style="{StaticResource GroupIconButtonStyle}"
              ToolTip="Удалить выделенное (Del): с компьютера — в корзину, на сервере — безвозвратно, после подтверждения">
              <ui:SymbolIcon FontSize="20" Symbol="Delete24" />
            </Button>
          </StackPanel>
        </Border>

        <Border Grid.Column="3" Style="{StaticResource PathGroupStyle}">
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Button
              Click="OnRefresh"
              Style="{StaticResource GroupIconButtonStyle}"
              ToolTip="Обновить (Ctrl+R)">
              <ui:SymbolIcon FontSize="20" Symbol="ArrowClockwise24" />
            </Button>
            <Button
              x:Name="TreeButton"
              Click="OnToggleTree"
              Style="{StaticResource GroupIconButtonStyle}"
              ToolTip="Дерево папок слева">
              <ui:SymbolIcon FontSize="20" Symbol="TextBulletListTree24" />
            </Button>
            <Button
              x:Name="BookmarkButton"
              Click="OnBookmarks"
              Style="{StaticResource GroupIconButtonStyle}"
              ToolTip="Закладки и последние папки">
              <ui:SymbolIcon FontSize="20" Symbol="Star24" />
            </Button>
          </StackPanel>
        </Border>
      </Grid>

      <!--  копирование в соседнюю панель (только в «Проводнике») и справа маска с поиском папок  -->
      <Grid
        Grid.Row="2"
        Margin="8,4,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  одним полем, как маска и поиск: слева «Копировать», внутри справа его параметры  -->
        <Border
          x:Name="TransferGroup"
          Grid.Column="0"
          Height="{StaticResource IconButtonSize}"
          Background="{DynamicResource ControlFillColorDefaultBrush}"
          BorderBrush="{DynamicResource TextControlElevationBorderBrush}"
          BorderThickness="1"
          CornerRadius="4"
          Visibility="Collapsed">
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <!--  не ui:Button: та после включения не перекрашивала текст, пока не наведёшь мышь  -->
            <Button
              x:Name="TransferButton"
              Width="Auto"
              Height="32"
              Margin="1,0,0,0"
              Click="OnTransfer"
              FontSize="12"
              IsEnabled="False"
              Style="{StaticResource PathIconButtonStyle}">
              <StackPanel Margin="10,0" Orientation="Horizontal">
                <ui:SymbolIcon
                  x:Name="TransferIcon"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  FontSize="16"
                  Symbol="ArrowRight24" />
                <TextBlock VerticalAlignment="Center" Text="Копировать" />
              </StackPanel>
            </Button>
            <Button
              x:Name="OptionsButton"
              Margin="0,0,1,0"
              Click="OnTransferOptions"
              Style="{StaticResource GroupIconButtonStyle}"
              ToolTip="Параметры копирования и исключения">
              <ui:SymbolIcon FontSize="18" Symbol="Settings24" />
            </Button>
          </StackPanel>
        </Border>

        <StackPanel
          Grid.Column="2"
          VerticalAlignment="Center"
          Orientation="Horizontal">
          <Grid Width="150">
            <ui:TextBox
              x:Name="FileMaskBox"
              Height="{StaticResource IconButtonSize}"
              Padding="10,0,30,0"
              VerticalContentAlignment="Center"
              ClearButtonEnabled="False"
              Icon="{ui:SymbolIcon Filter24}"
              PlaceholderText="маска"
              TextChanged="OnFileMaskChanged"
              ToolTip="Маска: показывать в открытой папке только подходящие файлы и папки — *.conf, *.log, nginx (Ctrl+F)" />
            <Button
              x:Name="FileMaskClear"
              Click="OnClearFileMask"
              Style="{StaticResource MaskClearButtonStyle}"
              ToolTip="Сбросить маску" />
          </Grid>

          <Grid Width="150" Margin="4,0,0,0">
            <ui:TextBox
              x:Name="FolderMaskBox"
              Height="{StaticResource IconButtonSize}"
              Padding="10,0,30,0"
              VerticalContentAlignment="Center"
              ClearButtonEnabled="False"
              Icon="{ui:SymbolIcon Search24}"
              KeyDown="OnFolderMaskKeyDown"
              PlaceholderText="найти папку"
              TextChanged="OnFolderMaskChanged"
              ToolTip="Ищет папки по маске вглубь от открытой. Enter по найденной — перейти в неё" />
            <Button
              x:Name="FolderMaskClear"
              Click="OnClearFolderMask"
              Style="{StaticResource MaskClearButtonStyle}"
              ToolTip="Сбросить поиск" />
          </Grid>
        </StackPanel>
      </Grid>

      <!--  дерево и список  -->
      <Grid
        Grid.Row="3"
        Margin="8,4,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="TreeColumn" Width="0" />
          <ColumnDefinition x:Name="TreeSplitColumn" Width="0" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
          x:Name="TreeHost"
          Grid.Column="0"
          Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="4"
          Visibility="Collapsed">
          <TreeView
            x:Name="Tree"
            Padding="2,4"
            Background="Transparent"
            BorderThickness="0"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            SelectedItemChanged="OnTreeSelected">
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <EventSetter Event="Expanded" Handler="OnNodeExpanded" />
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="18" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ToggleButton
                          x:Name="Expander"
                          VerticalAlignment="Center"
                          ClickMode="Press"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Style="{StaticResource TreeExpanderStyle}" />

                        <Border
                          x:Name="Bd"
                          Grid.Column="1"
                          Padding="{TemplateBinding Padding}"
                          Background="{TemplateBinding Background}"
                          CornerRadius="4">
                          <ContentPresenter ContentSource="Header" />
                        </Border>

                        <ItemsPresenter
                          x:Name="ItemsHost"
                          Grid.Row="1"
                          Grid.Column="1" />
                      </Grid>

                      <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                          <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                          <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppRowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppRowSelectedBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate DataType="{x:Type controls:PaneNode}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                  <Image
                    Width="16"
                    Height="16"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Source="{Binding Icon}" />
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{Binding Name}" />
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Border>

        <GridSplitter
          x:Name="TreeSplitter"
          Grid.Column="1"
          Width="4"
          HorizontalAlignment="Stretch"
          Background="Transparent"
          Visibility="Collapsed" />

        <!--
          список: «..» сверху, папки перед файлами, сортировка щелчком по шапке со стрелкой.
          IsSynchronizedWithCurrentItem выключен: иначе новый список (находки поиска) сам отмечает свою «текущую» строку
        -->
        <DataGrid
          x:Name="List"
          Grid.Column="2"
          AllowDrop="True"
          CellStyle="{StaticResource AppDataGridCellStyle}"
          ColumnHeaderStyle="{StaticResource ResizableColumnHeaderStyle}"
          DragLeave="OnListDragLeave"
          DragOver="OnListDragOver"
          Drop="OnListDrop"
          GotKeyboardFocus="OnListFocused"
          IsSynchronizedWithCurrentItem="False"
          PreviewKeyDown="OnListKeyDown"
          LostMouseCapture="OnListLostCapture"
          PreviewMouseLeftButtonDown="OnListMouseDown"
          PreviewMouseLeftButtonUp="OnListMouseUp"
          PreviewMouseMove="OnListMouseMove"
          PreviewMouseRightButtonDown="OnListRightDown"
          PreviewTextInput="OnListTextInput"
          RowStyle="{StaticResource PaneRowStyle}"
          SelectionChanged="OnListSelected"
          Sorting="OnListSorting"
          Style="{StaticResource AppDataGridStyle}"
          VerticalScrollBarVisibility="Auto"
          VirtualizingPanel.IsVirtualizing="True"
          VirtualizingPanel.VirtualizationMode="Recycling">
          <DataGrid.Columns>
            <!--  галочки — то же выделение, что мышью: щелчок по галочке добавляет или снимает строку  -->
            <DataGridTemplateColumn
              x:Name="CheckColumn"
              Width="40"
              CanUserSort="False"
              CellStyle="{StaticResource FirstColumnCellStyle}"
              HeaderStyle="{StaticResource FirstColumnHeaderStyle}">
              <DataGridTemplateColumn.Header>
                <CheckBox
                  x:Name="AllCheck"
                  MinWidth="0"
                  MinHeight="0"
                  Margin="0"
                  Padding="0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Click="OnCheckAll"
                  Focusable="False"
                  IsThreeState="True"
                  ToolTip="Выделить все или снять выделение" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox
                    x:Name="RowCheck"
                    MinWidth="0"
                    MinHeight="0"
                    Margin="0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Focusable="False"
                    IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=OneWay}" />
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsParent}" Value="True">
                      <Setter TargetName="RowCheck" Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn
              x:Name="NameColumn"
              Width="*"
              MinWidth="160"
              Header="Имя"
              SortMemberPath="Name">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid
                      Width="16"
                      Height="16"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center">
                      <Image Source="{Binding Icon}" />
                      <!--  стрелка ярлыка поверх значка, как у ярлыков Windows  -->
                      <Image
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Source="{Binding Overlay}" />
                    </Grid>

                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Text="{Binding Name}"
                      TextTrimming="CharacterEllipsis"
                      Visibility="{Binding ShowsName, Converter={StaticResource BoolToVis}}" />

                    <!--  переименование на месте (F2): Enter — готово, Esc — отмена  -->
                    <!--
                      Своя простая рамка вместо темы: у темы снизу полоса фокуса и высота поля
                      больше строки — она закрывала буквы.
                    -->
                    <TextBox
                      x:Name="RenameBox"
                      Grid.Column="1"
                      MinHeight="0"
                      Margin="-4,0,0,0"
                      Padding="3,1"
                      VerticalAlignment="Center"
                      CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      KeyDown="OnRenameKeyDown"
                      LostKeyboardFocus="OnRenameLostFocus"
                      SelectionBrush="{DynamicResource AccentFillColorDefaultBrush}"
                      Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
                      <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                          <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <ScrollViewer
                              x:Name="PART_ContentHost"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden" />
                          </Border>
                        </ControlTemplate>
                      </TextBox.Template>
                    </TextBox>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn
              x:Name="WhereColumn"
              Binding="{Binding Where}"
              Header="Где"
              SortMemberPath="Where"
              Visibility="Collapsed" />
            <DataGridTextColumn
              Binding="{Binding TypeText}"
              Header="Тип"
              SortMemberPath="Type" />
            <DataGridTextColumn
              Binding="{Binding SizeText}"
              Header="Размер"
              SortMemberPath="Length">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn
              Binding="{Binding ModifiedText}"
              Header="Изменено"
              SortMemberPath="Modified" />
            <DataGridTextColumn
              x:Name="RightsColumn"
              Binding="{Binding Permissions}"
              FontFamily="Consolas"
              Header="Права"
              SortMemberPath="Permissions" />
            <DataGridTextColumn
              x:Name="OwnerColumn"
              Binding="{Binding OwnerText}"
              Header="Владелец"
              SortMemberPath="Owner" />
            <DataGridTextColumn
              x:Name="LinkColumn"
              Binding="{Binding LinkText}"
              Header="Куда ведёт"
              SortMemberPath="LinkTarget" />
          </DataGrid.Columns>
        </DataGrid>

        <!--  рамка выделения мышью, как в проводнике  -->
        <Canvas
          Grid.Column="2"
          ClipToBounds="True"
          IsHitTestVisible="False">
          <Border
            x:Name="Marquee"
            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
            BorderThickness="1"
            Visibility="Collapsed">
            <Rectangle Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.2" />
          </Border>
        </Canvas>

        <!--  пусто, нет связи, не выбран сервер — словами посреди списка, ниже шапки и строки «..»  -->
        <TextBlock
          x:Name="EmptyText"
          Grid.Column="2"
          Margin="16,96,16,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          FontSize="13"
          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
          IsHitTestVisible="False"
          TextAlignment="Center"
          TextWrapping="Wrap"
          Visibility="Collapsed" />
      </Grid>

      <!--  строка состояния: сколько всего, сколько выбрано, свободно на диске  -->
      <TextBlock
        x:Name="StatusText"
        Grid.Row="4"
        Margin="10,4,10,6"
        FontSize="11"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        TextTrimming="CharacterEllipsis" />
    </Grid>
  </Border>
</UserControl>
