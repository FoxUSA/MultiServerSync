<UserControl
  x:Class="MultiServerSync.Views.Controls.LogPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:services="clr-namespace:MultiServerSync.Services"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <UserControl.Resources>
    <!--  значок в заголовке лога — тот же, что над выводом в терминале  -->
    <Style x:Key="OutputIconStyle" TargetType="Button">
      <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
      <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4"
              TextElement.Foreground="{TemplateBinding Foreground}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  стоит рядом с ярлыками «Терминал / Журнал» — отступ слева под них ставит окно (AlignToolbar)  -->
    <Grid x:Name="ToolBar" Grid.Row="0" Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="2*" MaxWidth="304" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!--  без галочки журнал показывает только открытую вкладку; у каждой вкладки галочка своя  -->
      <CheckBox
        x:Name="WholeBox"
        Grid.Column="0"
        Margin="12,0,0,0"
        MinWidth="0"
        VerticalAlignment="Center"
        Click="OnWholeClick"
        Content="Вся история"
        FontSize="11"
        ToolTip="Показать записи всех вкладок и разделов. Без галочки — только открытой вкладки" />

      <!--  записи одного действия: «что удалялось» без копирования и команд вперемешку  -->
      <ComboBox
        x:Name="ActionFilter"
        Grid.Column="1"
        Margin="12,0,0,0"
        VerticalAlignment="Center"
        MinWidth="150"
        Padding="8,2"
        FontSize="11"
        SelectionChanged="OnFilterChanged"
        ToolTip="Показывать записи одного действия">
        <ComboBoxItem Content="Все действия" IsSelected="True" />
        <ComboBoxItem Content="Команда" />
        <ComboBoxItem Content="Копирование" />
        <ComboBoxItem Content="Скачивание" />
        <ComboBoxItem Content="Сравнение" />
        <ComboBoxItem Content="Создание" />
        <ComboBoxItem Content="Добавление" />
        <ComboBoxItem Content="Изменение" />
        <ComboBoxItem Content="Переименование" />
        <ComboBoxItem Content="Перенос" />
        <ComboBoxItem Content="Удаление" />
        <ComboBoxItem Content="Очистка" />
        <ComboBoxItem Content="Отмена" />
        <ComboBoxItem Content="Проверка связи" />
        <ComboBoxItem Content="Обновление" />
        <ComboBoxItem Content="Прочее" />
      </ComboBox>

      <!--  вровень с «Все действия»: своей высоты поле не задаёт  -->
      <ui:TextBox
        x:Name="SearchBox"
        Grid.Column="2"
        Height="{Binding ActualHeight, ElementName=ActionFilter}"
        Margin="4,0,0,0"
        MinHeight="0"
        Padding="8,2"
        VerticalAlignment="Center"
        VerticalContentAlignment="Center"
        FontSize="11"
        Icon="{ui:SymbolIcon Search24}"
        PlaceholderText="Поиск: текст или маска"
        TextChanged="OnSearchChanged"
        ToolTip="Остаются строки, куда входит набранное. * — любые символы, ? — один символ" />

      <StackPanel
        Grid.Column="4"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Orientation="Horizontal">
        <CheckBox
          x:Name="AutoScrollBox"
          Margin="0,0,12,0"
          VerticalAlignment="Center"
          Content="Автопрокрутка"
          FontSize="11"
          IsChecked="True" />
        <ui:Button
          Margin="0,0,4,0"
          Padding="8,2"
          Click="OnCopy"
          Content="Копировать"
          FontSize="11"
          Icon="{ui:SymbolIcon Copy24}" />
        <ui:Button
          Margin="0,0,4,0"
          Padding="8,2"
          Click="OnOpenFolder"
          Content="Папка логов"
          FontSize="11"
          Icon="{ui:SymbolIcon FolderOpen24}" />
        <ui:Button
          Padding="8,2"
          Click="OnClear"
          Content="Очистить"
          FontSize="11"
          Icon="{ui:SymbolIcon Delete24}" />
      </StackPanel>
    </Grid>

    <!--  щелчок по строке открывает справа её полный лог, как вывод в терминале  -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="TableColumn" Width="*" MinWidth="320" />
        <ColumnDefinition x:Name="SplitColumn" Width="0" />
        <ColumnDefinition x:Name="OutputColumn" Width="0" />
      </Grid.ColumnDefinitions>

    <!--  свежая запись всегда сверху; раздел — где сделано, «Действие» — что сделано; сервер и вкладка — в шапке лога справа  -->
    <DataGrid
      x:Name="LogList"
      Grid.Column="0"
      CellStyle="{StaticResource AppDataGridCellStyle}"
      ColumnHeaderHeight="{StaticResource IconButtonSize}"
      ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
      IsSynchronizedWithCurrentItem="False"
      RowHeight="22"
      RowStyle="{StaticResource AppDataGridRowStyle}"
      SelectionChanged="OnEntryPicked"
      SelectionMode="Single"
      Style="{StaticResource AppDataGridStyle}"
      VerticalScrollBarVisibility="Auto"
      VirtualizingPanel.IsVirtualizing="True"
      VirtualizingPanel.VirtualizationMode="Recycling">
      <DataGrid.Columns>
        <DataGridTextColumn
          Binding="{Binding TimeText}"
          CanUserSort="False"
          FontFamily="Consolas"
          Header="Время" />
        <DataGridTextColumn
          Binding="{Binding SectionText}"
          CanUserSort="False"
          Header="Раздел" />
        <DataGridTextColumn
          Binding="{Binding ActionText}"
          CanUserSort="False"
          Header="Действие" />
        <DataGridTextColumn
          Width="*"
          Binding="{Binding Text}"
          CanUserSort="False"
          Header="Что сделано">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{Binding Brush}" />
              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              <Setter Property="ToolTip" Value="{Binding Text}" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>

      <Border
        x:Name="OutputPane"
        Grid.Column="2"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4"
        Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border
            Grid.Row="0"
            Height="{StaticResource IconButtonSize}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="3,3,0,0">
            <Border
              Padding="8,0"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              CornerRadius="3,3,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                  x:Name="OutputTitle"
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  FontSize="11"
                  FontWeight="SemiBold"
                  TextTrimming="CharacterEllipsis" />

                <controls:OutputZoom
                  Grid.Column="1"
                  Margin="0,0,4,0"
                  VerticalAlignment="Center" />

                <Button
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Click="OnCopyOutput"
                  Style="{StaticResource OutputIconStyle}"
                  ToolTip="Скопировать этот лог">
                  <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Copy24" />
                </Button>

                <Button
                  Grid.Column="3"
                  VerticalAlignment="Center"
                  Click="OnCloseOutput"
                  Style="{StaticResource OutputIconStyle}"
                  ToolTip="Закрыть лог">
                  <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Dismiss24" />
                </Button>
              </Grid>
            </Border>
          </Border>

          <RichTextBox
            x:Name="OutputBox"
            Grid.Row="1"
            Padding="6,2"
            Background="Transparent"
            BorderThickness="0"
            FontFamily="Consolas"
            FontSize="{Binding Source={x:Static services:AppState.Current}, Path=OutputFontSize}"
            HorizontalScrollBarVisibility="Disabled"
            IsReadOnly="True"
            VerticalScrollBarVisibility="Auto">
            <!--  как в терминале: тема не подменяет фон поля под мышью и в фокусе  -->
            <RichTextBox.Resources>
              <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
            </RichTextBox.Resources>
          </RichTextBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
