<UserControl
  x:Class="MultiServerSync.Views.Controls.LogPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  стоит рядом с ярлыками «Терминал / Журнал» — отступ слева под них ставит окно (AlignToolbar)  -->
    <Grid x:Name="ToolBar" Grid.Row="0" Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!--  записи одного раздела: «что было в проводнике» без копирования и команд вперемешку  -->
      <ComboBox
        x:Name="SectionFilter"
        Grid.Column="0"
        Margin="12,0,0,0"
        VerticalAlignment="Center"
        MinWidth="150"
        Padding="8,2"
        FontSize="11"
        SelectionChanged="OnFilterChanged"
        ToolTip="Показывать записи одного раздела">
        <ComboBoxItem Content="Все разделы" IsSelected="True" />
        <ComboBoxItem Content="Проводник" />
        <ComboBoxItem Content="Копирование" />
        <ComboBoxItem Content="Скачивание" />
        <ComboBoxItem Content="Команда" />
        <ComboBoxItem Content="Серверы" />
        <ComboBoxItem Content="Настройки" />
        <ComboBoxItem Content="Программа" />
      </ComboBox>

      <StackPanel
        Grid.Column="2"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Orientation="Horizontal">
        <CheckBox
          x:Name="AutoScrollBox"
          Margin="0,0,12,0"
          VerticalAlignment="Center"
          Content="Автопрокрутка"
          FontSize="11"
          IsChecked="True" />
        <ui:Button
          Margin="0,0,4,0"
          Padding="8,2"
          Click="OnCopy"
          Content="Копировать"
          FontSize="11"
          Icon="{ui:SymbolIcon Copy24}" />
        <ui:Button
          Margin="0,0,4,0"
          Padding="8,2"
          Click="OnOpenFolder"
          Content="Папка логов"
          FontSize="11"
          Icon="{ui:SymbolIcon FolderOpen24}" />
        <ui:Button
          Padding="8,2"
          Click="OnClear"
          Content="Очистить"
          FontSize="11"
          Icon="{ui:SymbolIcon Delete24}" />
      </StackPanel>
    </Grid>

    <!--  свежая запись всегда сверху; раздел — где сделано, «Где» — сервер, вкладка или компьютер  -->
    <DataGrid
      x:Name="LogList"
      Grid.Row="1"
      CellStyle="{StaticResource AppDataGridCellStyle}"
      ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
      RowHeight="22"
      RowStyle="{StaticResource AppDataGridRowStyle}"
      Style="{StaticResource AppDataGridStyle}"
      VerticalScrollBarVisibility="Auto"
      VirtualizingPanel.IsVirtualizing="True"
      VirtualizingPanel.VirtualizationMode="Recycling">
      <DataGrid.Columns>
        <DataGridTextColumn
          Binding="{Binding TimeText}"
          CanUserSort="False"
          FontFamily="Consolas"
          Header="Время" />
        <DataGridTextColumn
          Binding="{Binding SectionText}"
          CanUserSort="False"
          Header="Раздел" />
        <DataGridTextColumn
          MaxWidth="240"
          Binding="{Binding ScopeText}"
          CanUserSort="False"
          Header="Где">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              <Setter Property="ToolTip" Value="{Binding ScopeText}" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn
          Width="*"
          Binding="{Binding Text}"
          CanUserSort="False"
          Header="Что сделано">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{Binding Brush}" />
              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              <Setter Property="ToolTip" Value="{Binding Text}" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
