<UserControl
  x:Class="MultiServerSync.Views.Controls.MonitorView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  TextOptions.TextFormattingMode="Display"
  UseLayoutRounding="True">

  <UserControl.Resources>
    <!--  период: внутри общей рамки, у выбранного — заливка акцентом, как в макете; у «Сейчас» огонёк, у выбранного он мигает общим тактом  -->
    <Style x:Key="MonitorRangeStyle" TargetType="RadioButton">
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border
              x:Name="Bd"
              Padding="{TemplateBinding Padding}"
              Background="Transparent"
              CornerRadius="5">
              <ContentPresenter VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  «Включить сбор» на оранжевой плашке — оранжевой кнопкой с тёмной подписью, как в макете  -->
    <Style x:Key="MonitorInstallStyle" TargetType="Button">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource Pick.OnSolid}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Padding="{TemplateBinding Padding}"
              Background="{DynamicResource Pick.Solid}"
              CornerRadius="4">
              <ContentPresenter VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pick.SolidHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pick.SolidPressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="Root" Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  периоды; справа — когда обновлено, как часто, сколько без перезагрузки (что не влезло — уходит целиком) и вынос  -->
    <Grid x:Name="Tools" Grid.Row="0" Height="28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!--  периоды — одной группой в рамке, выбранный залит акцентом (как в макете «Здоровье сервера»)  -->
      <Border
        Grid.Column="0"
        Padding="2"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="7">
        <StackPanel x:Name="Ranges" Orientation="Horizontal" />
      </Border>

      <controls:FitPanel
        x:Name="Info"
        Grid.Column="1"
        Margin="4,0,0,0"
        VerticalAlignment="Center"
        Align="Right"
        Gap="6"
        Separator="·"
        SeparatorBrush="{DynamicResource TextFillColorTertiaryBrush}"
        TextElement.FontSize="12" />

      <Button
        x:Name="DetachButton"
        Grid.Column="2"
        Width="28"
        Height="28"
        Margin="4,0,0,0"
        Click="OnDetach"
        Cursor="Hand"
        Focusable="False"
        ToolTip="Вынести этот сервер в отдельное окно">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4">
              <ui:SymbolIcon
                x:Name="Glyph"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Symbol="Open24" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </Grid>

    <!--  сбор истории не включён, а выбран период истории: плашка с кнопкой; пояснение уходит целиком, если не влезло  -->
    <Border
      x:Name="Notice"
      Grid.Row="1"
      Height="30"
      Margin="0,4,0,0"
      Padding="10,0,3,0"
      Background="{DynamicResource Pick.Fill}"
      BorderBrush="{DynamicResource Pick.Stroke}"
      BorderThickness="1"
      CornerRadius="4"
      Visibility="Collapsed">
      <DockPanel>
        <ui:SymbolIcon
          x:Name="NoticeIcon"
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          DockPanel.Dock="Left"
          FontSize="16"
          Foreground="{DynamicResource Pick.Text}"
          Symbol="Warning24" />
        <Button
          x:Name="InstallButton"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Click="OnInstall"
          Content="Включить сбор"
          DockPanel.Dock="Right"
          Style="{StaticResource MonitorInstallStyle}"
          ToolTip="Поставить на сервер сборщик истории — сначала спросит" />
        <controls:FitPanel
          x:Name="NoticeText"
          VerticalAlignment="Center"
          Gap="6"
          Separator="·"
          SeparatorBrush="{DynamicResource TextFillColorTertiaryBrush}"
          TextElement.FontSize="12" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,4,0,0">
      <controls:MonitorGrid x:Name="Cards" />
      <TextBlock
        x:Name="Hint"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="13"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="Выберите сервер слева"
        Visibility="Collapsed" />
    </Grid>
  </Grid>
</UserControl>
