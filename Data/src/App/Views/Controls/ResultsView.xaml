<UserControl
  x:Class="MultiServerSync.Views.Controls.ResultsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:services="clr-namespace:MultiServerSync.Services"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  значок в заголовке вывода — того же размера, что все кнопки-значки программы  -->
    <Style x:Key="OutputIconStyle" TargetType="Button">
      <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
      <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4"
              TextElement.Foreground="{TemplateBinding Foreground}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  у обычной ячейки padding 8 по бокам — иконке статуса не остаётся места  -->
    <Style
      x:Key="IconCellStyle"
      BasedOn="{StaticResource FirstColumnCellStyle}"
      TargetType="DataGridCell">
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  одна строка на всё: прогресс слева, действия справа. Стоит рядом с ярлыками
          «Терминал / Журнал» — отступ слева под них ставит окно (AlignToolbar)  -->
    <Grid x:Name="ToolBar" Grid.Row="0" Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <!--  до правой границы таблицы слева: ширину ставит код, границу двигает разделитель  -->
        <ColumnDefinition x:Name="LeftToolsColumn" Width="Auto" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" LastChildFill="True">
        <!--  срок жизни вывода и «Сохранять лог» — у правой границы таблицы, над ней  -->
        <StackPanel
          x:Name="LeftTools"
          VerticalAlignment="Center"
          DockPanel.Dock="Right"
          Orientation="Horizontal">
          <controls:OutputLife />
          <CheckBox
            MinWidth="0"
            MinHeight="0"
            Margin="10,0,6,0"
            VerticalAlignment="Center"
            Content="Сохранять лог"
            FontSize="11"
            IsChecked="{Binding KeepLog, Mode=TwoWay}"
            ToolTip="Своя у каждой вкладки. Отмечено — терминал вкладки хранит все запуски, пока галочку не снять. Снято — запуск позже срока «Хранить лог» после окончания прошлого начинает терминал заново." />
        </StackPanel>

      <Grid
        Margin="12,0,12,0"
        VerticalAlignment="Center"
        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="320" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ProgressBar
          Grid.Column="0"
          Height="5"
          VerticalAlignment="Center"
          Maximum="100"
          Value="{Binding ProgressPercent, Mode=OneWay}" />
        <TextBlock
          Grid.Column="1"
          Margin="4,0"
          VerticalAlignment="Center"
          FontSize="11"
          Text="{Binding ProgressText}" />
        <controls:StopButton Grid.Column="2" />
      </Grid>
      </DockPanel>

      <StackPanel
        Grid.Column="2"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Orientation="Horizontal">
        <ui:Button
          Margin="0,0,4,0"
          Padding="9,2"
          Click="OnCopyAll"
          Content="Все логи"
          FontSize="11"
          ToolTip="Вывод со всех серверов одним текстом — в буфер обмена">
          <ui:Button.Icon>
            <ui:SymbolIcon FontSize="17" Symbol="Copy24" />
          </ui:Button.Icon>
        </ui:Button>
        <CheckBox
          MinWidth="0"
          MinHeight="0"
          Margin="0,0,4,0"
          VerticalAlignment="Center"
          Content="авто"
          FontSize="11"
          IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=AutoCopyAll, Mode=TwoWay}"
          ToolTip="Операция закончилась на всех серверах — вывод всех серверов сам копируется в буфер обмена. У команд и у копирования галочки свои. Буфер один, поэтому соседняя галочка при этом снимается" />
        <ui:Button
          Margin="0,0,4,0"
          Padding="9,2"
          Click="OnCopyOne"
          Content="Текущий лог"
          FontSize="11"
          ToolTip="Вывод только того сервера, что выбран в таблице слева">
          <ui:Button.Icon>
            <ui:SymbolIcon FontSize="17" Symbol="Copy24" />
          </ui:Button.Icon>
        </ui:Button>
        <CheckBox
          MinWidth="0"
          MinHeight="0"
          Margin="0,0,4,0"
          VerticalAlignment="Center"
          Content="авто"
          FontSize="11"
          IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=AutoCopyCurrent, Mode=TwoWay}"
          ToolTip="Операция закончилась — вывод сервера, выбранного в таблице слева, сам копируется в буфер обмена. У команд и у копирования галочки свои. Буфер один, поэтому соседняя галочка при этом снимается" />
        <CheckBox
          MinWidth="0"
          MinHeight="0"
          Margin="0,0,4,0"
          VerticalAlignment="Center"
          Content="+ команды"
          FontSize="11"
          IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=CopyWithChain, Mode=TwoWay}"
          ToolTip="Копировать вместе с выводом личных команд вкладки: в буфере один отчёт — сначала копирование, потом команды. Автокопия тогда ждёт, пока команды закончатся"
          Visibility="{Binding Source={x:Static services:AppState.Current}, Path=ChainCopyVisibility}" />
        <ui:Button
          Padding="9,2"
          Click="OnRetry"
          Content="Повторить упавшие"
          FontSize="11"
          Icon="{ui:SymbolIcon ArrowClockwise24}"
          Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
    </Grid>

    <!--  поровну: слева таблица серверов, справа вывод; границу двигает разделитель  -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" MinWidth="220" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="1*" MinWidth="260" />
      </Grid.ColumnDefinitions>

      <Border
        x:Name="TablePane"
        Grid.Column="0"
        SizeChanged="OnTablePaneSized"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <!--  строки таблицы тем же шрифтом, что вывод справа; заголовки — как заголовок над выводом.
              Фон и рамка — у Border вокруг, чтобы совпадать с полем вывода справа  -->
        <DataGrid
          x:Name="ResultsGrid"
          Background="Transparent"
          CanUserSortColumns="False"
          BorderThickness="0"
          ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
          ColumnHeaderHeight="{StaticResource IconButtonSize}"
          RowHeight="24"
          SelectionChanged="OnResultPicked"
          RowStyle="{StaticResource AppDataGridRowStyle}"
          SelectionMode="Single"
          Style="{StaticResource AppDataGridStyle}"
          VerticalScrollBarVisibility="Auto">
          <DataGrid.CellStyle>
            <Style BasedOn="{StaticResource AppDataGridCellStyle}" TargetType="DataGridCell">
              <Setter Property="FontFamily" Value="Consolas" />
            </Style>
          </DataGrid.CellStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn
              Width="30"
              CellStyle="{StaticResource IconCellStyle}"
              HeaderStyle="{StaticResource FirstColumnHeaderStyle}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{Binding StatusBrush}"
                    Symbol="{Binding StatusSymbol}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!--  сервер по содержимому; «Прошло» и «Время» постоянной ширины, чтобы чч:мм:сс
                  влезало всегда и столбцы не прыгали; остаток ширины забирает статус  -->
            <DataGridTextColumn
              x:Name="ServerColumn"
              Width="Auto"
              MaxWidth="260"
              Binding="{Binding ShortTitle}"
              Header="Сервер">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding Title}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!--  сколько времени назад сервер закончил: видно, свежий ли результат  -->
            <DataGridTextColumn
              Width="74"
              Binding="{Binding AgoText}"
              Header="Прошло">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="ToolTip" Value="Сколько времени назад сервер закончил, чч:мм:сс" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn
              Width="74"
              Binding="{Binding DurationText}"
              Header="Время">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="ToolTip" Value="Сколько шла работа на сервере" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn
              Width="*"
              MinWidth="90"
              Binding="{Binding ShortStatus}"
              Header="Статус">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{Binding StatusBrush}" />
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding StatusText}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <GridSplitter
        Grid.Column="1"
        Width="4"
        HorizontalAlignment="Stretch"
        Background="Transparent" />

      <Border
        Grid.Column="2"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!--  Шапка вывода вровень с шапкой таблицы слева: та же высота (ColumnHeaderHeight
                у ResultsGrid), тот же цвет на том же тёмном фоне. Верхние углы скруглены
                под рамку вокруг  -->
          <Border
            Grid.Row="0"
            Height="{StaticResource IconButtonSize}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="3,3,0,0">
            <!--  второй слой той же заливки: шапка таблицы слева лежит поверх своего «заполнителя»
                  такой же заливки и выходит светлее одного слоя — так цвет совпадает.
                  Копирование этого вывода переехало в строку кнопок над таблицей  -->
            <Border
              Padding="8,0"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              CornerRadius="3,3,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="{Binding SelectedItem.FullTitle, ElementName=ResultsGrid, FallbackValue='Вывод — выберите сервер слева', TargetNullValue='Вывод — выберите сервер слева'}"
                    TextTrimming="CharacterEllipsis" />

                  <!--  сколько уже идёт команда, а по окончании — за сколько выполнена  -->
                  <TextBlock
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding SelectedItem.ElapsedText, ElementName=ResultsGrid}"
                    ToolTip="Сколько выполняется команда на выбранном сервере" />
                </Grid>

                <!--  «Сохранять лог» переехала в строку «Терминал / Журнал», к правой границе таблицы  -->
                <controls:OutputZoom
                  Grid.Column="2"
                  Margin="0,0,4,0"
                  VerticalAlignment="Center" />

                <Button
                  Grid.Column="3"
                  VerticalAlignment="Center"
                  Click="OnClearOutput"
                  Style="{StaticResource OutputIconStyle}"
                  ToolTip="Очистить вывод выбранного сервера">
                  <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Delete24" />
                </Button>

                <Button
                  x:Name="DetachButton"
                  Grid.Column="4"
                  VerticalAlignment="Center"
                  Click="OnDetach"
                  Style="{StaticResource OutputIconStyle}"
                  ToolTip="Открыть вывод в отдельном окне">
                  <ui:SymbolIcon x:Name="DetachIcon" FontSize="{StaticResource IconGlyphSize}" Symbol="WindowNew24" />
                </Button>
              </Grid>
            </Border>
          </Border>

          <Grid Grid.Row="1">
            <RichTextBox
              x:Name="OutputBox"
              Padding="6,2"
              Background="Transparent"
              BorderThickness="0"
              FontFamily="Consolas"
              FontSize="{Binding Source={x:Static services:AppState.Current}, Path=OutputFontSize}"
              HorizontalScrollBarVisibility="Disabled"
              IsReadOnly="True"
              controls:OutputFeed.Result="{Binding SelectedItem, ElementName=ResultsGrid, Mode=OneWay}"
              VerticalScrollBarVisibility="Auto">
              <!--
                Тема подменяет фон поля под мышью и в фокусе — на выводе это выглядит как мигание.
                Ключи состояний переопределены у самого поля: соседних элементов это не касается.
              -->
              <RichTextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
              </RichTextBox.Resources>
            </RichTextBox>

            <!--  панель остаётся на месте, но пока открыто отдельное окно — вывод в нём  -->
            <TextBlock
              x:Name="DetachedHint"
              Margin="10"
              VerticalAlignment="Top"
              FontSize="12"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="Вывод открыт в отдельном окне. Закройте его — и вывод вернётся сюда."
              TextWrapping="Wrap"
              Visibility="Collapsed" />
          </Grid>

          <!--  строка ответа команде выбранного сервера  -->
          <controls:AnswerBar
            x:Name="Answer"
            Grid.Row="2"
            DataContext="{Binding SelectedItem, ElementName=ResultsGrid}" />

          <!--  сколько передано у выбранного сервера — только пока идёт копирование или скачивание  -->
          <controls:TransferStrip
            Grid.Row="3"
            Margin="4"
            DataContext="{Binding SelectedItem, ElementName=ResultsGrid}"
            Visibility="{Binding HasTransfer, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
