<UserControl
  x:Class="MultiServerSync.Views.Controls.ResultsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:services="clr-namespace:MultiServerSync.Services"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  значок в заголовке вывода — того же размера, что все кнопки-значки программы  -->
    <Style x:Key="OutputIconStyle" TargetType="Button">
      <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
      <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4"
              TextElement.Foreground="{TemplateBinding Foreground}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  стоп в строке: как кнопки на ярлыках — под мышью залитый красный фон и белый значок  -->
    <Style x:Key="RowStopStyle" TargetType="Button">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="Transparent"
              CornerRadius="4">
              <ui:SymbolIcon
                x:Name="Glyph"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{TemplateBinding Foreground}"
                Symbol="Stop24" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  у обычной ячейки padding 8 по бокам — иконке статуса не остаётся места  -->
    <Style
      x:Key="IconCellStyle"
      BasedOn="{StaticResource FirstColumnCellStyle}"
      TargetType="DataGridCell">
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  одна строка на всё: прогресс слева, действия справа. Стоит рядом с ярлыками
          «Терминал / Журнал» — отступ слева под них ставит окно (AlignToolbar)  -->
    <Grid x:Name="ToolBar" Grid.Row="0" Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <!--  до правой границы таблицы слева: ширину ставит код, границу двигает разделитель  -->
        <ColumnDefinition x:Name="LeftToolsColumn" Width="Auto" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" LastChildFill="True">
        <!--  срок жизни вывода и «Не очищать» (строки запусков в таблице) — у правой границы таблицы, над ней  -->
        <StackPanel
          x:Name="LeftTools"
          VerticalAlignment="Center"
          DockPanel.Dock="Right"
          Orientation="Horizontal">
          <controls:OutputLife />
          <CheckBox
            MinWidth="0"
            MinHeight="0"
            Margin="0,0,4,0"
            VerticalAlignment="Center"
            Content="Не очищать"
            FontSize="11"
            IsChecked="{Binding KeepLog, Mode=TwoWay}"
            ToolTip="Хранить все запуски. Снято — запуск после срока начинает журнал заново" />
        </StackPanel>

      <Grid
        x:Name="RunTools"
        Margin="12,0,12,0"
        VerticalAlignment="Center"
        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="320" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ProgressBar
          Grid.Column="0"
          Height="5"
          VerticalAlignment="Center"
          Maximum="100"
          Value="{Binding ProgressPercent, Mode=OneWay}" />
        <TextBlock
          x:Name="RunText"
          Grid.Column="1"
          Margin="4,0"
          VerticalAlignment="Center"
          FontSize="11"
          Text="{Binding ProgressText}" />
        <controls:StopButton Grid.Column="2" />
      </Grid>
      </DockPanel>

      <!--  «Проводник»: окно вывода переворачивается окном команды — в домашней папке или в папке правой панели.
            Значки — у левого края окна вывода  -->
      <StackPanel
        Grid.Column="2"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Visibility="{Binding Source={x:Static services:AppState.Current}, Path=CommandFlipVisibility}">
        <ui:Button
          x:Name="FlipButton"
          Padding="9,2"
          VerticalAlignment="Center"
          Click="OnFlip">
          <!--  включено — белый значок на тускло-зелёной плашке; плашка есть всегда, кнопка не меняет размер  -->
          <StackPanel Orientation="Horizontal">
            <Border
              x:Name="FlipBadge"
              Padding="2"
              VerticalAlignment="Center"
              Background="Transparent"
              CornerRadius="3">
              <ui:SymbolIcon
                x:Name="FlipGlyph"
                FontSize="15"
                Symbol="WindowConsole20" />
            </Border>
            <TextBlock
              x:Name="FlipText"
              Margin="6,0,0,0"
              VerticalAlignment="Center"
              FontSize="11"
              Text="Открыть терминал" />
          </StackPanel>
        </ui:Button>
        <ui:Button
          x:Name="FolderFlipButton"
          Margin="4,0,0,0"
          Padding="9,2"
          VerticalAlignment="Center"
          Click="OnFlip">
          <StackPanel Orientation="Horizontal">
            <Border
              x:Name="FolderFlipBadge"
              Padding="2"
              VerticalAlignment="Center"
              Background="Transparent"
              CornerRadius="3">
              <ui:SymbolIcon
                x:Name="FolderFlipGlyph"
                FontSize="15"
                Symbol="FolderOpen20" />
            </Border>
            <TextBlock
              Margin="6,0,0,0"
              VerticalAlignment="Center"
              FontSize="11"
              Text="В папке" />
          </StackPanel>
        </ui:Button>
      </StackPanel>

      <StackPanel
        Grid.Column="2"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Orientation="Horizontal">
        <ui:Button
          Margin="0,0,4,0"
          Padding="9,2"
          Click="OnCopyAll"
          Content="Все логи"
          FontSize="11"
          ToolTip="Вывод со всех серверов одним текстом — в буфер обмена">
          <ui:Button.Icon>
            <ui:SymbolIcon FontSize="17" Symbol="Copy24" />
          </ui:Button.Icon>
        </ui:Button>
        <ui:Button
          Margin="0,0,4,0"
          Padding="9,2"
          Click="OnCopyOne"
          Content="Текущий лог"
          FontSize="11"
          ToolTip="Вывод только того сервера, что выбран в таблице слева">
          <ui:Button.Icon>
            <ui:SymbolIcon FontSize="17" Symbol="Copy24" />
          </ui:Button.Icon>
        </ui:Button>
        <!--  без левого отступа темы (11): зазор до «Текущий лог» такой же, как между кнопками.
              Без правого: кнопки и галочки — один блок, зазор между галочками 8. «Auto Copy & Paste» —
              сразу за «Auto Copy»: без неё не работает. «Буфер .txt» от неё не зависит — ей пользуются и кнопки  -->
        <CheckBox
          MinWidth="0"
          MinHeight="0"
          Margin="0,0,8,0"
          Padding="0,5,0,6"
          VerticalAlignment="Center"
          Content="Auto Copy"
          FontSize="11"
          IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=AutoCopyOnly, Mode=TwoWay}"
          ToolTip="По окончании вывод сам копируется в буфер. Вместе с «Auto Copy &amp; Paste» не ставится" />
        <CheckBox
          MinWidth="0"
          MinHeight="0"
          Margin="0,0,8,0"
          Padding="0,5,0,6"
          VerticalAlignment="Center"
          x:Name="CopyPassBox"
          Content="Auto Copy &amp; Paste"
          Loaded="OnCopyPassLoaded"
          FontSize="11"
          IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=CopyPass, Mode=TwoWay}"
          MouseRightButtonUp="OnCopyPassRightClick"
          Visibility="{Binding Source={x:Static services:AppState.Current}, Path=CopyPassVisibility}"
          ToolTip="Вывод сам копируется и вставляется в поле ввода другой программы с Enter. Терминалы и пароли пропускает. ПКМ — на один раз (×1)" />
        <CheckBox
          MinWidth="0"
          MinHeight="0"
          Padding="0,5,0,6"
          VerticalAlignment="Center"
          Content="Буфер .txt"
          FontSize="11"
          IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=LogAsFile, Mode=TwoWay}"
          ToolTip="Лог длиннее 1000 строк — в буфер файлом, и кнопками, и автокопией. Без галочки середина обрезается" />
      </StackPanel>
    </Grid>

    <!--  поровну: слева таблица серверов, справа вывод. Граница мышью не двигается (сказано 21.11): перетянутая,
          она ужимала таблицу ниже её минимума и резала строки; между ними — зазор 4  -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" MinWidth="320" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="1*" MinWidth="260" />
      </Grid.ColumnDefinitions>

      <Border
        x:Name="TablePane"
        Grid.Column="0"
        SizeChanged="OnTablePaneSized"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <Grid x:Name="TableHost">
        <!--  строки таблицы тем же шрифтом, что вывод справа; заголовки — как заголовок над выводом.
              Фон и рамка — у Border вокруг, чтобы совпадать с полем вывода справа  -->
        <DataGrid
          x:Name="ResultsGrid"
          Background="Transparent"
          CanUserSortColumns="False"
          BorderThickness="0"
          ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
          ColumnHeaderHeight="{StaticResource IconButtonSize}"
          PreviewKeyDown="OnGridTouched"
          PreviewMouseDown="OnGridTouched"
          RowHeight="24"
          SelectionChanged="OnResultPicked"
          SelectionMode="Single"
          Style="{StaticResource AppDataGridStyle}"
          VerticalScrollBarVisibility="Auto">
          <!--  свежий запуск сверху; между запусками — черта, как между серверами в панели слева  -->
          <DataGrid.RowStyle>
            <Style BasedOn="{StaticResource AppDataGridRowStyle}" TargetType="DataGridRow">
              <Style.Triggers>
                <DataTrigger Binding="{Binding StartsRun}" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
                  <Setter Property="BorderThickness" Value="0,1,0,0" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.CellStyle>
            <Style BasedOn="{StaticResource AppDataGridCellStyle}" TargetType="DataGridCell">
              <Setter Property="FontFamily" Value="Consolas" />
            </Style>
          </DataGrid.CellStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn
              Width="30"
              MinWidth="30"
              CellStyle="{StaticResource IconCellStyle}"
              HeaderStyle="{StaticResource FirstColumnHeaderStyle}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{Binding StatusBrush}"
                    Symbol="{Binding StatusSymbol}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!--  сервер по содержимому; «Прошло» и «Время» постоянной ширины, чтобы чч:мм:сс
                  влезало всегда и столбцы не прыгали; остаток ширины забирает статус.
                  MinWidth как у Width: без него таблица ужимает такой столбец до 20 и не отдаёт обратно  -->
            <DataGridTextColumn
              x:Name="ServerColumn"
              Width="Auto"
              MaxWidth="260"
              Binding="{Binding ShortTitle}"
              Header="Сервер">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding Title}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!--  сколько времени назад сервер закончил: видно, свежий ли результат  -->
            <DataGridTextColumn
              Width="74"
              MinWidth="74"
              Binding="{Binding AgoText}"
              Header="Прошло">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="ToolTip" Value="Сколько времени назад сервер закончил, чч:мм:сс" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn
              Width="74"
              MinWidth="74"
              Binding="{Binding DurationText}"
              Header="Время">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="ToolTip" Value="Сколько шла работа на сервере" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn
              Width="*"
              MinWidth="90"
              Binding="{Binding ShortStatus}"
              Header="Статус">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{Binding StatusBrush}" />
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding StatusText}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!--  стоп одной строки: только у ждущих и идущих; общий «Остановить» — всё сразу  -->
            <DataGridTemplateColumn Width="30" MinWidth="30" CellStyle="{StaticResource IconCellStyle}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button
                    Click="OnRowStop"
                    Style="{StaticResource RowStopStyle}"
                    ToolTip="Остановить эту строку: идущая — Ctrl+C, ждущая — не начнётся"
                    Visibility="{Binding CanStop, Converter={StaticResource BoolToVis}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!--  таблица может жить в отдельном окне: на её месте подсказка, кнопки шапки остаются  -->
        <TextBlock
          x:Name="TableDetachedHint"
          Margin="10,46,10,10"
          VerticalAlignment="Top"
          FontSize="12"
          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
          Text="Список запусков открыт в отдельном окне. Закройте его — и список вернётся сюда."
          TextWrapping="Wrap"
          Visibility="Collapsed" />

        <!--  кнопки в шапке таблицы, как над выводом справа: поверх правого края заголовков  -->
        <StackPanel
          Height="{StaticResource IconButtonSize}"
          Margin="0,0,8,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Orientation="Horizontal">
          <Button
            VerticalAlignment="Center"
            Click="OnClearRuns"
            Style="{StaticResource OutputIconStyle}"
            ToolTip="Очистить список запусков. Идущие и ждущие очереди останутся">
            <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Delete24" />
          </Button>
          <Button
            x:Name="TableDetachButton"
            VerticalAlignment="Center"
            Click="OnDetachTable"
            Style="{StaticResource OutputIconStyle}"
            ToolTip="Открыть список запусков в отдельном окне">
            <ui:SymbolIcon x:Name="TableDetachIcon" FontSize="{StaticResource IconGlyphSize}" Symbol="WindowNew24" />
          </Button>
        </StackPanel>
        </Grid>
      </Border>

      <!--  две стороны одного окна: вывод и окно команды. Переворот — сжатие к середине и разворот
            другой стороной, как страница. Высота у сторон одна — их ячейка  -->
      <Grid
        x:Name="FlipHost"
        Grid.Column="2"
        RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
          <ScaleTransform x:Name="FlipScale" />
        </Grid.RenderTransform>

      <controls:MiniTerminal
        x:Name="CommandFace"
        DataContext="{Binding Source={x:Static services:AppState.Current}, Path=TerminalOwner}"
        ShowTargets="False"
        Visibility="Collapsed" />

      <Border
        x:Name="OutputFace"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!--  Шапка вывода вровень с шапкой таблицы слева: та же высота (ColumnHeaderHeight
                у ResultsGrid), тот же цвет на том же тёмном фоне. Верхние углы скруглены
                под рамку вокруг  -->
          <Border
            Grid.Row="0"
            Height="{StaticResource IconButtonSize}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="3,3,0,0">
            <!--  второй слой той же заливки: шапка таблицы слева лежит поверх своего «заполнителя»
                  такой же заливки и выходит светлее одного слоя — так цвет совпадает.
                  Копирование этого вывода переехало в строку кнопок над таблицей  -->
            <Border
              Padding="8,0"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              CornerRadius="3,3,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!--  «Сохранять вывод» справа от таймера — как в отдельном окне вывода  -->
                  <CheckBox
                    Grid.Column="2"
                    MinWidth="0"
                    MinHeight="0"
                    Margin="10,0,4,0"
                    VerticalAlignment="Center"
                    Content="Сохранять вывод"
                    FontSize="11"
                    IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=OutputWhole, Mode=TwoWay}"
                    ToolTip="Весь вывод сервера по всем строкам журнала. Снято — только выбранная строка" />

                  <TextBlock
                    x:Name="OutputTitle"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="{Binding SelectedItem.FullTitle, ElementName=ResultsGrid, FallbackValue='Вывод — выберите сервер слева', TargetNullValue='Вывод — выберите сервер слева'}"
                    TextTrimming="CharacterEllipsis" />

                  <!--  сколько уже идёт команда, а по окончании — за сколько выполнена  -->
                  <TextBlock
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding SelectedItem.ElapsedText, ElementName=ResultsGrid}"
                    ToolTip="Сколько выполняется команда на выбранном сервере" />
                </Grid>

                <!--  «Сохранять лог» переехала в строку «Терминал / Журнал», к правой границе таблицы  -->
                <controls:OutputZoom
                  Grid.Column="2"
                  Margin="0,0,4,0"
                  VerticalAlignment="Center" />

                <Button
                  Grid.Column="3"
                  VerticalAlignment="Center"
                  Click="OnClearOutput"
                  Style="{StaticResource OutputIconStyle}"
                  ToolTip="Очистить вывод выбранного сервера">
                  <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Delete24" />
                </Button>

                <Button
                  x:Name="DetachButton"
                  Grid.Column="4"
                  VerticalAlignment="Center"
                  Click="OnDetach"
                  Style="{StaticResource OutputIconStyle}"
                  ToolTip="Открыть вывод в отдельном окне">
                  <ui:SymbolIcon x:Name="DetachIcon" FontSize="{StaticResource IconGlyphSize}" Symbol="WindowNew24" />
                </Button>
              </Grid>
            </Border>
          </Border>

          <Grid Grid.Row="1">
            <RichTextBox
              x:Name="OutputBox"
              Padding="6,2"
              Background="Transparent"
              BorderThickness="0"
              FontFamily="Consolas"
              FontSize="{Binding Source={x:Static services:AppState.Current}, Path=OutputFontSize}"
              HorizontalScrollBarVisibility="Disabled"
              IsReadOnly="True"
              controls:OutputFeed.Result="{Binding SelectedItem, ElementName=ResultsGrid, Mode=OneWay}"
              VerticalScrollBarVisibility="Auto">
              <!--
                Тема подменяет фон поля под мышью и в фокусе — на выводе это выглядит как мигание.
                Ключи состояний переопределены у самого поля: соседних элементов это не касается.
              -->
              <RichTextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
              </RichTextBox.Resources>
            </RichTextBox>

            <controls:CommandCountdown
              x:Name="OutputCountdown"
              DataContext="{Binding SelectedItem, ElementName=ResultsGrid}" />

            <!--  панель остаётся на месте, но пока открыто отдельное окно — вывод в нём  -->
            <TextBlock
              x:Name="DetachedHint"
              Margin="10"
              VerticalAlignment="Top"
              FontSize="12"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="Вывод открыт в отдельном окне. Закройте его — и вывод вернётся сюда."
              TextWrapping="Wrap"
              Visibility="Collapsed" />
          </Grid>

          <!--  строка ответа команде выбранного сервера  -->
          <controls:AnswerBar
            x:Name="Answer"
            Grid.Row="2"
            DataContext="{Binding SelectedItem, ElementName=ResultsGrid}" />

          <!--  сколько передано у выбранного сервера — только пока идёт копирование или скачивание  -->
          <controls:TransferStrip
            Grid.Row="3"
            Margin="4"
            DataContext="{Binding SelectedItem, ElementName=ResultsGrid}"
            Visibility="{Binding HasTransfer, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
        </Grid>
      </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
