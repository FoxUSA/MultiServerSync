<UserControl
  x:Class="MultiServerSync.Views.Controls.ResultsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:services="clr-namespace:MultiServerSync.Services"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  значок в заголовке вывода: полоска заголовка низкая, кнопке нельзя быть выше неё  -->
    <Style x:Key="OutputIconStyle" TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4"
              TextElement.Foreground="{TemplateBinding Foreground}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  у обычной ячейки padding 8 по бокам — иконке статуса не остаётся места  -->
    <Style
      x:Key="IconCellStyle"
      BasedOn="{StaticResource FirstColumnCellStyle}"
      TargetType="DataGridCell">
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  одна строка на всё: прогресс слева, действия справа  -->
    <Grid Grid.Row="0" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="320" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ProgressBar
          Grid.Column="0"
          Height="5"
          VerticalAlignment="Center"
          Maximum="100"
          Value="{Binding ProgressPercent, Mode=OneWay}" />
        <TextBlock
          Grid.Column="1"
          Margin="10,0"
          VerticalAlignment="Center"
          FontSize="11"
          Text="{Binding ProgressText}" />
        <!--
          Оборвать команду на сервере можно только сигналом её процессам: стандартный ввод
          закрыт сразу после передачи скрипта, и без терминала Ctrl+C туда не передать.
          «Отменить» — про нашу сторону: перестаём ждать ответ и закрываем канал.
        -->
        <ui:Button
          Grid.Column="2"
          Margin="0,0,6,0"
          Padding="8,2"
          Click="OnInterrupt"
          Content="Ctrl+C"
          FontSize="11"
          Icon="{ui:SymbolIcon Keyboard24}"
          ToolTip="Послать команде Ctrl+C (сигнал INT) — то же, что нажать Ctrl+C в терминале: команда получает прерывание и сворачивается сама вместе со своими потомками" />

        <ui:Button
          Grid.Column="3"
          Margin="0,0,6,0"
          Padding="8,2"
          Click="OnKill"
          Content="Снять"
          FontSize="11"
          Icon="{ui:SymbolIcon Prohibited24}"
          ToolTip="Снять команду принудительно (сигнал KILL) — для того, что после Ctrl+C не отпускает. Сохранить свою работу команда уже не успеет" />

        <ui:Button
          Grid.Column="4"
          Padding="8,2"
          Appearance="Danger"
          Click="OnCancel"
          Content="Отменить"
          FontSize="11"
          Icon="{ui:SymbolIcon Stop24}"
          ToolTip="Перестать ждать ответ и закрыть канал. Сама команда на сервере при этом может продолжать работать — её обрывают Ctrl+C или «Снять»" />
      </Grid>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ui:Button
          Margin="0,0,6,0"
          Padding="9,2"
          Click="OnCopyAll"
          Content="Копировать. Все сервера"
          FontSize="11"
          IsEnabled="{Binding HasResults}"
          ToolTip="Вывод со всех серверов одним текстом — в буфер обмена">
          <ui:Button.Icon>
            <ui:SymbolIcon FontSize="17" Symbol="Copy24" />
          </ui:Button.Icon>
        </ui:Button>
        <CheckBox
          MinWidth="0"
          MinHeight="0"
          Margin="0,0,14,0"
          VerticalAlignment="Center"
          Content="{Binding Source={x:Static services:AppState.Current}, Path=AutoCopyWhen}"
          FontSize="11"
          IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=AutoCopyAll, Mode=TwoWay}"
          ToolTip="Операция закончилась на всех серверах — вывод всех серверов сам копируется в буфер обмена. У команд и у копирования галочки свои. Буфер один, поэтому соседняя галочка при этом снимается" />
        <ui:Button
          Margin="0,0,6,0"
          Padding="9,2"
          Click="OnCopyOne"
          Content="Копировать. Текущее окно"
          FontSize="11"
          ToolTip="Вывод только того сервера, что выбран в таблице слева">
          <ui:Button.Icon>
            <ui:SymbolIcon FontSize="17" Symbol="Copy24" />
          </ui:Button.Icon>
        </ui:Button>
        <CheckBox
          MinWidth="0"
          MinHeight="0"
          Margin="0,0,14,0"
          VerticalAlignment="Center"
          Content="{Binding Source={x:Static services:AppState.Current}, Path=AutoCopyWhen}"
          FontSize="11"
          IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=AutoCopyCurrent, Mode=TwoWay}"
          ToolTip="Операция закончилась — вывод сервера, выбранного в таблице слева, сам копируется в буфер обмена. У команд и у копирования галочки свои. Буфер один, поэтому соседняя галочка при этом снимается" />
        <ui:Button
          Padding="9,2"
          Click="OnRetry"
          Content="Повторить упавшие"
          FontSize="11"
          Icon="{ui:SymbolIcon ArrowClockwise24}"
          Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
    </Grid>

    <!--  поровну: слева таблица серверов, справа вывод; границу двигает разделитель  -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" MinWidth="220" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="1*" MinWidth="260" />
      </Grid.ColumnDefinitions>

      <Border
        Grid.Column="0"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1">
        <!--  строки таблицы тем же шрифтом, что вывод справа; заголовки — как заголовок над выводом  -->
        <DataGrid
          x:Name="ResultsGrid"
          ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
          ItemsSource="{Binding Results}"
          ColumnHeaderHeight="32"
          RowHeight="24"
          SelectionChanged="OnResultPicked"
          RowStyle="{StaticResource AppDataGridRowStyle}"
          SelectionMode="Single"
          Style="{StaticResource AppDataGridStyle}"
          VerticalScrollBarVisibility="Auto">
          <DataGrid.CellStyle>
            <Style BasedOn="{StaticResource AppDataGridCellStyle}" TargetType="DataGridCell">
              <Setter Property="FontFamily" Value="Consolas" />
            </Style>
          </DataGrid.CellStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn
              Width="30"
              CellStyle="{StaticResource IconCellStyle}"
              HeaderStyle="{StaticResource FirstColumnHeaderStyle}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{Binding StatusBrush}"
                    Symbol="{Binding StatusSymbol}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!--  сервер по содержимому; «Прошло» и «Время» постоянной ширины, чтобы чч:мм:сс
                  влезало всегда и столбцы не прыгали; остаток ширины забирает статус  -->
            <DataGridTextColumn
              x:Name="ServerColumn"
              Width="Auto"
              MaxWidth="260"
              Binding="{Binding ShortTitle}"
              Header="Сервер">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding Title}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!--  сколько времени назад сервер закончил: видно, свежий ли результат  -->
            <DataGridTextColumn
              Width="74"
              Binding="{Binding AgoText}"
              Header="Прошло">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="ToolTip" Value="Сколько времени назад сервер закончил, чч:мм:сс" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn
              Width="74"
              Binding="{Binding DurationText}"
              Header="Время">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="ToolTip" Value="Сколько шла работа на сервере" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn
              Width="*"
              MinWidth="90"
              Binding="{Binding ShortStatus}"
              Header="Статус">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{Binding StatusBrush}" />
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding StatusText}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <GridSplitter
        Grid.Column="1"
        Width="6"
        HorizontalAlignment="Stretch"
        Background="Transparent" />

      <Border
        Grid.Column="2"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!--  Шапка вывода вровень с шапкой таблицы слева: та же высота (ColumnHeaderHeight
                у ResultsGrid) и тот же цвет. У таблицы полупрозрачная заливка темы ложится
                в два слоя, поэтому и здесь она в два слоя — иначе шапка выходит темнее  -->
          <Border
            Grid.Row="0"
            Height="32"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <!--  копирование этого вывода переехало в строку кнопок над таблицей  -->
            <Border Padding="8,0" Background="{DynamicResource ControlFillColorDefaultBrush}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="{Binding SelectedItem.FullTitle, ElementName=ResultsGrid, FallbackValue='Вывод — выберите сервер слева', TargetNullValue='Вывод — выберите сервер слева'}"
                    TextTrimming="CharacterEllipsis" />

                  <!--  сколько уже идёт команда, а по окончании — за сколько выполнена  -->
                  <TextBlock
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding SelectedItem.ElapsedText, ElementName=ResultsGrid}"
                    ToolTip="Сколько выполняется команда на выбранном сервере" />
                </Grid>

                <CheckBox
                  Grid.Column="1"
                  MinHeight="0"
                  Margin="8,0,6,0"
                  VerticalAlignment="Center"
                  Content="Сохранять лог"
                  FontSize="11"
                  IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=KeepOutputLog, Mode=TwoWay}"
                  ToolTip="Отмечено — следующий прогон дописывается к этому выводу через отбивку. Снято — вывод каждый раз начинается заново." />

                <Button
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Click="OnClearOutput"
                  Style="{StaticResource OutputIconStyle}"
                  ToolTip="Очистить вывод выбранного сервера">
                  <ui:SymbolIcon FontSize="18" Symbol="Delete24" />
                </Button>

                <Button
                  x:Name="DetachButton"
                  Grid.Column="3"
                  VerticalAlignment="Center"
                  Click="OnDetach"
                  Style="{StaticResource OutputIconStyle}"
                  ToolTip="Открыть вывод в отдельном окне">
                  <ui:SymbolIcon x:Name="DetachIcon" FontSize="18" Symbol="WindowNew24" />
                </Button>
              </Grid>
            </Border>
          </Border>

          <Grid Grid.Row="1">
            <RichTextBox
              x:Name="OutputBox"
              Padding="6,2"
              Background="Transparent"
              BorderThickness="0"
              FontFamily="Consolas"
              FontSize="12"
              HorizontalScrollBarVisibility="Disabled"
              IsReadOnly="True"
              controls:OutputColoring.Text="{Binding SelectedItem.Output, ElementName=ResultsGrid, Mode=OneWay}"
              VerticalScrollBarVisibility="Auto">
              <!--
                Тема подменяет фон поля под мышью и в фокусе — на выводе это выглядит как мигание.
                Ключи состояний переопределены у самого поля: соседних элементов это не касается.
              -->
              <RichTextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
              </RichTextBox.Resources>
            </RichTextBox>

            <!--  панель остаётся на месте, но пока открыто отдельное окно — вывод в нём  -->
            <TextBlock
              x:Name="DetachedHint"
              Margin="10"
              VerticalAlignment="Top"
              FontSize="12"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="Вывод открыт в отдельном окне. Закройте его — и вывод вернётся сюда."
              TextWrapping="Wrap"
              Visibility="Collapsed" />
          </Grid>

          <!--  строка ответа команде выбранного сервера  -->
          <controls:AnswerBar
            x:Name="Answer"
            Grid.Row="2"
            DataContext="{Binding SelectedItem, ElementName=ResultsGrid}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
