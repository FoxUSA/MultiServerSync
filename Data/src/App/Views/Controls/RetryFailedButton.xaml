<UserControl
  x:Class="MultiServerSync.Views.Controls.RetryFailedButton"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <!--  рядом с «Выполнить»: повторяет упавшие строки того прогона, что в терминале вкладки  -->
  <ui:Button
    Click="OnRetry"
    Content="Повторить упавшие"
    Icon="{ui:SymbolIcon ArrowClockwise24}"
    ToolTip="Запустить ещё раз на серверах, где не вышло"
    Visibility="{Binding ResultsBatch.CanRetry, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
</UserControl>
