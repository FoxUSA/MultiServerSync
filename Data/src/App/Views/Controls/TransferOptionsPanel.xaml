<UserControl
  x:Class="MultiServerSync.Views.Controls.TransferOptionsPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <!--
    Параметры переноса — один блок на три раздела: «Копирование», «Скачивание» и «Проводник».
    Привязан к вкладке (Workspace): у каждой вкладки свои значения. Подписи зависят от
    направления, сами параметры и их смысл — одни и те же.
  -->
  <UserControl.Resources>
    <Style
      x:Key="OptionStyle"
      BasedOn="{StaticResource {x:Type CheckBox}}"
      TargetType="CheckBox">
      <Setter Property="Margin" Value="0,2,4,2" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
      x:Key="ChoiceStyle"
      BasedOn="{StaticResource {x:Type RadioButton}}"
      TargetType="RadioButton">
      <Setter Property="Margin" Value="0,2,4,2" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Resources>

  <Border
    Padding="12,8"
    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="4">
    <StackPanel>
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
          x:Name="HeaderText"
          VerticalAlignment="Center"
          FontSize="11"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="ПАРАМЕТРЫ КОПИРОВАНИЯ" />

        <!--  исключения — у проводника здесь же, у вкладок они стоят у списка файлов  -->
        <ui:Button
          x:Name="ExcludeButton"
          Grid.Column="1"
          Height="24"
          Padding="8,0"
          Click="OnExcludes"
          FontSize="11"
          Icon="{ui:SymbolIcon Filter24}"
          ToolTip="Какие файлы и папки не копировать: маски вроде node_modules, *.log"
          Visibility="Collapsed">
          <TextBlock Text="{Binding ExcludeCaption}" />
        </ui:Button>
      </Grid>

      <TextBlock
        x:Name="ModeTitle"
        Margin="0,0,0,2"
        FontSize="11"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="Отправлять на сервер:" />

      <UniformGrid x:Name="ModeGrid" Columns="2" Rows="2">
        <RadioButton
          x:Name="AllChoice"
          Content="все отмеченные файлы"
          IsChecked="{Binding SendEverything, Mode=TwoWay}"
          Style="{StaticResource ChoiceStyle}" />
        <RadioButton
          x:Name="MissingChoice"
          Content="только те, которых нет на сервере"
          IsChecked="{Binding SendMissingOnly, Mode=TwoWay}"
          Style="{StaticResource ChoiceStyle}" />
        <RadioButton
          x:Name="DateChoice"
          Content="отличающиеся по дате изменения"
          IsChecked="{Binding SendByDate, Mode=TwoWay}"
          Style="{StaticResource ChoiceStyle}" />
        <RadioButton
          x:Name="HashChoice"
          Content="отличающиеся по контрольной сумме"
          IsChecked="{Binding SendByHash, Mode=TwoWay}"
          Style="{StaticResource ChoiceStyle}" />
      </UniformGrid>

      <Separator Margin="0,2,0,2" Opacity="0.4" />

      <UniformGrid Columns="2" Rows="1">
        <CheckBox
          x:Name="DateOption"
          Content="сохранять дату изменения"
          IsChecked="{Binding PreserveTimestamps, Mode=TwoWay}"
          Style="{StaticResource OptionStyle}" />
        <CheckBox
          x:Name="VerifyOption"
          Content="после копирования сверять суммы"
          IsChecked="{Binding VerifyChecksums, Mode=TwoWay}"
          Style="{StaticResource OptionStyle}" />
      </UniformGrid>
    </StackPanel>
  </Border>
</UserControl>
