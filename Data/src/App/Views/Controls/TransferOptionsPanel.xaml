<UserControl
  x:Class="MultiServerSync.Views.Controls.TransferOptionsPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <!--
    Параметры переноса — один блок на три раздела: «Копирование», «Скачивание» и «Проводник».
    Привязан к вкладке (Workspace): у каждой вкладки свои значения. Подписи зависят от
    направления, сами параметры и их смысл — одни и те же.
  -->
  <UserControl.Resources>
    <!--  строки плотно, без растяжки на всю ширину: вторая колонка встаёт сразу за первой  -->
    <Style
      x:Key="OptionStyle"
      BasedOn="{StaticResource {x:Type CheckBox}}"
      TargetType="CheckBox">
      <!--  минус слева: у галочки темы свой отступ, а стоять она должна ровно под кружками  -->
      <Setter Property="Margin" Value="-10.67,1,24,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
      x:Key="ChoiceStyle"
      BasedOn="{StaticResource {x:Type RadioButton}}"
      TargetType="RadioButton">
      <Setter Property="Margin" Value="0,1,24,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Resources>

  <Border
    x:Name="Frame"
    Padding="12,8"
    Background="Transparent"
    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="4">
    <StackPanel>
      <Grid x:Name="HeaderRow" Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
          x:Name="HeaderText"
          Grid.Column="0"
          VerticalAlignment="Center"
          FontSize="11"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="ПАРАМЕТРЫ КОПИРОВАНИЯ" />

        <!--  исключения — у проводника здесь же, у вкладок они стоят у списка файлов  -->
        <ui:Button
          x:Name="ExcludeButton"
          Grid.Column="1"
          Height="24"
          Padding="8,0"
          Click="OnExcludes"
          FontSize="11"
          ToolTip="Какие файлы и папки не копировать: маски вроде node_modules, *.log"
          Visibility="Collapsed">
          <!--  заданы исключения — значок на зелёной плашке, как у кнопки на «Копировании» и «Скачивании».
                Плашка здесь мельче: кнопка ниже  -->
          <StackPanel Orientation="Horizontal">
            <Border
              Margin="-2,0,4,0"
              Padding="1.5"
              Style="{StaticResource ExcludeBadgeStyle}">
              <ui:SymbolIcon FontSize="11" Style="{StaticResource ExcludeGlyphStyle}" />
            </Border>
            <TextBlock VerticalAlignment="Center" Text="Исключения" />
          </StackPanel>
        </ui:Button>
      </Grid>

      <StackPanel x:Name="Body">
      <TextBlock
        x:Name="ModeTitle"
        Margin="0,0,0,2"
        FontSize="11"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="Отправлять на сервер:" />

      <Grid x:Name="ModeGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <RadioButton
          x:Name="AllChoice"
          Grid.Row="0"
          Grid.Column="0"
          Content="все отмеченные файлы"
          IsChecked="{Binding SendEverything, Mode=TwoWay}"
          Style="{StaticResource ChoiceStyle}" />
        <RadioButton
          x:Name="MissingChoice"
          Grid.Row="0"
          Grid.Column="1"
          Content="только те, которых нет на сервере"
          IsChecked="{Binding SendMissingOnly, Mode=TwoWay}"
          Style="{StaticResource ChoiceStyle}" />
        <RadioButton
          x:Name="DateChoice"
          Grid.Row="1"
          Grid.Column="0"
          Content="отличающиеся по дате изменения"
          IsChecked="{Binding SendByDate, Mode=TwoWay}"
          Style="{StaticResource ChoiceStyle}" />
        <RadioButton
          x:Name="HashChoice"
          Grid.Row="1"
          Grid.Column="1"
          Content="отличающиеся по контрольной сумме"
          IsChecked="{Binding SendByHash, Mode=TwoWay}"
          Style="{StaticResource ChoiceStyle}" />

        <Separator
          Grid.Row="2"
          Grid.ColumnSpan="4"
          Margin="0,2"
          Opacity="0.4" />

        <CheckBox
          x:Name="DateOption"
          Grid.Row="3"
          Grid.Column="0"
          Content="сохранять дату изменения"
          IsChecked="{Binding PreserveTimestamps, Mode=TwoWay}"
          Style="{StaticResource OptionStyle}" />
        <CheckBox
          x:Name="VerifyOption"
          Grid.Row="3"
          Grid.Column="1"
          Content="после копирования сверять суммы"
          IsChecked="{Binding VerifyChecksums, Mode=TwoWay}"
          Style="{StaticResource OptionStyle}" />
        <!--  только у «Проводника»: там копирование может перезаписать файлы одним нажатием.
              Подпись короткая: «не спрашивать перед заменой» в окне параметров обрезалась  -->
        <CheckBox
          x:Name="ReplaceOption"
          Grid.Row="3"
          Grid.Column="2"
          Content="заменять без вопроса"
          IsChecked="{Binding ReplaceWithoutAsking, Mode=TwoWay}"
          Style="{StaticResource OptionStyle}"
          ToolTip="Сняли — копирование, которое перезапишет файлы в папке назначения, сначала спросит. Одинаковые файлы при сверке по дате или сумме заменой не считаются."
          Visibility="Collapsed" />
      </Grid>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
