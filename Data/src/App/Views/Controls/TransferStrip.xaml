<UserControl
  x:Class="MultiServerSync.Views.Controls.TransferStrip"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls">

  <!--
    Ход копирования или скачивания — одна полоса на всю программу: в проводнике, под выводом
    и в отдельном окне вывода. DataContext — строка сервера (OperationResult). Кнопка
    «Остановить» — только где задан Batch: в окнах вывода она уже стоит в их шапке.
  -->
  <Border
    Padding="8,2"
    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="4">
    <Grid MinHeight="28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!--  шаг словами: подключение, сверка, копирование — тот же, что в строке сервера  -->
      <TextBlock
        Grid.Column="0"
        Margin="0,0,8,0"
        VerticalAlignment="Center"
        FontSize="12"
        FontWeight="SemiBold"
        Text="{Binding Message, FallbackValue=''}" />
      <ProgressBar
        Grid.Column="1"
        Height="5"
        VerticalAlignment="Center"
        Maximum="100"
        Value="{Binding TransferPercent, Mode=OneWay, FallbackValue=0}" />
      <TextBlock
        Grid.Column="2"
        Margin="8,0"
        VerticalAlignment="Center"
        FontSize="11"
        Text="{Binding TransferText, FallbackValue=''}" />
      <controls:StopButton
        x:Name="Stop"
        Grid.Column="3"
        Visibility="Collapsed" />
    </Grid>
  </Border>
</UserControl>
