<ui:FluentWindow
  x:Class="MultiServerSync.Views.Dialogs.AfterCopyWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:core="clr-namespace:MultiServerSync.Core"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Команды после копирования"
  Icon="pack://application:,,,/Assets/app.ico"
  Width="1000"
  Height="640"
  MinWidth="560"
  MinHeight="360"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ShowInTaskbar="False"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      Grid.Row="0"
      Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
      Icon="{core:AppIcon}"
      ShowMinimize="False" />

    <!--  та же страница «Команды» личной вкладки, такой же карточкой, как в главном окне  -->
    <Border
      Grid.Row="1"
      Margin="12,0,12,12"
      Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
      BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="8">
      <Frame
        x:Name="PageHost"
        Focusable="False"
        NavigationUIVisibility="Hidden" />
    </Border>
  </Grid>
</ui:FluentWindow>
