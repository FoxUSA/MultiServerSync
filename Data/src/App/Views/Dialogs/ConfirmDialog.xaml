<ui:FluentWindow
  x:Class="MultiServerSync.Views.Dialogs.ConfirmDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Подтверждение"
  Width="460"
  MinHeight="0"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">

  <!--  вместо системного MessageBox: тот белый и чужой в тёмной программе  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      Grid.Row="0"
      Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <Grid Grid.Row="1" Margin="22,6,22,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ui:SymbolIcon
        x:Name="Glyph"
        Grid.Column="0"
        Margin="0,0,16,0"
        VerticalAlignment="Top"
        Filled="True"
        FontSize="32"
        Foreground="#E8B54A"
        Symbol="Warning24" />

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock
          x:Name="HeadlineText"
          FontSize="15"
          FontWeight="SemiBold"
          TextWrapping="Wrap" />
        <TextBlock
          x:Name="DetailText"
          Margin="0,6,0,0"
          FontSize="13"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <!--  полоса с кнопками, как у системных диалогов Windows 11  -->
    <Border
      Grid.Row="2"
      Padding="22,14"
      Background="{DynamicResource ControlFillColorDefaultBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="0,1,0,0">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button
          x:Name="ConfirmButton"
          MinWidth="110"
          Margin="0,0,8,0"
          Appearance="Danger"
          Click="OnConfirm" />
        <ui:Button
          x:Name="CancelButton"
          MinWidth="110"
          Click="OnCancel"
          Content="Отмена"
          IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
