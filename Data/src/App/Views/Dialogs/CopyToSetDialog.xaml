<ui:FluentWindow
  x:Class="MultiServerSync.Views.Dialogs.CopyToSetDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Скопировать в наборы"
  Width="460"
  MinHeight="0"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      Grid.Row="0"
      Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="22,6,22,18">
      <TextBlock
        x:Name="HeadlineText"
        FontSize="15"
        FontWeight="SemiBold"
        TextWrapping="Wrap" />
      <TextBlock
        x:Name="DetailText"
        Margin="0,6,0,10"
        FontSize="13"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        TextWrapping="Wrap" />

      <!--  наборы-получатели: отмечается сколько угодно  -->
      <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="SetList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!--  имя текстом: подчёркивание в Content WPF съедает («TGbyFox_bot» → «TGbyFoxbot»)  -->
              <CheckBox
                Margin="0,2"
                Click="OnPickChanged"
                IsChecked="{Binding IsPicked, Mode=TwoWay}">
                <TextBlock Text="{Binding Label}" />
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>

    <Border
      Grid.Row="2"
      Padding="22,14">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button
          x:Name="ConfirmButton"
          MinWidth="110"
          Margin="0,0,8,0"
          Click="OnConfirm"
          Content="Скопировать"
          IsDefault="True"
          IsEnabled="False" />
        <ui:Button
          MinWidth="110"
          Click="OnCancel"
          Content="Отмена"
          IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
