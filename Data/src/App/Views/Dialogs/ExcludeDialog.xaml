<ui:FluentWindow
  x:Class="MultiServerSync.Views.Dialogs.ExcludeDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Исключения"
  Width="480"
  MinHeight="0"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      Grid.Row="0"
      Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="22,6,22,18">
      <TextBlock
        FontSize="13"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="Что не копировать — по маске в строке. *.log и node_modules — на любой глубине, cache/ — только папка, build/** — путь от копируемой папки."
        TextWrapping="Wrap" />

      <ui:TextBox
        x:Name="MasksBox"
        Height="150"
        Margin="0,10,0,0"
        AcceptsReturn="True"
        FontFamily="Consolas"
        PlaceholderText="ничего не исключается"
        VerticalContentAlignment="Top"
        VerticalScrollBarVisibility="Auto" />

      <TextBlock
        Margin="0,12,0,6"
        FontSize="13"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="Шаблоны — щелчок добавляет:" />
      <ItemsControl x:Name="TemplatesList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!--  текстом, а не Content: подчёркивание в подписи WPF съедает («node_modules» → «nodemodules»)  -->
            <ui:Button
              Margin="0,0,4,4"
              Padding="10,3"
              Click="OnTemplate"
              FontFamily="Consolas">
              <TextBlock Text="{Binding}" />
            </ui:Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Border
      Grid.Row="2"
      Padding="22,14">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button
          MinWidth="110"
          Margin="0,0,8,0"
          Click="OnSave"
          Content="Сохранить" />
        <ui:Button
          MinWidth="110"
          Click="OnCancel"
          Content="Отмена"
          IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
