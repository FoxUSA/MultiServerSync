<ui:FluentWindow
  x:Class="MultiServerSync.Views.Dialogs.ExcludeDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Исключения"
  Width="520"
  MinHeight="0"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">

  <ui:FluentWindow.Resources>
    <!--  вкладки окна — кнопками того же вида, что шаблоны ниже: у темы ярлыки сливались с фоном окна.
          Открытая — белым жирным и с полоской акцентом снизу, остальные — серым. Рамка цветом исключений,
          пока в поле вкладки есть маски (её ставит код), иначе рамка обычной кнопки.
          Цвет и жирность — только у подписи ярлыка: свойствами самой вкладки они протекали в её содержимое  -->
    <Style x:Key="ExcludeTabStyle" TargetType="TabItem">
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <!--  фокус не отключать: вкладка открывается именно получением фокуса, без него щелчок не переключал.
            Пунктир фокуса не нужен — сразу после щелчка фокус уходит в поле масок  -->
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid Margin="0,0,0,6">
              <Border
                x:Name="Bd"
                Padding="{TemplateBinding Padding}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1.5"
                CornerRadius="4">
                <ContentPresenter
                  x:Name="Label"
                  VerticalAlignment="Center"
                  ContentSource="Header"
                  TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </Border>
              <Rectangle
                x:Name="Bar"
                Height="2"
                Margin="10,0,10,-6"
                VerticalAlignment="Bottom"
                Fill="{DynamicResource AccentFillColorDefaultBrush}"
                RadiusX="1"
                RadiusY="1"
                Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold" />
                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      Grid.Row="0"
      Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="22,6,22,18">
      <!--  свои маски вкладки и общие на все вкладки; шаблоны ниже дописываются в открытую  -->
      <TabControl x:Name="Tabs">
        <!--  ряд ярлыков и под ним поле открытой вкладки — без рамок и фонов темы  -->
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <DockPanel>
              <!--  обычный ряд, а не TabPanel: тот обрезал правый ярлык, когда подпись становилась жирной.
                    Справа от ярлыков — то, что лежит в Tag: переключатель глобальных  -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                <ContentPresenter
                  Margin="8,0,0,6"
                  VerticalAlignment="Center"
                  Content="{TemplateBinding Tag}" />
              </StackPanel>
              <ContentPresenter ContentSource="SelectedContent" />
            </DockPanel>
          </ControlTemplate>
        </TabControl.Template>

        <!--  глобальные на этой вкладке: включено — фиолетовым, как их плашка на кнопке; память у каждой вкладки своя  -->
        <TabControl.Tag>
          <!--  подпись — про включённое положение: фиолетовый = действуют  -->
          <ui:ToggleSwitch
            x:Name="UseGlobalSwitch"
            Content="Применять на этой вкладке"
            FontSize="13"
            ToolTip="Глобальные исключения на этой вкладке. Выключено — они здесь не действуют, но сами не стираются">
            <ui:ToggleSwitch.Resources>
              <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#6B4FA8" />
              <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#7B5FBA" />
              <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#5E4496" />
              <!--  своей обводки нет — только заливка  -->
              <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
              <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent" />
              <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent" />
            </ui:ToggleSwitch.Resources>
          </ui:ToggleSwitch>
        </TabControl.Tag>

        <!--  зелёная рамка, как плашка на кнопке «Исключения», пока в поле есть маски  -->
        <TabItem
          x:Name="OwnTab"
          Header="Эта вкладка"
          Style="{StaticResource ExcludeTabStyle}">
          <StackPanel Margin="0,10,0,0">
            <!--  описания обеих вкладок — одной высоты в три строки: иначе окно прыгало при переключении  -->
            <TextBlock
              MinHeight="54"
              FontSize="13"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="Что не копировать — по маске в строке. *.log и node_modules — на любой глубине, .env — ещё и .env.local, cache/ — только папка, /build — только в корне копируемой папки."
              TextWrapping="Wrap" />
            <ui:TextBox
              x:Name="OwnBox"
              Height="150"
              Margin="0,10,0,0"
              AcceptsReturn="True"
              FontFamily="Consolas"
              PlaceholderText="ничего не исключается"
              VerticalContentAlignment="Top"
              VerticalScrollBarVisibility="Auto" />
          </StackPanel>
        </TabItem>
        <TabItem
          x:Name="GlobalTab"
          Header="Глобально"
          Style="{StaticResource ExcludeTabStyle}">
          <StackPanel Margin="0,10,0,0">
            <TextBlock
              MinHeight="54"
              FontSize="13"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="Действуют на всех вкладках «Копирования», «Проводника» и «Скачивания» вместе с исключениями вкладки. Переключатель выше выключает их только здесь."
              TextWrapping="Wrap" />
            <ui:TextBox
              x:Name="GlobalBox"
              Height="150"
              Margin="0,10,0,0"
              AcceptsReturn="True"
              FontFamily="Consolas"
              PlaceholderText="ничего не исключается"
              VerticalContentAlignment="Top"
              VerticalScrollBarVisibility="Auto" />
          </StackPanel>
        </TabItem>
      </TabControl>

      <TextBlock
        Margin="0,12,0,6"
        FontSize="13"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="Шаблоны — щелчок добавляет:" />
      <ui:Button
        Margin="0,0,0,4"
        Padding="10,3"
        Click="OnStandardSet"
        Content="Стандартный набор"
        Icon="{ui:SymbolIcon Sparkle24}"
        ToolTip="Всё, что на сервер почти никогда не льют: мусор ОС и редакторов, кэш и окружения Python и JavaScript, папки .git и настроек IDE. Добавляет только то, чего ещё нет" />
      <ItemsControl x:Name="TemplatesList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!--  текстом, а не Content: подчёркивание в подписи WPF съедает («node_modules» → «nodemodules»)  -->
            <ui:Button
              Margin="0,0,4,4"
              Padding="10,3"
              Click="OnTemplate"
              FontFamily="Consolas">
              <TextBlock Text="{Binding}" />
            </ui:Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!--  щелчок по шаблону, который уже есть, — не молчит  -->
      <TextBlock
        x:Name="TemplateNote"
        Margin="0,4,0,0"
        FontSize="12"
        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
        Visibility="Collapsed" />
    </StackPanel>

    <Border
      Grid.Row="2"
      Padding="22,14">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button
          MinWidth="110"
          Margin="0,0,8,0"
          Click="OnSave"
          Content="Сохранить" />
        <ui:Button
          MinWidth="110"
          Click="OnCancel"
          Content="Отмена"
          IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
