<ui:FluentWindow
  x:Class="MultiServerSync.Views.Dialogs.MasterPasswordDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Мастер-пароль"
  Width="440"
  MinHeight="0"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ResizeMode="NoResize"
  SizeToContent="Height"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      Grid.Row="0"
      Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <Grid Grid.Row="1" Margin="22,6,22,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ui:SymbolIcon
        Grid.Column="0"
        Margin="0,0,16,0"
        VerticalAlignment="Top"
        Filled="True"
        FontSize="32"
        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
        Symbol="LockClosed24" />

      <StackPanel Grid.Column="1">
        <TextBlock
          x:Name="HeadlineText"
          FontSize="15"
          FontWeight="SemiBold"
          TextWrapping="Wrap" />
        <TextBlock
          x:Name="DetailText"
          Margin="0,6,0,12"
          FontSize="13"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          TextWrapping="Wrap" />

        <ui:PasswordBox
          x:Name="FirstBox"
          PlaceholderText="Мастер-пароль"
          RevealButtonEnabled="True" />
        <ui:PasswordBox
          x:Name="SecondBox"
          Margin="0,8,0,0"
          PlaceholderText="Ещё раз"
          RevealButtonEnabled="True" />

        <!--  подсказка, а не ошибка программы: тем же жёлтым, что значок в окне подтверждения  -->
        <TextBlock
          x:Name="HintText"
          Margin="0,8,0,0"
          FontSize="13"
          Foreground="#E8B54A"
          TextWrapping="Wrap"
          Visibility="Collapsed" />

        <ui:Button
          x:Name="ForgotButton"
          Margin="-11,6,0,0"
          Padding="11,4"
          Appearance="Transparent"
          Click="OnForgot"
          Content="Не помню пароль"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </Grid>

    <Border
      Grid.Row="2"
      Padding="22,14">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button
          x:Name="ConfirmButton"
          MinWidth="110"
          Margin="0,0,8,0"
          Click="OnConfirm"
          IsDefault="True" />
        <ui:Button
          x:Name="CancelButton"
          MinWidth="110"
          Click="OnCancel"
          IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
