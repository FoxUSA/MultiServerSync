<ui:FluentWindow
  x:Class="MultiServerSync.Views.Dialogs.RemoteBrowserWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Папка на сервере"
  Width="1040"
  Height="680"
  MinWidth="760"
  MinHeight="480"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

    <!--  та же панель, что у сервера в «Проводнике»: кнопки, адрес, маски, дерево и список —
          правка там сразу видна и здесь. Сервер выбирается кнопкой слева от пути  -->
    <controls:FilePane
      x:Name="Pane"
      Grid.Row="1"
      Margin="12,2,12,0" />

    <Grid Grid.Row="2" Margin="12,10,12,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock
        Grid.Column="0"
        Margin="0,0,8,0"
        VerticalAlignment="Center"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="Будет выбрано:" />
      <TextBlock
        x:Name="ChoiceText"
        Grid.Column="1"
        VerticalAlignment="Center"
        FontFamily="Consolas"
        FontWeight="SemiBold"
        TextTrimming="CharacterEllipsis" />

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <ui:Button
          x:Name="ChooseButton"
          Margin="0,0,8,0"
          Click="OnChoose"
          Content="Выбрать"
          Icon="{ui:SymbolIcon Checkmark24}"
          ToolTip="Отмеченная галочкой папка, а если ничего не отмечено — открытая" />
        <ui:Button
          Click="OnCancel"
          Content="Отмена"
          IsCancel="True" />
      </StackPanel>
    </Grid>
  </Grid>
</ui:FluentWindow>
