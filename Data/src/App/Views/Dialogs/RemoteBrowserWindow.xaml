<ui:FluentWindow
  x:Class="MultiServerSync.Views.Dialogs.RemoteBrowserWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:dialogs="clr-namespace:MultiServerSync.Views.Dialogs"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Папка на сервере"
  Width="1040"
  Height="680"
  MinWidth="760"
  MinHeight="480"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">

  <ui:FluentWindow.Resources>
    <!--  кнопки панели инструментов: квадратные, только значок, как в проводнике.
          Высота 36 — как у выбора сервера, адреса и маски: весь ряд ровный  -->
    <Style
      x:Key="NavButtonStyle"
      BasedOn="{StaticResource {x:Type ui:Button}}"
      TargetType="ui:Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Appearance" Value="Transparent" />
    </Style>

    <!--  часть пути в адресной строке: плоский текст, подсветка под мышью  -->
    <Style x:Key="CrumbButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Padding="4,3"
              Background="Transparent"
              CornerRadius="4">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  папки жёлтые, как в проводнике и WinSCP: глаз находит их сразу  -->
    <SolidColorBrush x:Key="FolderBrush" Color="#E8B54A" />

    <!--  крестик сброса маски: виден, пока маска не пустая, даже без фокуса в поле —
          иначе забытый фильтр молча прячет файлы  -->
    <Style x:Key="MaskClearButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="ToolTip" Value="Сбросить маску" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="Transparent"
              CornerRadius="4">
              <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                FontSize="10"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="&#xE711;" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

    <!--  навигация: сервер, назад/вперёд/вверх/корень/обновить/новая папка, адрес, маска файлов  -->
    <Grid Grid.Row="1" Margin="12,2,12,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="220" />
      </Grid.ColumnDefinitions>

      <ComboBox
        x:Name="ServerBox"
        Grid.Column="0"
        Height="36"
        Margin="0,0,10,0"
        VerticalContentAlignment="Center"
        DisplayMemberPath="Display"
        SelectionChanged="OnServerChanged"
        ToolTip="Какой сервер смотреть. Путь выбирается один на все отмеченные серверы вкладки." />

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ui:Button
          x:Name="BackButton"
          Click="OnBack"
          Icon="{ui:SymbolIcon ArrowLeft24}"
          Style="{StaticResource NavButtonStyle}"
          ToolTip="Назад (Alt+←)" />
        <ui:Button
          x:Name="ForwardButton"
          Click="OnForward"
          Icon="{ui:SymbolIcon ArrowRight24}"
          Style="{StaticResource NavButtonStyle}"
          ToolTip="Вперёд (Alt+→)" />
        <ui:Button
          Click="OnUp"
          Icon="{ui:SymbolIcon ArrowUp24}"
          Style="{StaticResource NavButtonStyle}"
          ToolTip="На уровень вверх (Backspace)" />
        <ui:Button
          Click="OnHome"
          Icon="{ui:SymbolIcon Home24}"
          Style="{StaticResource NavButtonStyle}"
          ToolTip="Домашняя папка пользователя" />
        <ui:Button
          Click="OnRefresh"
          Icon="{ui:SymbolIcon ArrowClockwise24}"
          Style="{StaticResource NavButtonStyle}"
          ToolTip="Перечитать папку с сервера (F5)" />
        <ui:Button
          Click="OnNewFolder"
          Icon="{ui:SymbolIcon FolderAdd24}"
          Style="{StaticResource NavButtonStyle}"
          ToolTip="Новая папка в открытой" />
      </StackPanel>

      <!--
        Адрес как в WinSCP и проводнике: части пути — кнопки, щелчок по пустому месту
        (или Ctrl+L, F4) открывает обычное поле для ввода. Поле скрыто, но не убрано —
        по нему строка берёт высоту, и при переключении ничего не прыгает.
      -->
      <Grid
        Grid.Column="2"
        Height="36"
        Margin="6,0,0,0">
        <ui:TextBox
          x:Name="PathBox"
          VerticalContentAlignment="Center"
          FontFamily="Consolas"
          KeyDown="OnPathKeyDown"
          LostKeyboardFocus="OnPathLostFocus"
          ToolTip="Адрес папки. Впишите путь и нажмите Enter"
          Visibility="Hidden" />

        <Border
          x:Name="CrumbBar"
          Background="{DynamicResource ControlFillColorDefaultBrush}"
          BorderBrush="{DynamicResource ControlElevationBorderBrush}"
          BorderThickness="1"
          CornerRadius="4"
          Cursor="IBeam"
          MouseLeftButtonDown="OnCrumbBarClick"
          ToolTip="Щелчок по папке — перейти в неё, по пустому месту — вписать путь">
          <ScrollViewer
            x:Name="CrumbScroll"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel
              x:Name="Crumbs"
              Margin="6,0"
              VerticalAlignment="Center"
              Orientation="Horizontal" />
          </ScrollViewer>
        </Border>
      </Grid>

      <!--  маска файлов: в списке остаются папки и файлы, подходящие под неё  -->
      <Grid Grid.Column="3" Margin="8,0,0,0">
        <ui:TextBox
          x:Name="FileMaskBox"
          Height="36"
          Padding="10,0,34,0"
          VerticalContentAlignment="Center"
          ClearButtonEnabled="False"
          Icon="{ui:SymbolIcon Filter24}"
          PlaceholderText="маска файлов: *.conf"
          TextChanged="OnFileMaskChanged"
          ToolTip="Показывать только файлы, подходящие под маску: *.conf, *.log, nginx. Несколько — через пробел. Папки видны всегда" />
        <Button
          x:Name="FileMaskClear"
          Click="OnClearFileMask"
          Style="{StaticResource MaskClearButtonStyle}" />
      </Grid>
    </Grid>

    <Grid Grid.Row="2" Margin="12,0,12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="160" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  маска папок: в дереве остаются подходящие папки и путь к ним  -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
          <ui:TextBox
            x:Name="FolderMaskBox"
            Height="36"
            Padding="10,0,34,0"
            VerticalContentAlignment="Center"
            ClearButtonEnabled="False"
            Icon="{ui:SymbolIcon Filter24}"
            PlaceholderText="маска папок: nginx"
            TextChanged="OnFolderMaskChanged"
            ToolTip="Показывать в дереве только папки, подходящие под маску, и путь к ним. Ищет среди уже раскрытых веток" />
          <Button
            x:Name="FolderMaskClear"
            Click="OnClearFolderMask"
            Style="{StaticResource MaskClearButtonStyle}" />
        </Grid>

      <Border
        Grid.Row="1"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <TreeView
          x:Name="Tree"
          Padding="2,4"
          Background="Transparent"
          BorderThickness="0"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
          SelectedItemChanged="OnTreeSelected">
          <TreeView.Resources>
            <!--  стрелка раскрытия  -->
            <Style x:Key="TreeExpanderStyle" TargetType="ToggleButton">
              <Setter Property="Width" Value="16" />
              <Setter Property="Height" Value="16" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border
                      Width="16"
                      Height="16"
                      Background="Transparent">
                      <Path
                        x:Name="Arrow"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 5 2 L 10 7 L 5 12"
                        RenderTransformOrigin="0.5,0.5"
                        Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                        StrokeEndLineCap="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.4">
                        <Path.RenderTransform>
                          <RotateTransform Angle="0" />
                        </Path.RenderTransform>
                      </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Arrow" Property="RenderTransform">
                          <Setter.Value>
                            <RotateTransform Angle="90" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </TreeView.Resources>

          <!--
            Свой шаблон узла: системный рисует чёрный текст и светлую плашку выделения,
            в тёмной теме это нечитаемо. Раскрытие и выбор привязаны к узлу —
            так окно само разворачивает дерево до открытой папки.
          -->
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <EventSetter Event="Expanded" Handler="OnNodeExpanded" />
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Padding" Value="4,2" />
              <Setter Property="HorizontalContentAlignment" Value="Left" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <ToggleButton
                        x:Name="Expander"
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        ClickMode="Press"
                        IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{StaticResource TreeExpanderStyle}" />

                      <Border
                        x:Name="Bd"
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <ContentPresenter
                          x:Name="PART_Header"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          ContentSource="Header" />
                      </Border>

                      <ItemsPresenter
                        x:Name="ItemsHost"
                        Grid.Row="1"
                        Grid.Column="1" />
                    </Grid>

                    <ControlTemplate.Triggers>
                      <Trigger Property="IsExpanded" Value="False">
                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                      </Trigger>
                      <Trigger Property="HasItems" Value="False">
                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                      </Trigger>
                      <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppRowHoverBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppRowSelectedBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <!--  не подходит под маску папок  -->
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate DataType="{x:Type dialogs:RemoteNode}" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                  Margin="0,0,6,0"
                  VerticalAlignment="Center"
                  Filled="True"
                  FontSize="15"
                  Foreground="{StaticResource FolderBrush}"
                  Symbol="Folder24" />
                <TextBlock
                  VerticalAlignment="Center"
                  FontSize="13"
                  Text="{Binding Name}" />
              </StackPanel>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>
      </Grid>

      <GridSplitter
        Grid.Column="1"
        Width="6"
        HorizontalAlignment="Stretch"
        Background="Transparent" />

      <!--  список папки: «..» сверху, папки перед файлами, сортировка щелчком по шапке  -->
      <DataGrid
        x:Name="Listing"
        Grid.Column="2"
        CellStyle="{StaticResource AppDataGridCellStyle}"
        ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
        MouseDoubleClick="OnListingDoubleClick"
        PreviewKeyDown="OnListingKeyDown"
        RowStyle="{StaticResource AppDataGridRowStyle}"
        SelectionChanged="OnListingSelected"
        SelectionMode="Single"
        Sorting="OnListingSorting"
        Style="{StaticResource AppDataGridStyle}"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.VirtualizationMode="Recycling">
        <DataGrid.Columns>
          <DataGridTemplateColumn
            Width="*"
            MinWidth="200"
            Header="Имя"
            SortMemberPath="Name">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon
                    x:Name="Icon"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="{Binding Symbol}" />
                  <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="ссылка"
                    Visibility="{Binding LinkVisibility}" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource FolderBrush}" />
                    <Setter TargetName="Icon" Property="Filled" Value="True" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn
            Width="100"
            Binding="{Binding SizeText}"
            Header="Размер"
            SortMemberPath="Length">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn
            Width="140"
            Binding="{Binding ModifiedText}"
            Header="Изменено"
            SortMemberPath="Modified" />
          <DataGridTextColumn
            Width="100"
            Binding="{Binding Permissions}"
            FontFamily="Consolas"
            Header="Права"
            SortMemberPath="Permissions" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <!--  строка состояния: что открыто и сколько всего  -->
    <TextBlock
      x:Name="BusyText"
      Grid.Row="3"
      Margin="14,6,14,0"
      FontSize="12"
      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
      TextTrimming="CharacterEllipsis" />

    <Grid Grid.Row="4" Margin="12,10,12,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock
        Grid.Column="0"
        Margin="0,0,8,0"
        VerticalAlignment="Center"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="Будет выбрано:" />
      <TextBlock
        x:Name="ChoiceText"
        Grid.Column="1"
        VerticalAlignment="Center"
        FontFamily="Consolas"
        FontWeight="SemiBold"
        TextTrimming="CharacterEllipsis" />

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <ui:Button
          Margin="0,0,8,0"
          Click="OnChoose"
          Content="Выбрать"
          Icon="{ui:SymbolIcon Checkmark24}"
          ToolTip="Выделенная в списке папка, а если ничего не выделено — открытая" />
        <ui:Button Click="OnCancel" Content="Отмена" />
      </StackPanel>
    </Grid>
  </Grid>
</ui:FluentWindow>
