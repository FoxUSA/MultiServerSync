<ui:FluentWindow
  x:Class="MultiServerSync.Views.Dialogs.TabBoardWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:core="clr-namespace:MultiServerSync.Core"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Все вкладки"
  Icon="pack://application:,,,/Assets/app.ico"
  Width="760"
  Height="560"
  MinWidth="360"
  MinHeight="320"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">

  <ui:FluentWindow.Resources>
    <!--  кирпич вкладки: размер фиксирован, ряды набираются по ширине окна  -->
    <Style x:Key="BoardBrickStyle" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1"
              CornerRadius="6">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Trigger>
        <!--  открытая вкладка последней в списке: подсветка перебивает наведение  -->
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!--  мелкие кнопки в углах кирпича  -->
    <Style x:Key="BrickIconButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <!--  цвет берётся от самого кирпича: у открытой вкладки он на акцентном фоне  -->
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4">
              <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="10"
                Foreground="{TemplateBinding Foreground}"
                Text="{TemplateBinding Content}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style
      x:Key="BrickCloseButtonStyle"
      BasedOn="{StaticResource BrickIconButtonStyle}"
      TargetType="Button">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4">
              <TextBlock
                x:Name="Glyph"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="10"
                Foreground="{TemplateBinding Foreground}"
                Text="&#x2715;" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      Grid.Row="0"
      Title="Все вкладки"
      Icon="{core:AppIcon}" />

    <Grid
      Grid.Row="1"
      Margin="12,2,12,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ui:Button
        Grid.Column="0"
        Height="30"
        Margin="0,0,8,0"
        Padding="10,0"
        VerticalAlignment="Center"
        Click="OnAddTab"
        FontSize="12"
        Icon="{ui:SymbolIcon Add24}"
        ToolTip="Новая вкладка (Ctrl+T)" />

      <ui:TextBox
        x:Name="FilterBox"
        Grid.Column="1"
        Height="30"
        VerticalContentAlignment="Center"
        FontSize="12"
        PlaceholderText="Поиск по названию вкладки и по отмеченным серверам"
        TextChanged="OnFilterChanged" />

      <TextBlock
        x:Name="CountText"
        Grid.Column="2"
        Margin="10,0,0,0"
        VerticalAlignment="Center"
        FontSize="12"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Grid>

    <ScrollViewer
      Grid.Row="2"
      Padding="12,0,12,12"
      HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="Board">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <!--  ряды набираются сами: шире окно — больше кирпичей в ряд  -->
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!--  на «Команде» кирпичи ведут себя как ярлыки в ленте: всё, кроме основной,
                  потушено и не принимает щелчок  -->
            <Grid
              Width="176"
              Height="80"
              Margin="0,0,8,8"
              IsHitTestVisible="{Binding IsTabPickable}"
              Opacity="{Binding TabOpacity}">
              <Button
                x:Name="Brick"
                Click="OnBrickClick"
                Style="{StaticResource BoardBrickStyle}"
                ToolTip="{Binding TabTooltip}">
                <StackPanel Margin="20,0" VerticalAlignment="Center">
                  <TextBlock
                    x:Name="TitleText"
                    HorizontalAlignment="Center"
                    Text="{Binding Title}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />

                  <!--  итог висит до следующей операции, поэтому название остаётся на месте;
                        цвета нет, статус выделен только жирным  -->
                  <StackPanel
                    x:Name="StatusPanel"
                    Margin="-8,1,-8,0"
                    Visibility="Collapsed">
                    <TextBlock
                      HorizontalAlignment="Center"
                      FontSize="11"
                      FontWeight="Bold"
                      Text="{Binding StatusBadge}"
                      TextAlignment="Center"
                      TextTrimming="CharacterEllipsis" />
                    <TextBlock
                      HorizontalAlignment="Center"
                      FontSize="11"
                      FontWeight="Bold"
                      Text="{Binding StatusCaption}"
                      TextTrimming="CharacterEllipsis"
                      Visibility="{Binding StatusCaptionVisibility}" />
                  </StackPanel>

                  <TextBlock
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Opacity="0.75"
                    Text="{Binding TabCounts}"
                    TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Button>

              <Button
                x:Name="Close"
                Margin="0,3,3,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="OnCloseTab"
                Foreground="{Binding Foreground, ElementName=Brick}"
                Style="{StaticResource BrickCloseButtonStyle}"
                ToolTip="Закрыть вкладку" />

              <Button
                Margin="0,0,3,3"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="OnRenameTab"
                Content="&#x270E;"
                Foreground="{Binding Foreground, ElementName=Brick}"
                Style="{StaticResource BrickIconButtonStyle}"
                ToolTip="Переименовать вкладку" />
            </Grid>

            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding HasStatus}" Value="True">
                <Setter TargetName="StatusPanel" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding CanClose}" Value="False">
                <Setter TargetName="Close" Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</ui:FluentWindow>
