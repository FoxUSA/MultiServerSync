<ui:FluentWindow
  x:Class="MultiServerSync.Views.Dialogs.TransferOptionsDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Параметры копирования"
  Width="760"
  MinHeight="0"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      Grid.Row="0"
      Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <!--  тот же блок, что у «Копирования» и «Скачивания»: значения вкладки меняются сразу  -->
    <controls:TransferOptionsPanel
      x:Name="Options"
      Grid.Row="1"
      Margin="22,6,22,0"
      Direction="Both" />

    <Border Grid.Row="2" Padding="22,14">
      <ui:Button
        MinWidth="110"
        HorizontalAlignment="Right"
        Click="OnClose"
        Content="Готово"
        IsCancel="True"
        IsDefault="True" />
    </Border>
  </Grid>
</ui:FluentWindow>
