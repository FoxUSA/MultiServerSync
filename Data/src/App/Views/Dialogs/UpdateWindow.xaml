<ui:FluentWindow
  x:Class="MultiServerSync.Views.Dialogs.UpdateWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Обновление MultiServerSync"
  Width="520"
  MinHeight="0"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ResizeMode="NoResize"
  SizeToContent="Height"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      Grid.Row="0"
      Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="20,4,20,20">
      <TextBlock
        x:Name="HeadText"
        FontSize="18"
        FontWeight="SemiBold"
        TextWrapping="Wrap" />
      <TextBlock
        x:Name="SubText"
        Margin="0,2,0,0"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        TextWrapping="Wrap" />

      <!--  весь путь обновления по шагам: что сделано, что идёт, что впереди  -->
      <Border
        Margin="0,14,0,0"
        Padding="12,8"
        Background="{DynamicResource ControlFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <ItemsControl x:Name="StepList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,2" Opacity="{Binding Opacity}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  FontWeight="Bold"
                  Foreground="{Binding GlyphBrush}"
                  Text="{Binding Glyph}" />
                <TextBlock
                  Grid.Column="1"
                  FontWeight="{Binding Weight}"
                  Text="{Binding Text}"
                  TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <TextBlock
        x:Name="StageText"
        Margin="0,12,0,0"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        TextWrapping="Wrap" />
      <ProgressBar
        x:Name="Bar"
        Height="6"
        Margin="0,6,0,0"
        Maximum="100" />

      <StackPanel
        Margin="0,16,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal">
        <ui:Button
          x:Name="UpdateButton"
          Margin="0,0,8,0"
          Appearance="Primary"
          Click="OnUpdate"
          Content="Обновить"
          Icon="{ui:SymbolIcon ArrowDownload24}" />
        <ui:Button
          x:Name="CloseButton"
          Click="OnClose"
          Content="Закрыть"
          Icon="{ui:SymbolIcon Dismiss24}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
