<ui:FluentWindow
  x:Class="MultiServerSync.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:core="clr-namespace:MultiServerSync.Core"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:pages="clr-namespace:MultiServerSync.Views.Pages"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="MultiServerSync"
  Icon="pack://application:,,,/Assets/app.ico"
  Width="1280"
  Height="820"
  MinWidth="900"
  MinHeight="600"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen">

  <ui:FluentWindow.Resources>
    <!--  ярлык рабочего стола: размер фиксирован, чтобы вкладки не скакали от статусов.
          Зазор везде один — 4, как между страницей и нижней панелью: вбок, между рядами,
          у кнопок слева, до краёв окна и до страницы  -->
    <Style x:Key="WorkspaceTabStyle" TargetType="ListBoxItem">
      <!--  цвет рамки выбранного ярлыка: у вкладок — акцент, у наборов серверов свой  -->
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="Margin" Value="0,2,4,2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <!--  на «Команде» всё, кроме основной, потушено и не принимает щелчок  -->
      <Setter Property="Opacity" Value="{Binding TabOpacity}" />
      <Setter Property="IsHitTestVisible" Value="{Binding IsTabPickable}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <!--  выбранная вкладка — не заливкой, а рамкой: на яркой заливке терялся цвет
                  статуса. Рамка лежит поверх и размер не меняет  -->
            <Grid>
              <Border
                x:Name="Bd"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6" />
              <ContentPresenter Margin="1" />
              <Border
                x:Name="Ring"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="2"
                CornerRadius="6"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
              <!--  рамка работы: зелёная мигает, пока идёт; красная стоит, если кончилось с ошибкой, пока вкладку не увидели.
                    Пока видна, рамку выделения прячет — иначе та просвечивала бы в такт миганию  -->
              <Border
                x:Name="StatusRing"
                BorderBrush="#3FB950"
                BorderThickness="2"
                CornerRadius="6"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextFillColorDisabledBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
              </Trigger>
              <!--  личные команды вкладки копирования — рамка тусклая оранжевая, как у поля команды:
                    видно, что правится не обычная команда, а та, что идёт после копирования  -->
              <DataTrigger Binding="{Binding IsPersonal}" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="#80E07A1F" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="Running">
                <Setter TargetName="StatusRing" Property="Visibility" Value="Visible" />
                <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                <DataTrigger.EnterActions>
                  <BeginStoryboard x:Name="BusyPulse">
                    <Storyboard>
                      <DoubleAnimation
                        AutoReverse="True"
                        RepeatBehavior="Forever"
                        Storyboard.TargetName="StatusRing"
                        Storyboard.TargetProperty="Opacity"
                        From="1"
                        To="0.25"
                        Duration="0:0:0.7" />
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="BusyPulse" />
                </DataTrigger.ExitActions>
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="Failed">
                <Setter TargetName="StatusRing" Property="Visibility" Value="Visible" />
                <Setter TargetName="StatusRing" Property="BorderBrush" Value="#E85C5C" />
                <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="Partial">
                <Setter TargetName="StatusRing" Property="Visibility" Value="Visible" />
                <Setter TargetName="StatusRing" Property="BorderBrush" Value="#E85C5C" />
                <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  ярлык набора серверов: тот же вид, но никогда не тушится  -->
    <Style
      x:Key="ServerSetTabStyle"
      BasedOn="{StaticResource WorkspaceTabStyle}"
      TargetType="ListBoxItem">
      <!--  выбранный набор — в тусклой оранжевой рамке, а выбранная таблица на «Серверах» — в синей  -->
      <Setter Property="BorderBrush" Value="#80E07A1F" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <core:PaneAddressConverter x:Key="PaneAddress" />

    <!--  галочка сервера в боковой панели: мелкая и спокойная, строки идут плотно  -->
    <Style x:Key="PaneCheckStyle" TargetType="CheckBox">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border
              x:Name="Row"
              Padding="2,3"
              Background="Transparent"
              CornerRadius="3">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  квадратик держится первой строки, когда под именем есть заметка  -->
                <Border
                  x:Name="Box"
                  Grid.Column="0"
                  Width="13"
                  Height="13"
                  Margin="0,3,0,0"
                  VerticalAlignment="Top"
                  Background="Transparent"
                  BorderBrush="{DynamicResource TextFillColorTertiaryBrush}"
                  BorderThickness="1"
                  CornerRadius="3">
                  <TextBlock
                    x:Name="Mark"
                    Margin="0,-1,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="Bold"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Text="&#x2713;"
                    Visibility="Collapsed" />
                </Border>
                <ContentPresenter
                  Grid.Column="1"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  TextBlock.Foreground="{TemplateBinding Foreground}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <!--  одиночный выбор на «Команде»: квадратик становится кружком, галочка — точкой  -->
              <DataTrigger Binding="{Binding DataContext.State.PaneSingleSelect, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter TargetName="Box" Property="CornerRadius" Value="7" />
                <Setter TargetName="Mark" Property="Text" Value="&#x25CF;" />
                <Setter TargetName="Mark" Property="FontSize" Value="8" />
                <Setter TargetName="Mark" Property="Margin" Value="0" />
              </DataTrigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
              <!--  «Отметить все», когда отмечена часть: черта вместо галочки  -->
              <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                <Setter TargetName="Mark" Property="Text" Value="&#x2212;" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              </Trigger>
              <!--  у строки сервера подсветка своя, на всю ширину вместе с замком: галочка там уже строки  -->
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="Tag" Value="Hover" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  набор серверов в боковой панели: строка того же кегля, что галочки. Выбранный — как открытый
          раздел: подпись цветом акцента, жирным, и полоска того же цвета сбоку  -->
    <Style x:Key="PaneSetButtonStyle" TargetType="Button">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Row"
              Padding="2,3"
              Background="Transparent"
              CornerRadius="3">
              <StackPanel Orientation="Horizontal">
                <Border
                  x:Name="Bar"
                  Width="3"
                  Height="13"
                  VerticalAlignment="Center"
                  Background="Transparent"
                  CornerRadius="1.5" />
                <TextBlock
                  x:Name="Label"
                  Margin="18,0,0,0"
                  VerticalAlignment="Center"
                  Foreground="{TemplateBinding Foreground}"
                  Text="{TemplateBinding Content}"
                  TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
              <!--  после наведения: выбранный набор под мышью остаётся цветным  -->
              <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  замок в конце строки целевого сервера: под мышью — залитый фон и белый значок  -->
    <!--  замок на плашке сервера: значок белый всегда, под мышью фон синий  -->
    <Style x:Key="ServerTagLockStyle" TargetType="Button">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="8,-2,-5,-2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="Transparent"
              CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2F7FD6" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#256BB8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PaneLockButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="Transparent"
              CornerRadius="4">
              <ContentPresenter
                x:Name="Glyph"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter TargetName="Glyph" Property="TextElement.Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  под замком вкладки: приглушено и не нажимается — «Отметить все», одиночный выбор, наборы  -->
    <Style x:Key="PaneLockedMuteStyle" TargetType="FrameworkElement">
      <Style.Triggers>
        <DataTrigger Binding="{Binding State.ActiveWorkspace.IsPaneLocked}" Value="True">
          <Setter Property="Opacity" Value="0.5" />
          <Setter Property="IsHitTestVisible" Value="False" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!--  мелкие кнопки в углах ярлыка вкладки: появляются только под мышью, и у выбранной тоже,
          в покое ярлык чистый. Скрывают их шаблоны (первая, личная) — это сильнее стиля  -->
    <Style x:Key="TabIconButtonStyle" TargetType="Button">
      <Setter Property="Visibility" Value="Hidden" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4">
              <TextBlock
                x:Name="Glyph"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                FontSize="11"
                Foreground="{TemplateBinding Foreground}"
                Text="{TemplateBinding Content}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style
      x:Key="TabCloseButtonStyle"
      BasedOn="{StaticResource TabIconButtonStyle}"
      TargetType="Button">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4">
              <TextBlock
                x:Name="Glyph"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                FontSize="9"
                Foreground="{TemplateBinding Foreground}"
                Text="&#xE711;" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Свитч «команды после копирования» на ярлыке: нарисован мелко, но ловит щелчок
      всей зоной 32×22, чтобы попадать с первого раза.
    -->
    <Style x:Key="TabSwitchStyle" TargetType="ToggleButton">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent">
              <Border
                x:Name="Track"
                Width="26"
                Height="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                BorderThickness="1"
                CornerRadius="7">
                <Ellipse
                  x:Name="Knob"
                  Width="8"
                  Height="8"
                  Margin="2,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource TextFillColorSecondaryBrush}" />
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <!--  мышь на ярлыке, а не только на самом свитче — он в полную яркость, как и остальные значки.
                    Пока щелчок не принимает (только что появился под мышью) — остаётся серым  -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                  <Condition Binding="{Binding IsHitTestVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </MultiDataTrigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Width" Value="10" />
                <Setter TargetName="Knob" Property="Height" Value="10" />
                <Setter TargetName="Knob" Property="Fill" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  карандаш в правом нижнем углу ярлыка: только под мышью (у выбранной вкладки в покое не виден),
          размером с крестик; под мышью — залитый акцентом фон и белый значок  -->
    <Style x:Key="TabRenameButtonStyle" TargetType="Button">
      <Setter Property="Visibility" Value="Hidden" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="ToolTip" Value="Переименовать (или двойной щелчок по ярлыку)" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="Transparent"
              CornerRadius="4">
              <TextBlock
                x:Name="Glyph"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                FontSize="10"
                Foreground="{TemplateBinding Foreground}"
                Text="&#xE70F;" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!--  стрелка перехода между вкладкой копирования и её личными командами; размером ровно с крестик  -->
    <Style x:Key="TabArrowButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <!--  под мышью — как крестик, только зелёным: на синем белая стрелка терялась. Зелёный тёмный, чтобы белое читалось  -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Foreground" Value="White" />
                <Setter TargetName="Bd" Property="Background" Value="#2EA043" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <!--  мышь на ярлыке — значки в полную яркость: приглушается только название  -->
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!--  вкладки нижней панели: Терминал и Журнал  -->
    <Style x:Key="PanelTabStyle" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border
              x:Name="Bd"
              Padding="{TemplateBinding Padding}"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="0,0,0,2">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  разделы программы в ряд над рабочей областью — те же вкладки, что «Терминал» и «Журнал», крупнее.
          Неоткрытые серые, открытый — значок и подпись цветом акцента: единственная цветная точка ряда  -->
    <Style
      x:Key="SectionTabStyle"
      BasedOn="{StaticResource PanelTabStyle}"
      TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="GroupName" Value="Sections" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border
                x:Name="Bd"
                Padding="{TemplateBinding Padding}"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0,0,0,2">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <!--  рамка работы вкладок раздела, пока человек в другом: как у ярлыков — зелёная мигает, пока идёт,
                    красная стоит, если кончилось ошибкой  -->
              <Border
                x:Name="StatusRing"
                BorderBrush="#3FB950"
                BorderThickness="2"
                CornerRadius="6"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
              <!--  после наведения: открытый раздел под мышью остаётся цветным  -->
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="controls:SectionMark.Status" Value="Running">
                <Setter TargetName="StatusRing" Property="Visibility" Value="Visible" />
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="SectionBusyPulse">
                    <Storyboard>
                      <DoubleAnimation
                        AutoReverse="True"
                        RepeatBehavior="Forever"
                        Storyboard.TargetName="StatusRing"
                        Storyboard.TargetProperty="Opacity"
                        From="1"
                        To="0.25"
                        Duration="0:0:0.7" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="SectionBusyPulse" />
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="controls:SectionMark.Status" Value="Failed">
                <Setter TargetName="StatusRing" Property="Visibility" Value="Visible" />
                <Setter TargetName="StatusRing" Property="BorderBrush" Value="#E85C5C" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  сервер «Проводника» у правого края ряда разделов: плоская подпись, подсветка под мышью  -->
    <Style x:Key="ServerTagStyle" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!--  сервер «Проводника» — как отмеченный сервер в панели слева: тусклая оранжевая рамка
                  на тусклом оранжевом фоне; под мышью и при нажатии фон чуть плотнее  -->
            <Border
              x:Name="Bd"
              Padding="10,5"
              Background="#26E07A1F"
              BorderBrush="#80E07A1F"
              BorderThickness="1"
              CornerRadius="6">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#38E07A1F" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#4AE07A1F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  шапка блока в боковой панели — как «ПАРАМЕТРЫ КОПИРОВАНИЯ» на страницах  -->
    <Style x:Key="PaneHeaderStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--  «IP» и «User» — маленькие метки-переключатели в шапке списка, а не отдельный ряд галочек  -->
    <Style x:Key="PaneChipStyle" TargetType="ToggleButton">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border
              x:Name="Bd"
              Padding="7,1"
              Background="Transparent"
              BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4">
              <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextBlock.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  Ярлыки — кирпичики в ряд; не влезли по ширине окна — переносятся во второй ряд и дальше.
          Ряд — 45 точек: 39 самого ярлыка, рамка 2 и отступы 2 + 2. Высота ряда задана жёстко:
          при масштабе экрана 150% рамка округляется до пикселя, кирпичик выходит на долю точки
          выше, и по своему размеру ряды начинали расходиться.  -->
    <ItemsPanelTemplate x:Key="TabsPanel">
      <controls:SplitTabsPanel RowHeight="45" />
    </ItemsPanelTemplate>

    <!--  ярлык вкладки: название. Пока идёт работа, на его месте — статус; кончилась — снова название.
          Счётчиков нет — они в подсказке. Карандаша нет — места мало, переименование двойным щелчком  -->
    <DataTemplate x:Key="CompactTabTemplate">
      <Grid
        Width="140"
        Height="39"
        ToolTip="{Binding TabTooltip}">
        <!--  название, свитч и стрелки — посередине всего ярлыка  -->
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  название не обрезается никогда: переносится на вторую строку, а не влезло и так —
              ужимается шрифтом. Слово длиннее ярлыка не рвётся, а тоже ужимает  -->
        <StackPanel
          x:Name="Texts"
          Grid.RowSpan="2"
          Margin="20,0,20,0"
          VerticalAlignment="Center">
          <controls:FitTextBlock x:Name="TitleBox" Text="{Binding Title}" />
          <!--  одна строка статуса вместо названия, пока идёт работа: ошибки — «Ошибок N», иначе ход  -->
          <Grid
            x:Name="StatusLine"
            HorizontalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock
              x:Name="BadgeText"
              FontSize="11"
              FontWeight="SemiBold"
              Text="{Binding StatusBadge}"
              TextTrimming="CharacterEllipsis"
              Visibility="Collapsed" />
            <TextBlock
              x:Name="CaptionText"
              FontSize="11"
              FontWeight="SemiBold"
              Text="{Binding StatusCaption}"
              TextTrimming="CharacterEllipsis"
              Visibility="Collapsed" />
          </Grid>
        </StackPanel>

        <!--  копирование: свитч личных команд слева; личная команда — стрелка назад.
              Выключенный свитч не виден и места у названия не берёт: появляется, когда мышь
              задержалась на ярлыке, поверх приглушённого названия  -->
        <ToggleButton
          x:Name="Switch"
          Grid.RowSpan="2"
          Margin="1,0,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Click="OnAfterCopySwitch"
          IsChecked="{Binding AfterCopyEnabled, Mode=TwoWay}"
          Style="{StaticResource TabSwitchStyle}"
          ToolTip="Команды после копирования: выполнить личные команды этой вкладки на серверах, где копирование прошло"
          Visibility="Collapsed" />
        <Button
          x:Name="Back"
          Grid.RowSpan="2"
          Margin="2,0,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Click="OnGoOwner"
          Style="{StaticResource TabArrowButtonStyle}"
          ToolTip="Личные команды вкладки копирования — перейти к ней"
          Visibility="Collapsed">
          <ui:SymbolIcon FontSize="10" Symbol="ArrowLeft24" />
        </Button>

        <!--  справа столбиком: крестик вверху, карандаш внизу; стрелка к личным командам — слева от них, посередине  -->
        <Button
          x:Name="Forward"
          Grid.RowSpan="2"
          Margin="0,0,22,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Click="OnGoPersonal"
          Style="{StaticResource TabArrowButtonStyle}"
          ToolTip="Перейти в личные команды этой вкладки"
          Visibility="Collapsed">
          <ui:SymbolIcon FontSize="10" Symbol="ArrowRight24" />
        </Button>

        <Button
          x:Name="Close"
          Grid.RowSpan="2"
          Margin="0,1,2,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          controls:LockMute.IsOn="{Binding IsContentLocked}"
          Click="OnCloseTab"
          Style="{StaticResource TabCloseButtonStyle}"
          ToolTip="Закрыть вкладку (Ctrl+W)" />
        <Button
          x:Name="RenameButton"
          Grid.RowSpan="2"
          Margin="0,0,2,1"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Click="OnRenameTabClick"
          Style="{StaticResource TabRenameButtonStyle}" />

        <!--  вкладка закреплена за сервером — маленький замок в правом верхнем углу, с отступом от краёв;
              под мышью на его месте крестик, и замок прячется  -->
        <ui:SymbolIcon
          x:Name="LockMark"
          Grid.RowSpan="2"
          Margin="0,5,6,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          FontSize="11"
          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
          IsHitTestVisible="False"
          Symbol="LockClosed24"
          Visibility="Collapsed" />
      </Grid>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsPaneLocked}" Value="True">
          <Setter TargetName="LockMark" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="LockMark" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasStatus}" Value="True">
          <Setter TargetName="BadgeText" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusCaptionVisibility}" Value="Visible">
          <Setter TargetName="BadgeText" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="CaptionText" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <!--  рамка работы (зелёная/красная) — в стиле ярлыка WorkspaceTabStyle  -->
        <DataTrigger Binding="{Binding Status}" Value="Running">
          <Setter TargetName="TitleBox" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="StatusLine" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding CanClose}" Value="False">
          <Setter TargetName="Close" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMain}" Value="True">
          <Setter TargetName="RenameButton" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasPersonal}" Value="True">
          <Setter TargetName="Forward" Property="Visibility" Value="Visible" />
          <Setter TargetName="Texts" Property="Margin" Value="20,0,42,0" />
        </DataTrigger>
        <!--  включённый свитч виден всегда и место себе берёт  -->
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsCopyTab}" Value="True" />
            <Condition Binding="{Binding AfterCopyEnabled}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Switch" Property="Visibility" Value="Visible" />
          <Setter TargetName="Texts" Property="Margin" Value="32,0,22,0" />
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding HasPersonal}" Value="True" />
            <Condition Binding="{Binding AfterCopyEnabled}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Texts" Property="Margin" Value="32,0,42,0" />
        </MultiDataTrigger>
        <!--  выключенный — под мышью, поверх названия; название приглушено, чтобы свитч читался.
              Виден сразу, но первые полсекунды серый и щелчок пропускает к ярлыку: мышь, что
              с разлёта щёлкнула по ярлыку, выбирает вкладку, а не попадает в свитч  -->
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsCopyTab}" Value="True" />
            <Condition Binding="{Binding AfterCopyEnabled}" Value="False" />
            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Switch" Property="Visibility" Value="Visible" />
          <Setter TargetName="Switch" Property="IsHitTestVisible" Value="False" />
          <Setter TargetName="Switch" Property="Opacity" Value="0.5" />
          <Setter TargetName="Texts" Property="Opacity" Value="0.3" />
          <MultiDataTrigger.EnterActions>
            <BeginStoryboard x:Name="SwitchReveal">
              <Storyboard>
                <BooleanAnimationUsingKeyFrames Storyboard.TargetName="Switch" Storyboard.TargetProperty="IsHitTestVisible">
                  <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False" />
                  <DiscreteBooleanKeyFrame KeyTime="0:0:0.5" Value="True" />
                </BooleanAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Switch" Storyboard.TargetProperty="Opacity">
                  <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                  <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                </DoubleAnimationUsingKeyFrames>
              </Storyboard>
            </BeginStoryboard>
          </MultiDataTrigger.EnterActions>
          <MultiDataTrigger.ExitActions>
            <RemoveStoryboard BeginStoryboardName="SwitchReveal" />
          </MultiDataTrigger.ExitActions>
        </MultiDataTrigger>
        <DataTrigger Binding="{Binding IsPersonal}" Value="True">
          <Setter TargetName="RenameButton" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Back" Property="Visibility" Value="Visible" />
          <Setter TargetName="Texts" Property="Margin" Value="26,0,20,0" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!--  краткий ярлык набора серверов: только название  -->
    <DataTemplate x:Key="CompactSetTemplate">
      <Grid
        Width="140"
        Height="39"
        ToolTip="{Binding TabTooltip}">
        <controls:FitTextBlock
          Margin="20,0,20,0"
          VerticalAlignment="Center"
          Text="{Binding Title}" />

        <Button
          x:Name="Close"
          Margin="0,1,2,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Click="OnCloseTab"
          Style="{StaticResource TabCloseButtonStyle}"
          ToolTip="Закрыть набор вместе с его серверами (Ctrl+W)" />
        <Button
          Margin="0,0,2,1"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Click="OnRenameTabClick"
          Style="{StaticResource TabRenameButtonStyle}" />
      </Grid>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding CanClose}" Value="False">
          <Setter TargetName="Close" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition x:Name="PageRow" Height="*" MinHeight="200" />
      <RowDefinition Height="Auto" />
      <RowDefinition x:Name="BottomRow" Height="280" MinHeight="0" />
    </Grid.RowDefinitions>

    <!--  название и версия слева в шапке; справа перед кнопками окна — обновление и страница утилиты  -->
    <ui:TitleBar
      x:Name="Bar"
      Grid.Row="0"
      Title="MultiServerSync"
      Icon="{core:AppIcon}">
      <ui:TitleBar.TrailingContent>
        <StackPanel
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Orientation="Horizontal">
          <!--  появляется только когда на byfox.dev версия свежее установленной  -->
          <ui:Button
            x:Name="UpdateAvailableButton"
            Height="28"
            Margin="0,0,8,0"
            Padding="10,0"
            Appearance="Primary"
            Click="OnUpdateAvailableClick"
            Icon="{ui:SymbolIcon ArrowDownload24}"
            Visibility="Collapsed" />
          <!--  страница утилиты — одним значком, адрес в подсказке  -->
          <ui:Button
            Width="28"
            Height="28"
            Padding="0"
            HorizontalContentAlignment="Center"
            Appearance="Transparent"
            Click="OnOpenProductPage"
            Icon="{ui:SymbolIcon Globe24}"
            ToolTip="https://byfox.dev/multiserversync/ — страница утилиты" />

          <!--  настройки и выход — с рамкой, но без фона, как шарик: фон только под мышью  -->
          <ui:Button
            Height="28"
            Margin="8,0,0,0"
            Padding="10,0"
            Appearance="Transparent"
            Click="OnOpenSettings"
            Content="Настройки"
            Icon="{ui:SymbolIcon Settings24}"
            ToolTip="Настройки программы" />

          <!--  крестик окна прячет программу в трей, выход — только здесь и в меню значка  -->
          <Button
            Height="28"
            Margin="8,0,0,0"
            Padding="10,0"
            Click="OnExitClick"
            Cursor="Hand"
            Focusable="False"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            ToolTip="Выйти из программы. Крестик окна только прячет её в трей">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border
                  x:Name="Bd"
                  Padding="{TemplateBinding Padding}"
                  Background="Transparent"
                  BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4">
                  <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:SymbolIcon
                      x:Name="Glyph"
                      Margin="0,0,6,0"
                      FontSize="16"
                      Foreground="{TemplateBinding Foreground}"
                      Symbol="Power24" />
                    <TextBlock
                      x:Name="Caption"
                      VerticalAlignment="Center"
                      Foreground="{TemplateBinding Foreground}"
                      Text="Выход" />
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#C42B1C" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                    <Setter TargetName="Caption" Property="Foreground" Value="White" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#A32417" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </ui:TitleBar.TrailingContent>
    </ui:TitleBar>

    <!--  У каждого раздела свои вкладки: на «Серверах» — наборы серверов, в остальных — вкладки
          раздела. В «Настройках» ряда нет совсем. Ярлыки не влезли по ширине — встают вторым рядом,
          ряд вкладок растёт вниз, а страница и нижняя панель ужимаются поровну (из кода).  -->
    <!--  мелкий жирный текст ярлыков («9 из 9») в режиме Ideal размывается сглаживанием;
          Display рисует его по пиксельной сетке, округление раскладки не ставит строку между пикселями  -->
    <Border
      x:Name="TabStripArea"
      Grid.Row="1"
      Padding="5.34,2,5.34,2"
      Background="Transparent"
      PreviewMouseLeftButtonDown="OnTabStripAreaDown"
      SizeChanged="OnTabStripAreaSized"
      TextOptions.TextFormattingMode="Display"
      UseLayoutRounding="True"
      Visibility="{Binding State.ShowsTabStrip, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  «+» и под ним архив (щелчок переключает ленту на архивные вкладки и обратно):
              вместе ровно в высоту ярлыков, сколько бы рядов их ни было;
              отступы те же, что у ярлыка. У наборов серверов архива нет — там «+» во всю высоту  -->
        <Grid
          x:Name="TabButtons"
          Grid.Column="0"
          Width="44"
          Margin="0,2,4,2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="ArchiveRow" Height="*" />
          </Grid.RowDefinitions>

          <ui:Button
            Grid.Row="0"
            MinHeight="0"
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            Click="OnAddTab"
            ToolTip="Новая вкладка (Ctrl+T или двойной щелчок по пустому месту ленты)">
            <ui:Button.Icon>
              <ui:SymbolIcon FontSize="14" Symbol="Add24" />
            </ui:Button.Icon>
          </ui:Button>

          <ui:Button
            x:Name="ArchiveButton"
            Grid.Row="1"
            MinHeight="0"
            Margin="0,2,0,0"
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            Click="OnArchiveClick"
            RenderTransformOrigin="0.5,0.5"
            >
            <ui:Button.RenderTransform>
              <ScaleTransform />
            </ui:Button.RenderTransform>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon
                x:Name="ArchiveIcon"
                FontSize="14"
                Symbol="Archive24" />
              <TextBlock
                x:Name="ArchiveCount"
                Margin="3,0,0,0"
                VerticalAlignment="Center"
                FontSize="10"
                FontWeight="SemiBold" />
            </StackPanel>
          </ui:Button>
        </Grid>

        <!--  наборы серверов: новый — пустой, закрытие уносит его серверы  -->
        <ListBox
          x:Name="SetStrip"
          Grid.Column="1"
          Padding="0"
          Background="Transparent"
          BorderThickness="0"
          ItemContainerStyle="{StaticResource ServerSetTabStyle}"
          ItemTemplate="{StaticResource CompactSetTemplate}"
          ItemsPanel="{StaticResource TabsPanel}"
          MouseDoubleClick="OnRenameTab"
          PreviewMouseRightButtonDown="OnTabStripRightDown"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Disabled"
          SelectionChanged="OnSetSelected"
          Visibility="{Binding State.ShowsServerSetTabs, Converter={StaticResource BoolToVis}}" />

        <!--  вкладки раздела  -->
        <ListBox
          x:Name="TabStrip"
          Grid.Column="1"
          Padding="0"
          Background="Transparent"
          BorderThickness="0"
          ItemContainerStyle="{StaticResource WorkspaceTabStyle}"
          ItemTemplate="{StaticResource CompactTabTemplate}"
          ItemsPanel="{StaticResource TabsPanel}"
          MouseDoubleClick="OnRenameTab"
          PreviewMouseRightButtonDown="OnTabStripRightDown"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Disabled"
          SelectionChanged="OnTabSelected"
          Visibility="{Binding State.ShowsWorkspaceTabs, Converter={StaticResource BoolToVis}}" />
      </Grid>
    </Border>

    <!--  разделы — своим рядом между вкладками и рабочей областью: боковая панель остаётся
          серверам. Двойной щелчок по разделу возвращает на его первую вкладку  -->
    <!--  подложка на ступень светлее карточек (в светлой теме — чуть темнее): ряд разделов
          не сливается с рабочими карточками под ним  -->
    <Border
      Grid.Row="2"
      Margin="5.34,0,5.34,4"
      Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
      BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="8">
      <Border
        Padding="6,4"
        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
        CornerRadius="7"
        PreviewMouseLeftButtonDown="OnSectionRowDown">
      <DockPanel>
      <!--
        «Проводник»: сервер правой панели — у правого края ряда, как раз над ней. Название, логин,
        адрес; стрелка вниз — подпись про блок ниже. Щелчок — список серверов, как значок у адреса
      -->
      <Button
        x:Name="ExplorerServerTag"
        Click="OnExplorerServerTag"
        DockPanel.Dock="Right"
        Style="{StaticResource ServerTagStyle}"
        ToolTip="Сервер правой панели — щелчок открывает список серверов"
        Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <!--  тот же значок, что у сервера в панели «Проводника»  -->
          <Image
            x:Name="ExplorerServerIcon"
            Width="16"
            Height="16"
            Margin="0,0,8,0"
            VerticalAlignment="Center" />
          <TextBlock
            x:Name="ExplorerServerName"
            VerticalAlignment="Center"
            FontWeight="SemiBold" />
          <TextBlock
            x:Name="ExplorerServerUser"
            Margin="4,0,0,0"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock
            x:Name="ExplorerServerAddress"
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            FontFamily="Consolas"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <ui:SymbolIcon
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Symbol="ArrowDown24" />
          <Button
            x:Name="ExplorerServerLock"
            Click="OnExplorerServerLock"
            Style="{StaticResource ServerTagLockStyle}">
            <ui:SymbolIcon
              x:Name="ExplorerServerLockIcon"
              FontSize="13"
              Foreground="White"
              Symbol="LockOpen24" />
          </Button>
        </StackPanel>
      </Button>

      <!--  кнопки переставляются мышью, порядок запоминается  -->
      <StackPanel x:Name="SectionBar" Orientation="Horizontal">
        <RadioButton
          x:Name="ServersSection"
          Click="OnSectionClick"
          Style="{StaticResource SectionTabStyle}"
          Tag="{x:Type pages:ServersPage}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="Server24" />
            <TextBlock Text="Серверы" />
          </StackPanel>
        </RadioButton>
        <RadioButton
          x:Name="ExplorerSection"
          Click="OnSectionClick"
          PreviewMouseLeftButtonDown="OnNavItemMouseDown"
          Style="{StaticResource SectionTabStyle}"
          Tag="{x:Type pages:ExplorerPage}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="Folder24" />
            <TextBlock Text="Проводник" />
          </StackPanel>
        </RadioButton>
        <RadioButton
          x:Name="CommandSection"
          Click="OnSectionClick"
          PreviewMouseLeftButtonDown="OnNavItemMouseDown"
          Style="{StaticResource SectionTabStyle}"
          Tag="{x:Type pages:CommandPage}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="WindowConsole20" />
            <TextBlock Text="Команда" />
          </StackPanel>
        </RadioButton>
        <RadioButton
          x:Name="FilesSection"
          Click="OnSectionClick"
          PreviewMouseLeftButtonDown="OnNavItemMouseDown"
          Style="{StaticResource SectionTabStyle}"
          Tag="{x:Type pages:FilesPage}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="ArrowUpload24" />
            <TextBlock Text="Копирование" />
          </StackPanel>
        </RadioButton>
        <RadioButton
          x:Name="DownloadSection"
          Click="OnSectionClick"
          PreviewMouseLeftButtonDown="OnNavItemMouseDown"
          Style="{StaticResource SectionTabStyle}"
          Tag="{x:Type pages:DownloadPage}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="ArrowDownload24" />
            <TextBlock Text="Скачивание" />
          </StackPanel>
        </RadioButton>
        <!--  вернуть закрытую или переименованную вкладку этого раздела: виден, только пока есть что  -->
        <Button
          x:Name="TabActionButton"
          Margin="12,0,0,0"
          Click="OnUndoTabAction"
          Style="{StaticResource UndoButtonStyle}"
          Visibility="Collapsed">
          <ui:SymbolIcon FontSize="16" Symbol="ArrowUndo24" />
        </Button>
      </StackPanel>
      </DockPanel>
      </Border>
    </Border>

    <!--  рабочая область: слева целевые серверы своей карточкой, справа страница раздела.
          Зазоры по 4: между карточкой и страницей, под рядом разделов. От края окна 5,34 (ровно 8 пикселей на 150%) — один
          съедает рамка окна, на глаз выходит те же 4  -->
    <Grid Grid.Row="3" Margin="5.34,0,5.34,0">
      <!--  в «Проводнике» карточки серверов нет: всё место — двум панелям файлов  -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PaneColumn" Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border
        x:Name="PaneCard"
        Grid.Column="0"
        Margin="0,0,4,0"
        Padding="12"
        Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!--  что это и из какого набора; справа — что подписывать под каждым сервером  -->
          <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Style="{StaticResource PaneHeaderStyle}" Text="ЦЕЛЕВЫЕ СЕРВЕРА" />
            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding State.PaneSetTitle}"
                TextTrimming="CharacterEllipsis"
                ToolTip="Набор серверов этой вкладки — у каждой вкладки свой" />

              <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ToggleButton
                  Content="IP"
                  IsChecked="{Binding State.PaneShowIp, Mode=TwoWay}"
                  Style="{StaticResource PaneChipStyle}"
                  ToolTip="Под каждым сервером — его адрес" />
                <ToggleButton
                  Margin="4,0,0,0"
                  Content="User"
                  IsChecked="{Binding State.PaneShowUser, Mode=TwoWay}"
                  Style="{StaticResource PaneChipStyle}"
                  ToolTip="Под каждым сервером — имя пользователя, под которым идёт подключение" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <!--  на «Команде» и «Копировании»: один сервер за раз, чтобы случайно не запустить
                на нескольких. Свой у каждого набора серверов и у каждого из двух разделов  -->
          <!--  под замком приглушён рамкой: свой стиль у самого свитча снял бы с него тему  -->
          <Border
            Grid.Row="1"
            Margin="0,0,0,4"
            Style="{StaticResource PaneLockedMuteStyle}"
            Visibility="{Binding State.ShowsSingleSelectSwitch, Converter={StaticResource BoolToVis}}">
            <ui:ToggleSwitch
              Content="Одиночный выбор"
              FontSize="12"
              IsChecked="{Binding State.SingleSelectHere, Mode=TwoWay}"
              ToolTip="Включено — отметить можно только один сервер: выбор другого снимает прежний. У команд и у копирования свой, запоминается для каждого набора серверов и отдельно для «Всех»" />
          </Border>

          <!--  прокрутка выходит на 4 точки в поле карточки, а список возвращается на место: рамка отмеченного
                сервера шире строки на те же 4 с каждого бока, и прокрутка её больше не обрезает  -->
          <ScrollViewer
            x:Name="PaneScroller"
            Grid.Row="2"
            Margin="-4,0,-4,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,4,0">
              <!--  «Отметить все» — первой строкой, как галочка в шапке таблицы на «Серверах»; под ней черта.
                    В одиночном выборе её нет  -->
              <Border
                Margin="0,0,0,2"
                Padding="0,0,0,2"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Style="{StaticResource PaneLockedMuteStyle}"
                Visibility="{Binding State.ShowsToggleAllServers, Converter={StaticResource BoolToVis}}">
                <CheckBox
                  Content="Отметить все"
                  IsChecked="{Binding State.ActiveWorkspace.PaneAllChecked, Mode=TwoWay}"
                  Style="{StaticResource PaneCheckStyle}"
                  Tag="Hover"
                  ToolTip="Отметить или снять все серверы в списке этой вкладки. Если отмечена часть — отмечает все" />
              </Border>

              <!--  серверы переставляются мышью: порядок общий, его же показывают «Серверы»  -->
              <ItemsControl x:Name="PaneServerList" ItemsSource="{Binding State.ActiveWorkspace.Servers}">
                <ItemsControl.ItemTemplate>
                    <!--  между серверами черта: где кончается один и начинается другой; по 2 над и под ней  -->
                    <DataTemplate>
                      <Border
                        x:Name="Item"
                        Margin="0,2,0,0"
                        Padding="0,2,0,0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <!--  отмеченный сервер — в тусклой оранжевой рамке на тусклом оранжевом фоне, шрифт на пункт
                              крупнее: среди многих серверов он виден сразу. Рамка выходит на 4 точки в поле карточки,
                              чтобы галочка и название не сдвигались вбок; сверху и снизу строка раздвигается, чтобы
                              рамка не налезала на черты соседей  -->
                        <Border
                          x:Name="Pick"
                          BorderBrush="Transparent"
                          BorderThickness="1"
                          CornerRadius="6">
                        <!--  замок — в конце строки: под мышью открытый, у закреплённого сервера закрытый всегда  -->
                        <DockPanel>
                        <Button
                          x:Name="Lock"
                          Click="OnPaneLockClick"
                          DockPanel.Dock="Right"
                          Style="{StaticResource PaneLockButtonStyle}"
                          ToolTip="{Binding DataContext.State.ActiveWorkspace.LockTip, RelativeSource={RelativeSource AncestorType=Window}}"
                          Visibility="Hidden">
                          <ui:SymbolIcon
                            x:Name="LockIcon"
                            FontSize="13"
                            Symbol="LockOpen24" />
                        </Button>
                        <CheckBox
                          x:Name="Check"
                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource PaneCheckStyle}"
                          ToolTip="{Binding Server.Display}">
                          <StackPanel>
                            <TextBlock Text="{Binding Server.PaneLabel}" TextTrimming="CharacterEllipsis" />
                            <!--  адрес и заметка — от левого края галочки, одной линией: это подписи к серверу  -->
                            <TextBlock
                              Margin="-21,1,0,0"
                              FontSize="11"
                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                              TextTrimming="CharacterEllipsis">
                              <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource PaneAddress}">
                                  <Binding Path="Server.User" />
                                  <Binding Path="Server.Host" />
                                  <Binding Path="DataContext.State.PaneShowUser" RelativeSource="{RelativeSource AncestorType=Window}" />
                                  <Binding Path="DataContext.State.PaneShowIp" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                              </TextBlock.Text>
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock
                              Margin="-21,1,0,0"
                              FontSize="11"
                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                              Text="{Binding Server.NotesLine}"
                              TextTrimming="CharacterEllipsis"
                              Visibility="{Binding Server.PaneNotesVisible, Converter={StaticResource BoolToVis}}" />
                          </StackPanel>
                        </CheckBox>
                        </DockPanel>
                        </Border>
                      </Border>
                      <DataTemplate.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsMouseOver, ElementName=Item}" Value="True" />
                            <Condition Binding="{Binding DataContext.State.ActiveWorkspace.IsPaneLocked, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                          </MultiDataTrigger.Conditions>
                          <Setter TargetName="Lock" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding DataContext.State.ActiveWorkspace.IsPaneLocked, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                          <Setter TargetName="Check" Property="IsHitTestVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                          <Setter TargetName="Lock" Property="Visibility" Value="Visible" />
                          <Setter TargetName="LockIcon" Property="Symbol" Value="LockClosed24" />
                          <Setter TargetName="Lock" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                          <Setter TargetName="Lock" Property="ToolTip" Value="Вкладка закреплена за этим сервером — щелчок снимает замок" />
                        </DataTrigger>
                        <!--  строка под мышью или в фокусе — замок белый, открытый он или закрытый, как в списке у подписи сервера.
                              После триггера замка: перебивает цвет акцента у закрытого  -->
                        <Trigger SourceName="Item" Property="IsMouseOver" Value="True">
                          <Setter TargetName="Lock" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger SourceName="Item" Property="IsKeyboardFocusWithin" Value="True">
                          <Setter TargetName="Lock" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                          <Setter TargetName="Item" Property="Opacity" Value="0.5" />
                        </DataTrigger>
                        <!--  под мышью — прямоугольник той же ширины и с теми же углами, что у отмеченного, вместе с замком.
                              По высоте и по тексту ничего не сдвигается: сбоку отступ возвращает то, что забрало поле  -->
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsMouseOver, ElementName=Item}" Value="True" />
                            <Condition Binding="{Binding DataContext.State.ActiveWorkspace.IsPaneLocked, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                          </MultiDataTrigger.Conditions>
                          <Setter TargetName="Pick" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                          <Setter TargetName="Pick" Property="Margin" Value="-4,0,-4,0" />
                          <Setter TargetName="Pick" Property="Padding" Value="4,0,4,0" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected}" Value="True" />
                            <Condition Binding="{Binding DataContext.State.PaneHighlightsPicks, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                          </MultiDataTrigger.Conditions>
                          <Setter TargetName="Pick" Property="Background" Value="#26E07A1F" />
                          <Setter TargetName="Pick" Property="BorderBrush" Value="#80E07A1F" />
                          <Setter TargetName="Pick" Property="Margin" Value="-4,2,-4,2" />
                          <Setter TargetName="Pick" Property="Padding" Value="3,3,3,3" />
                          <Setter TargetName="Check" Property="FontSize" Value="14" />
                        </MultiDataTrigger>
                        <!--  отмеченный под мышью — фон чуть плотнее, как у плашки сервера  -->
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected}" Value="True" />
                            <Condition Binding="{Binding DataContext.State.PaneHighlightsPicks, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                            <Condition Binding="{Binding IsMouseOver, ElementName=Item}" Value="True" />
                            <Condition Binding="{Binding DataContext.State.ActiveWorkspace.IsPaneLocked, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                          </MultiDataTrigger.Conditions>
                          <Setter TargetName="Pick" Property="Background" Value="#38E07A1F" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                          <Setter TargetName="Item" Property="Margin" Value="0" />
                          <Setter TargetName="Item" Property="Padding" Value="0" />
                          <Setter TargetName="Item" Property="BorderThickness" Value="0" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock
                Margin="2,4,0,0"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="серверов нет — добавьте на вкладке «Серверы»"
                TextWrapping="Wrap"
                Visibility="{Binding State.ActiveWorkspace.PaneEmptyHintVisibility}" />
            </StackPanel>
          </ScrollViewer>

          <!--  низ карточки: умный режим и наборы серверов. Наборы закреплены внизу:
                смена набора меняет длину списка выше, а сами наборы под мышью не прыгают  -->
          <Border Grid.Row="3" Margin="0,4,0,0">
            <StackPanel>
                <ui:ToggleSwitch
                  x:Name="SmartSwitch"
                  Click="OnSmartModeChanged"
                  Content="Умный режим"
                  FontSize="13"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  ToolTipService.ShowDuration="30000">
                  <ui:ToggleSwitch.ToolTip>
                    <TextBlock MaxWidth="340" TextWrapping="Wrap">
                      Спросит перед запуском, если команду или копирование с этой вкладки
                      вы обычно делаете на другом сервере. Безопасные команды не проверяются.
                    </TextBlock>
                  </ui:ToggleSwitch.ToolTip>
                </ui:ToggleSwitch>

              <!--  черта под умным режимом: он отдельно, наборы отдельно  -->
              <Border
                Margin="0,4,0,0"
                Padding="0,4,0,0"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding State.ShowsSetSwitcher, Converter={StaticResource BoolToVis}}">
              <StackPanel Style="{StaticResource PaneLockedMuteStyle}">
                <TextBlock
                  Margin="0,0,0,2"
                  Style="{StaticResource PaneHeaderStyle}"
                  Text="НАБОРЫ СЕРВЕРОВ" />
                  <!--  «Все»: в панели серверы всех наборов разом  -->
                  <Button
                    Click="OnPickAllSets"
                    Content="Все"
                    ToolTip="Серверы всех наборов разом: отмечать и запускать можно на любых">
                    <Button.Style>
                      <Style BasedOn="{StaticResource PaneSetButtonStyle}" TargetType="Button">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding State.PaneAllSets}" Value="True">
                            <Setter Property="Tag" Value="Active" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <ItemsControl ItemsSource="{Binding State.ServerSets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button
                          x:Name="Pick"
                          Click="OnPickServerSet"
                          Content="{Binding Title}"
                          Style="{StaticResource PaneSetButtonStyle}"
                          ToolTip="{Binding TabTooltip}" />
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsPanePick}" Value="True">
                            <Setter TargetName="Pick" Property="Tag" Value="Active" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

              </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!--  страница раздела — такой же карточкой, как серверы слева и нижняя панель.
            Страницы живут по одной на раздел и переключаются рядом разделов над ними  -->
      <Border
        Grid.Column="1"
        Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Frame
          x:Name="PageFrame"
          Focusable="False"
          JournalOwnership="OwnsJournal"
          NavigationUIVisibility="Hidden" />
      </Border>
    </Grid>

    <!--  что сделано по последнему нажатию — под кнопкой, а без кнопки посередине окна; гаснет само.
          Лежит поверх всех рядов и раскладку не раздвигает, щелчки проходят сквозь неё  -->
    <controls:ActionToast
      x:Name="Toast"
      Grid.RowSpan="9"
      Panel.ZIndex="1000"
      HorizontalAlignment="Left"
      VerticalAlignment="Top" />

    <GridSplitter
      x:Name="BottomSplitter"
      Grid.Row="4"
      Height="4"
      HorizontalAlignment="Stretch"
      Background="Transparent"
      ResizeBehavior="PreviousAndNext"
      ResizeDirection="Rows" />

    <!--  нижняя панель: слева таблица серверов, справа вывод; вторая вкладка — журнал.
          Карточка с зазором 5 от стен окна: один съедает рамка окна, на глаз те же 4, что между страницей и панелью  -->
    <!--  мелкий текст терминала и журнала — по пиксельной сетке, как на ярлыках вкладок: в режиме
          Ideal подписи 11 точек выходили размытыми, а соседние — разными по резкости  -->
    <Border
      x:Name="BottomPanel"
      Grid.Row="5"
      Margin="5.34,0,5.34,5.34"
      TextOptions.TextFormattingMode="Display"
      UseLayoutRounding="True"
      Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
      BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="8">
      <!--  кнопки терминала и журнала — в одной строке с их ярлыками, правее них: отдельной
            строки под ярлыками нет, под таблицу и вывод остаётся больше места  -->
      <Grid Margin="12">
        <Grid>
          <controls:ResultsView x:Name="Terminal" DataContext="{Binding State.TerminalOwner.ResultsBatch}" />
          <controls:LogPanel x:Name="Log" Visibility="Collapsed" />
        </Grid>

        <StackPanel
          x:Name="BottomTabs"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Orientation="Horizontal"
          SizeChanged="OnBottomTabsSized">
          <RadioButton
            x:Name="TerminalTab"
            Checked="OnBottomTabChanged"
            Content="Терминал"
            IsChecked="True"
            Style="{StaticResource PanelTabStyle}" />
          <RadioButton
            x:Name="JournalTab"
            Checked="OnBottomTabChanged"
            Content="Журнал"
            Style="{StaticResource PanelTabStyle}" />

          <!--  что из разовых действий открытого раздела писать в терминал и журнал; у каждого раздела своё  -->
          <Button
            x:Name="OutputPrefsButton"
            Margin="2,0,0,0"
            Click="OnOutputPrefs"
            Style="{StaticResource RowPathButtonStyle}"
            ToolTip="Что писать в терминал и журнал в этом разделе">
            <ui:SymbolIcon FontSize="15" Symbol="Settings24" />
          </Button>
          <Popup
            x:Name="OutputPrefsPopup"
            AllowsTransparency="True"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=OutputPrefsButton}"
            StaysOpen="False">
            <Border
              Margin="0,4,8,8"
              Padding="14,12"
              Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
              BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8">
              <Border.Effect>
                <DropShadowEffect
                  BlurRadius="12"
                  Opacity="0.25"
                  ShadowDepth="2" />
              </Border.Effect>
              <StackPanel>
                <TextBlock
                  x:Name="OutputPrefsTitle"
                  Margin="0,0,0,8"
                  FontSize="11"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="16,0,0,4"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Терминал" />
                  <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="16,0,0,4"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Журнал" />

                  <!--  строки, которых в разделе не бывает, прячутся: в «Команде» остаётся одна «Программа»  -->
                  <TextBlock
                    x:Name="ServerRowLabel"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="Сервер"
                    ToolTip="Действия на сервере: создать, удалить, переименовать, права, правка файла" />
                  <CheckBox x:Name="ServerTerminalBox" Grid.Row="1" Grid.Column="1" Margin="16,2,0,2" HorizontalAlignment="Center" Click="OnOutputPrefChanged" />
                  <CheckBox x:Name="ServerJournalBox" Grid.Row="1" Grid.Column="2" Margin="16,2,0,2" HorizontalAlignment="Center" Click="OnOutputPrefChanged" />

                  <TextBlock
                    x:Name="ComputerRowLabel"
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="Компьютер"
                    ToolTip="Действия с файлами на этом компьютере и строки списка копирования" />
                  <CheckBox x:Name="ComputerTerminalBox" Grid.Row="2" Grid.Column="1" Margin="16,2,0,2" HorizontalAlignment="Center" Click="OnOutputPrefChanged" />
                  <CheckBox x:Name="ComputerJournalBox" Grid.Row="2" Grid.Column="2" Margin="16,2,0,2" HorizontalAlignment="Center" Click="OnOutputPrefChanged" />

                  <TextBlock
                    x:Name="ProgramRowLabel"
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="Программа"
                    ToolTip="Списки, вкладки, наборы, исключения, окна команд, вставка из буфера" />
                  <CheckBox x:Name="ProgramTerminalBox" Grid.Row="3" Grid.Column="1" Margin="16,2,0,2" HorizontalAlignment="Center" Click="OnOutputPrefChanged" />
                  <CheckBox x:Name="ProgramJournalBox" Grid.Row="3" Grid.Column="2" Margin="16,2,0,2" HorizontalAlignment="Center" Click="OnOutputPrefChanged" />
                </Grid>
                <TextBlock
                  MaxWidth="260"
                  Margin="0,10,0,0"
                  FontSize="11"
                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                  Text="Ошибки и предупреждения пишутся всегда. Запуски по «Выполнить» это не трогает."
                  TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Popup>
        </StackPanel>
      </Grid>
    </Border>

    <!--  слой для полёта ярлыка в архив: поверх всего окна, мышь сквозь него  -->
    <Canvas
      x:Name="FxLayer"
      Grid.RowSpan="6"
      Panel.ZIndex="1000"
      IsHitTestVisible="False" />
  </Grid>
</ui:FluentWindow>
