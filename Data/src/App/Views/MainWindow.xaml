<ui:FluentWindow
  x:Class="MultiServerSync.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:core="clr-namespace:MultiServerSync.Core"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:pages="clr-namespace:MultiServerSync.Views.Pages"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="MultiServerSync"
  Icon="pack://application:,,,/Assets/app.ico"
  Width="1280"
  Height="820"
  MinWidth="900"
  MinHeight="600"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen">

  <ui:FluentWindow.Resources>
    <!--  ярлык рабочего стола: размер фиксирован, чтобы вкладки не скакали от статусов.
          Зазор везде один — 4, как между страницей и нижней панелью: вбок, между рядами,
          у кнопок слева, до краёв окна и до страницы  -->
    <Style x:Key="WorkspaceTabStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,2,4,2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <!--  на «Команде» всё, кроме основной, потушено и не принимает щелчок  -->
      <Setter Property="Opacity" Value="{Binding TabOpacity}" />
      <Setter Property="IsHitTestVisible" Value="{Binding IsTabPickable}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <!--  выбранная вкладка — не заливкой, а рамкой: на яркой заливке терялись огонёк
                  работы, полоска команд и цвет статуса. Рамка лежит поверх и размер не меняет  -->
            <Grid>
              <Border
                x:Name="Bd"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6" />
              <ContentPresenter Margin="1" />
              <Border
                x:Name="Ring"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="6"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextFillColorDisabledBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  ярлык набора серверов: тот же вид, но никогда не тушится  -->
    <Style
      x:Key="ServerSetTabStyle"
      BasedOn="{StaticResource WorkspaceTabStyle}"
      TargetType="ListBoxItem">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <core:PaneAddressConverter x:Key="PaneAddress" />

    <!--  галочка сервера в боковой панели: мелкая и спокойная, строки идут плотно  -->
    <Style x:Key="PaneCheckStyle" TargetType="CheckBox">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border
              x:Name="Row"
              Padding="2,3"
              Background="Transparent"
              CornerRadius="3">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  квадратик держится первой строки, когда под именем есть заметка  -->
                <Border
                  x:Name="Box"
                  Grid.Column="0"
                  Width="13"
                  Height="13"
                  Margin="0,3,0,0"
                  VerticalAlignment="Top"
                  Background="Transparent"
                  BorderBrush="{DynamicResource TextFillColorTertiaryBrush}"
                  BorderThickness="1"
                  CornerRadius="3">
                  <TextBlock
                    x:Name="Mark"
                    Margin="0,-1,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="Bold"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Text="&#x2713;"
                    Visibility="Collapsed" />
                </Border>
                <ContentPresenter
                  Grid.Column="1"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  TextBlock.Foreground="{TemplateBinding Foreground}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <!--  одиночный выбор на «Команде»: квадратик становится кружком, галочка — точкой  -->
              <DataTrigger Binding="{Binding DataContext.State.PaneSingleSelect, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter TargetName="Box" Property="CornerRadius" Value="7" />
                <Setter TargetName="Mark" Property="Text" Value="&#x25CF;" />
                <Setter TargetName="Mark" Property="FontSize" Value="8" />
                <Setter TargetName="Mark" Property="Margin" Value="0" />
              </DataTrigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
              <!--  «Отметить все», когда отмечена часть: черта вместо галочки  -->
              <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                <Setter TargetName="Mark" Property="Text" Value="&#x2212;" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  набор серверов в боковой панели: строка того же кегля, что галочки; выбранный — с полоской и жирным  -->
    <Style x:Key="PaneSetButtonStyle" TargetType="Button">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Row"
              Padding="2,3"
              Background="Transparent"
              CornerRadius="3">
              <StackPanel Orientation="Horizontal">
                <Border
                  x:Name="Bar"
                  Width="3"
                  Height="13"
                  VerticalAlignment="Center"
                  Background="Transparent"
                  CornerRadius="1.5" />
                <TextBlock
                  x:Name="Label"
                  Margin="18,0,0,0"
                  VerticalAlignment="Center"
                  Foreground="{TemplateBinding Foreground}"
                  Text="{TemplateBinding Content}"
                  TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  мелкие кнопки в углах ярлыка вкладки: появляются под мышью и у выбранной вкладки,
          в покое ярлык чистый. Скрывают их шаблоны (первая, личная) — это сильнее стиля  -->
    <Style x:Key="TabIconButtonStyle" TargetType="Button">
      <Setter Property="Visibility" Value="Hidden" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4">
              <TextBlock
                x:Name="Glyph"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                FontSize="11"
                Foreground="{TemplateBinding Foreground}"
                Text="{TemplateBinding Content}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style
      x:Key="TabCloseButtonStyle"
      BasedOn="{StaticResource TabIconButtonStyle}"
      TargetType="Button">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4">
              <TextBlock
                x:Name="Glyph"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                FontSize="9"
                Foreground="{TemplateBinding Foreground}"
                Text="&#xE711;" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Свитч «команды после копирования» на ярлыке: нарисован мелко, но ловит щелчок
      всей зоной 32×22, чтобы попадать с первого раза.
    -->
    <Style x:Key="TabSwitchStyle" TargetType="ToggleButton">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent">
              <Border
                x:Name="Track"
                Width="26"
                Height="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                BorderThickness="1"
                CornerRadius="7">
                <Ellipse
                  x:Name="Knob"
                  Width="8"
                  Height="8"
                  Margin="2,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource TextFillColorSecondaryBrush}" />
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Width" Value="10" />
                <Setter TargetName="Knob" Property="Height" Value="10" />
                <Setter TargetName="Knob" Property="Fill" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  стрелка перехода между вкладкой копирования и её личными командами; размером ровно с крестик  -->
    <Style x:Key="TabArrowButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <!--  под мышью — как крестик, только зелёным: на синем белая стрелка терялась. Зелёный тёмный, чтобы белое читалось  -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Foreground" Value="White" />
                <Setter TargetName="Bd" Property="Background" Value="#2EA043" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Полоска личных команд на ярлыке копирования: сколько окон — столько ровных отрезков.
      Серый — ещё не дошло, синий с пульсом — идёт, зелёный — прошло, красный — встало.
      Серый — цветом третичного текста: бледная обводка элементов на ярлыке была не видна.
      Синий свой, не акцентный: акцентом обведена выбранная вкладка, и полоска с ней сливалась.
    -->
    <DataTemplate x:Key="ChainSegmentTemplate">
      <Border
        x:Name="Seg"
        Margin="1,0"
        Background="{DynamicResource TextFillColorTertiaryBrush}"
        CornerRadius="2">
        <TextBlock
          x:Name="Num"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontSize="8"
          FontWeight="Bold"
          Foreground="White"
          Text="{Binding Number}"
          Visibility="Collapsed" />
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Running">
          <Setter TargetName="Seg" Property="Background" Value="#3B8EEA" />
          <Setter TargetName="Num" Property="Visibility" Value="Visible" />
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="SegPulse">
              <Storyboard>
                <DoubleAnimation
                  AutoReverse="True"
                  RepeatBehavior="Forever"
                  Storyboard.TargetName="Seg"
                  Storyboard.TargetProperty="Opacity"
                  From="1"
                  To="0.45"
                  Duration="0:0:0.6" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="SegPulse" />
          </DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Ok">
          <Setter TargetName="Seg" Property="Background" Value="#3FB950" />
          <Setter TargetName="Num" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Failed">
          <Setter TargetName="Seg" Property="Background" Value="#E0574A" />
          <Setter TargetName="Num" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Skipped">
          <Setter TargetName="Seg" Property="Opacity" Value="0.4" />
        </DataTrigger>
        <!--  последним: перекрывает показ цифр из триггеров выше  -->
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="NoNumbers">
          <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!--  вкладки нижней панели: Терминал и Журнал  -->
    <Style x:Key="PanelTabStyle" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border
              x:Name="Bd"
              Padding="{TemplateBinding Padding}"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="0,0,0,2">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  разделы программы в ряд над рабочей областью — те же вкладки, что «Терминал» и «Журнал», крупнее  -->
    <Style
      x:Key="SectionTabStyle"
      BasedOn="{StaticResource PanelTabStyle}"
      TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="GroupName" Value="Sections" />
    </Style>

    <!--  шапка блока в боковой панели — как «ПАРАМЕТРЫ КОПИРОВАНИЯ» на страницах  -->
    <Style x:Key="PaneHeaderStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--  «IP» и «User» — маленькие метки-переключатели в шапке списка, а не отдельный ряд галочек  -->
    <Style x:Key="PaneChipStyle" TargetType="ToggleButton">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border
              x:Name="Bd"
              Padding="7,1"
              Background="Transparent"
              BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4">
              <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextBlock.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  Ярлыки — кирпичики в ряд; не влезли по ширине окна — переносятся во второй ряд и дальше.
          Ряд — 45 точек: 39 самого ярлыка, рамка 2 и отступы 2 + 2. Высота ряда задана жёстко:
          при масштабе экрана 150% рамка округляется до пикселя, кирпичик выходит на долю точки
          выше, и по своему размеру ряды начинали расходиться.  -->
    <ItemsPanelTemplate x:Key="TabsPanel">
      <controls:SplitTabsPanel RowHeight="45" />
    </ItemsPanelTemplate>

    <!--  ярлык вкладки: название. Пока идёт работа, на его месте — статус; кончилась — снова название.
          Счётчиков нет — они в подсказке. Карандаша нет — места мало, переименование двойным щелчком  -->
    <DataTemplate x:Key="CompactTabTemplate">
      <Grid
        Width="140"
        Height="39"
        ToolTip="{Binding TabTooltip}">
        <!--  нижний ряд — только полоска личных команд: текст и кнопки на неё не заходят  -->
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  на ярлыках шрифт не ужимается: что не влезло в строку — обрезается троеточием,
              целиком текст — в подсказке ярлыка  -->
        <StackPanel
          x:Name="Texts"
          Margin="20,0,20,0"
          VerticalAlignment="Center">
          <TextBlock
            x:Name="TitleText"
            HorizontalAlignment="Center"
            FontSize="12"
            FontWeight="SemiBold"
            Text="{Binding Title}"
            TextTrimming="CharacterEllipsis" />
          <!--  одна строка статуса вместо названия, пока идёт работа: ошибки — «Ошибок N», иначе ход  -->
          <Grid
            x:Name="StatusLine"
            HorizontalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock
              x:Name="BadgeText"
              FontSize="11"
              FontWeight="SemiBold"
              Text="{Binding StatusBadge}"
              TextTrimming="CharacterEllipsis"
              Visibility="Collapsed" />
            <TextBlock
              x:Name="CaptionText"
              FontSize="11"
              FontWeight="SemiBold"
              Text="{Binding StatusCaption}"
              TextTrimming="CharacterEllipsis"
              Visibility="Collapsed" />
          </Grid>
        </StackPanel>

        <!--  копирование: свитч личных команд слева; личная команда — стрелка назад  -->
        <ToggleButton
          x:Name="Switch"
          Margin="1,0,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Click="OnAfterCopySwitch"
          IsChecked="{Binding AfterCopyEnabled, Mode=TwoWay}"
          Style="{StaticResource TabSwitchStyle}"
          ToolTip="Команды после копирования: выполнить личные команды этой вкладки на серверах, где копирование прошло"
          Visibility="Collapsed" />
        <Button
          x:Name="Back"
          Margin="2,0,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Click="OnGoOwner"
          Style="{StaticResource TabArrowButtonStyle}"
          ToolTip="Личные команды вкладки копирования — перейти к ней"
          Visibility="Collapsed">
          <ui:SymbolIcon FontSize="10" Symbol="ArrowLeft24" />
        </Button>

        <Ellipse
          x:Name="BusyDot"
          Width="6"
          Height="6"
          Margin="3,3,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Fill="#3FB950"
          IsHitTestVisible="False"
          Visibility="Collapsed" />

        <StackPanel
          Margin="0,0,2,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Orientation="Horizontal">
          <Button
            x:Name="Forward"
            Click="OnGoPersonal"
            Style="{StaticResource TabArrowButtonStyle}"
            ToolTip="Перейти в личные команды этой вкладки"
            Visibility="Collapsed">
            <ui:SymbolIcon FontSize="10" Symbol="ArrowRight24" />
          </Button>
          <Button
            x:Name="Close"
            VerticalAlignment="Center"
            Click="OnCloseTab"
            Style="{StaticResource TabCloseButtonStyle}"
            ToolTip="Закрыть вкладку (Ctrl+W)" />
        </StackPanel>

        <!--  над рамкой выбранной вкладки с зазором, а не под ней  -->
        <ItemsControl
          Grid.Row="1"
          Height="3"
          Tag="NoNumbers"
          Margin="8,0,8,4"
          VerticalAlignment="Bottom"
          IsHitTestVisible="False"
          ItemTemplate="{StaticResource ChainSegmentTemplate}"
          ItemsSource="{Binding ChainSteps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasStatus}" Value="True">
          <Setter TargetName="BadgeText" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusCaptionVisibility}" Value="Visible">
          <Setter TargetName="BadgeText" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="CaptionText" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Running">
          <Setter TargetName="BusyDot" Property="Visibility" Value="Visible" />
          <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="StatusLine" Property="Visibility" Value="Visible" />
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="BusyPulse">
              <Storyboard>
                <DoubleAnimation
                  AutoReverse="True"
                  RepeatBehavior="Forever"
                  Storyboard.TargetName="BusyDot"
                  Storyboard.TargetProperty="Opacity"
                  From="1"
                  To="0.25"
                  Duration="0:0:0.7" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="BusyPulse" />
          </DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding CanClose}" Value="False">
          <Setter TargetName="Close" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCopyTab}" Value="True">
          <Setter TargetName="Switch" Property="Visibility" Value="Visible" />
          <Setter TargetName="Texts" Property="Margin" Value="32,0,22,0" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasPersonal}" Value="True">
          <Setter TargetName="Forward" Property="Visibility" Value="Visible" />
          <Setter TargetName="Texts" Property="Margin" Value="32,0,42,0" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsPersonal}" Value="True">
          <Setter TargetName="Back" Property="Visibility" Value="Visible" />
          <Setter TargetName="Texts" Property="Margin" Value="26,0,20,0" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!--  краткий ярлык набора серверов: только название  -->
    <DataTemplate x:Key="CompactSetTemplate">
      <Grid
        Width="140"
        Height="39"
        ToolTip="{Binding TabTooltip}">
        <TextBlock
          Margin="20,0,20,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontSize="12"
          FontWeight="SemiBold"
          Text="{Binding Title}"
          TextTrimming="CharacterEllipsis" />

        <Button
          x:Name="Close"
          Margin="0,0,2,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Click="OnCloseTab"
          Style="{StaticResource TabCloseButtonStyle}"
          ToolTip="Закрыть набор вместе с его серверами (Ctrl+W)" />
      </Grid>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding CanClose}" Value="False">
          <Setter TargetName="Close" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition x:Name="PageRow" Height="*" MinHeight="200" />
      <RowDefinition Height="Auto" />
      <RowDefinition x:Name="BottomRow" Height="280" MinHeight="0" />
    </Grid.RowDefinitions>

    <!--  название и версия слева в шапке; справа перед кнопками окна — обновление и страница утилиты  -->
    <ui:TitleBar
      x:Name="Bar"
      Grid.Row="0"
      Title="MultiServerSync"
      Icon="{core:AppIcon}">
      <ui:TitleBar.TrailingContent>
        <StackPanel
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Orientation="Horizontal">
          <!--  появляется только когда на byfox.dev версия свежее установленной  -->
          <ui:Button
            x:Name="UpdateAvailableButton"
            Height="28"
            Margin="0,0,8,0"
            Padding="10,0"
            Appearance="Primary"
            Click="OnUpdateAvailableClick"
            Icon="{ui:SymbolIcon ArrowDownload24}"
            Visibility="Collapsed" />
          <!--  страница утилиты — одним значком, адрес в подсказке  -->
          <ui:Button
            Width="28"
            Height="28"
            Padding="0"
            HorizontalContentAlignment="Center"
            Appearance="Transparent"
            Click="OnOpenProductPage"
            Icon="{ui:SymbolIcon Globe24}"
            ToolTip="https://byfox.dev/multiserversync/ — страница утилиты" />

          <!--  настройки и выход — с рамкой, но без фона, как шарик: фон только под мышью  -->
          <ui:Button
            Height="28"
            Margin="8,0,0,0"
            Padding="10,0"
            Appearance="Transparent"
            Click="OnOpenSettings"
            Content="Настройки"
            Icon="{ui:SymbolIcon Settings24}"
            ToolTip="Настройки программы" />

          <!--  крестик окна прячет программу в трей, выход — только здесь и в меню значка  -->
          <Button
            Height="28"
            Margin="8,0,0,0"
            Padding="10,0"
            Click="OnExitClick"
            Cursor="Hand"
            Focusable="False"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            ToolTip="Выйти из программы. Крестик окна только прячет её в трей">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border
                  x:Name="Bd"
                  Padding="{TemplateBinding Padding}"
                  Background="Transparent"
                  BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4">
                  <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:SymbolIcon
                      x:Name="Glyph"
                      Margin="0,0,6,0"
                      FontSize="16"
                      Foreground="{TemplateBinding Foreground}"
                      Symbol="Power24" />
                    <TextBlock
                      x:Name="Caption"
                      VerticalAlignment="Center"
                      Foreground="{TemplateBinding Foreground}"
                      Text="Выход" />
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#C42B1C" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                    <Setter TargetName="Caption" Property="Foreground" Value="White" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#A32417" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </ui:TitleBar.TrailingContent>
    </ui:TitleBar>

    <!--  У каждого раздела свои вкладки: на «Серверах» — наборы серверов, в остальных — вкладки
          раздела. В «Настройках» ряда нет совсем. Ярлыки не влезли по ширине — встают вторым рядом,
          ряд вкладок растёт вниз, а страница и нижняя панель ужимаются поровну (из кода).  -->
    <!--  мелкий жирный текст ярлыков («9 из 9») в режиме Ideal размывается сглаживанием;
          Display рисует его по пиксельной сетке, округление раскладки не ставит строку между пикселями  -->
    <Border
      x:Name="TabStripArea"
      Grid.Row="1"
      Padding="4,2,4,1"
      SizeChanged="OnTabStripAreaSized"
      TextOptions.TextFormattingMode="Display"
      UseLayoutRounding="True"
      Visibility="{Binding State.ShowsTabStrip, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  «+» и под ним архив (щелчок переключает ленту на архивные вкладки и обратно):
              вместе ровно в высоту ярлыков, сколько бы рядов их ни было;
              отступы те же, что у ярлыка. У наборов серверов архива нет — там «+» во всю высоту  -->
        <Grid
          Grid.Column="0"
          Width="44"
          Margin="0,2,4,2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="ArchiveRow" Height="*" />
          </Grid.RowDefinitions>

          <ui:Button
            Grid.Row="0"
            MinHeight="0"
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            Click="OnAddTab"
            ToolTip="Новая вкладка (Ctrl+T)">
            <ui:Button.Icon>
              <ui:SymbolIcon FontSize="14" Symbol="Add24" />
            </ui:Button.Icon>
          </ui:Button>

          <ui:Button
            x:Name="ArchiveButton"
            Grid.Row="1"
            MinHeight="0"
            Margin="0,2,0,0"
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            Click="OnArchiveClick"
            RenderTransformOrigin="0.5,0.5"
            >
            <ui:Button.RenderTransform>
              <ScaleTransform />
            </ui:Button.RenderTransform>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon
                x:Name="ArchiveIcon"
                FontSize="14"
                Symbol="Archive24" />
              <TextBlock
                x:Name="ArchiveCount"
                Margin="3,0,0,0"
                VerticalAlignment="Center"
                FontSize="10"
                FontWeight="SemiBold" />
            </StackPanel>
          </ui:Button>
        </Grid>

        <!--  наборы серверов: новый — пустой, закрытие уносит его серверы  -->
        <ListBox
          x:Name="SetStrip"
          Grid.Column="1"
          Padding="0"
          Background="Transparent"
          BorderThickness="0"
          ItemContainerStyle="{StaticResource ServerSetTabStyle}"
          ItemTemplate="{StaticResource CompactSetTemplate}"
          ItemsPanel="{StaticResource TabsPanel}"
          ItemsSource="{Binding State.ServerSets}"
          MouseDoubleClick="OnRenameTab"
          PreviewMouseRightButtonDown="OnTabStripRightDown"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Disabled"
          SelectionChanged="OnSetSelected"
          Visibility="{Binding State.ShowsServerSetTabs, Converter={StaticResource BoolToVis}}" />

        <!--  вкладки раздела; личные вкладки команд — у правого края последнего ряда  -->
        <ListBox
          x:Name="TabStrip"
          Grid.Column="1"
          Padding="0"
          Background="Transparent"
          BorderThickness="0"
          ItemContainerStyle="{StaticResource WorkspaceTabStyle}"
          ItemTemplate="{StaticResource CompactTabTemplate}"
          ItemsPanel="{StaticResource TabsPanel}"
          MouseDoubleClick="OnRenameTab"
          PreviewMouseRightButtonDown="OnTabStripRightDown"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Disabled"
          SelectionChanged="OnTabSelected"
          Visibility="{Binding State.ShowsWorkspaceTabs, Converter={StaticResource BoolToVis}}" />
      </Grid>
    </Border>

    <!--  разделы — своим рядом между вкладками и рабочей областью: боковая панель остаётся
          серверам. Двойной щелчок по разделу возвращает на его первую вкладку  -->
    <Border
      Grid.Row="2"
      Margin="4,0,4,4"
      Padding="6,4"
      Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
      BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="8">
      <!--  кнопки переставляются мышью, порядок запоминается  -->
      <StackPanel x:Name="SectionBar" Orientation="Horizontal">
        <RadioButton
          x:Name="ServersSection"
          Click="OnSectionClick"
          Style="{StaticResource SectionTabStyle}"
          Tag="{x:Type pages:ServersPage}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="Server24" />
            <TextBlock Text="Серверы" />
          </StackPanel>
        </RadioButton>
        <RadioButton
          x:Name="ExplorerSection"
          Click="OnSectionClick"
          PreviewMouseLeftButtonDown="OnNavItemMouseDown"
          Style="{StaticResource SectionTabStyle}"
          Tag="{x:Type pages:ExplorerPage}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="Folder24" />
            <TextBlock Text="Проводник" />
          </StackPanel>
        </RadioButton>
        <RadioButton
          x:Name="CommandSection"
          Click="OnSectionClick"
          PreviewMouseLeftButtonDown="OnNavItemMouseDown"
          Style="{StaticResource SectionTabStyle}"
          Tag="{x:Type pages:CommandPage}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="WindowConsole20" />
            <TextBlock Text="Команда" />
          </StackPanel>
        </RadioButton>
        <RadioButton
          x:Name="FilesSection"
          Click="OnSectionClick"
          PreviewMouseLeftButtonDown="OnNavItemMouseDown"
          Style="{StaticResource SectionTabStyle}"
          Tag="{x:Type pages:FilesPage}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="ArrowUpload24" />
            <TextBlock Text="Копирование" />
          </StackPanel>
        </RadioButton>
        <RadioButton
          x:Name="DownloadSection"
          Click="OnSectionClick"
          PreviewMouseLeftButtonDown="OnNavItemMouseDown"
          Style="{StaticResource SectionTabStyle}"
          Tag="{x:Type pages:DownloadPage}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="ArrowDownload24" />
            <TextBlock Text="Скачивание" />
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </Border>

    <!--  рабочая область: слева целевые серверы своей карточкой, справа страница раздела.
          Зазоры по 4: от края окна, между карточкой и страницей, под рядом разделов  -->
    <Grid Grid.Row="3" Margin="4,0,4,0">
      <!--  в «Проводнике» карточки серверов нет: всё место — двум панелям файлов  -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PaneColumn" Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border
        x:Name="PaneCard"
        Grid.Column="0"
        Margin="0,0,4,0"
        Padding="12"
        Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!--  что это и из какого набора; справа — что подписывать под каждым сервером  -->
          <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Style="{StaticResource PaneHeaderStyle}" Text="ЦЕЛЕВЫЕ СЕРВЕРА" />
            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding State.PaneSetTitle}"
                TextTrimming="CharacterEllipsis"
                ToolTip="Набор серверов этой вкладки — у каждой вкладки свой" />

              <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ToggleButton
                  Content="IP"
                  IsChecked="{Binding State.PaneShowIp, Mode=TwoWay}"
                  Style="{StaticResource PaneChipStyle}"
                  ToolTip="Под каждым сервером — его адрес" />
                <ToggleButton
                  Margin="4,0,0,0"
                  Content="User"
                  IsChecked="{Binding State.PaneShowUser, Mode=TwoWay}"
                  Style="{StaticResource PaneChipStyle}"
                  ToolTip="Под каждым сервером — имя пользователя, под которым идёт подключение" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <!--  на «Команде» и «Копировании»: один сервер за раз, чтобы случайно не запустить
                на нескольких. Свой у каждого набора серверов и у каждого из двух разделов  -->
          <ui:ToggleSwitch
            Grid.Row="1"
            Margin="0,0,0,4"
            Content="Одиночный выбор"
            FontSize="12"
            IsChecked="{Binding State.SingleSelectHere, Mode=TwoWay}"
            ToolTip="Включено — отметить можно только один сервер: выбор другого снимает прежний. У команд и у копирования свой, запоминается для каждого набора серверов и отдельно для «Всех»"
            Visibility="{Binding State.ShowsSingleSelectSwitch, Converter={StaticResource BoolToVis}}" />

          <ScrollViewer
            x:Name="PaneScroller"
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <!--  «Отметить все» — первой строкой, как галочка в шапке таблицы на «Серверах»; под ней черта.
                    В одиночном выборе её нет  -->
              <Border
                Margin="0,0,0,2"
                Padding="0,0,0,2"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding State.ShowsToggleAllServers, Converter={StaticResource BoolToVis}}">
                <CheckBox
                  Content="Отметить все"
                  IsChecked="{Binding State.ActiveWorkspace.PaneAllChecked, Mode=TwoWay}"
                  Style="{StaticResource PaneCheckStyle}"
                  ToolTip="Отметить или снять все серверы в списке этой вкладки. Если отмечена часть — отмечает все" />
              </Border>

              <!--  серверы переставляются мышью: порядок общий, его же показывают «Серверы»  -->
              <ItemsControl x:Name="PaneServerList" ItemsSource="{Binding State.ActiveWorkspace.Servers}">
                <ItemsControl.ItemTemplate>
                    <!--  между серверами черта: где кончается один и начинается другой; по 2 над и под ней  -->
                    <DataTemplate>
                      <Border
                        x:Name="Item"
                        Margin="0,2,0,0"
                        Padding="0,2,0,0"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <CheckBox
                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource PaneCheckStyle}"
                          ToolTip="{Binding Server.Display}">
                          <StackPanel>
                            <TextBlock Text="{Binding Server.PaneLabel}" TextTrimming="CharacterEllipsis" />
                            <!--  адрес и заметка — от левого края галочки, одной линией: это подписи к серверу  -->
                            <TextBlock
                              Margin="-21,1,0,0"
                              FontSize="11"
                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                              TextTrimming="CharacterEllipsis">
                              <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource PaneAddress}">
                                  <Binding Path="Server.User" />
                                  <Binding Path="Server.Host" />
                                  <Binding Path="DataContext.State.PaneShowUser" RelativeSource="{RelativeSource AncestorType=Window}" />
                                  <Binding Path="DataContext.State.PaneShowIp" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                              </TextBlock.Text>
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock
                              Margin="-21,1,0,0"
                              FontSize="11"
                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                              Text="{Binding Server.NotesLine}"
                              TextTrimming="CharacterEllipsis"
                              Visibility="{Binding Server.PaneNotesVisible, Converter={StaticResource BoolToVis}}" />
                          </StackPanel>
                        </CheckBox>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                          <Setter TargetName="Item" Property="Margin" Value="0" />
                          <Setter TargetName="Item" Property="Padding" Value="0" />
                          <Setter TargetName="Item" Property="BorderThickness" Value="0" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock
                Margin="2,4,0,0"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="серверов нет — добавьте на вкладке «Серверы»"
                TextWrapping="Wrap"
                Visibility="{Binding State.ActiveWorkspace.PaneEmptyHintVisibility}" />
            </StackPanel>
          </ScrollViewer>

          <!--  низ карточки: умный режим и наборы серверов. Наборы закреплены внизу:
                смена набора меняет длину списка выше, а сами наборы под мышью не прыгают  -->
          <Border Grid.Row="3" Margin="0,4,0,0">
            <StackPanel>
                <ui:ToggleSwitch
                  x:Name="SmartSwitch"
                  Click="OnSmartModeChanged"
                  Content="Умный режим"
                  FontSize="13"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  ToolTipService.ShowDuration="30000">
                  <ui:ToggleSwitch.ToolTip>
                    <TextBlock MaxWidth="340" TextWrapping="Wrap">
                      Спросит перед запуском, если команду или копирование с этой вкладки
                      вы обычно делаете на другом сервере. Безопасные команды не проверяются.
                    </TextBlock>
                  </ui:ToggleSwitch.ToolTip>
                </ui:ToggleSwitch>

              <!--  черта под умным режимом: он отдельно, наборы отдельно  -->
              <Border
                Margin="0,4,0,0"
                Padding="0,4,0,0"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding State.ShowsSetSwitcher, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock
                  Margin="0,0,0,2"
                  Style="{StaticResource PaneHeaderStyle}"
                  Text="НАБОРЫ СЕРВЕРОВ" />
                  <!--  «Все»: в панели серверы всех наборов разом  -->
                  <Button
                    Click="OnPickAllSets"
                    Content="Все"
                    ToolTip="Серверы всех наборов разом: отмечать и запускать можно на любых">
                    <Button.Style>
                      <Style BasedOn="{StaticResource PaneSetButtonStyle}" TargetType="Button">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding State.PaneAllSets}" Value="True">
                            <Setter Property="Tag" Value="Active" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <ItemsControl ItemsSource="{Binding State.ServerSets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button
                          x:Name="Pick"
                          Click="OnPickServerSet"
                          Content="{Binding Title}"
                          Style="{StaticResource PaneSetButtonStyle}"
                          ToolTip="{Binding TabTooltip}" />
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsPanePick}" Value="True">
                            <Setter TargetName="Pick" Property="Tag" Value="Active" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

              </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!--  страница раздела — такой же карточкой, как серверы слева и нижняя панель.
            Страницы живут по одной на раздел и переключаются рядом разделов над ними  -->
      <Border
        Grid.Column="1"
        Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Frame
          x:Name="PageFrame"
          Focusable="False"
          JournalOwnership="OwnsJournal"
          NavigationUIVisibility="Hidden" />
      </Border>
    </Grid>

    <!--  что сделано по последнему нажатию — тихо в правом нижнем углу, гаснет само  -->
    <controls:ActionToast
      x:Name="Toast"
      Grid.Row="3"
      Margin="0,0,24,14"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom" />

    <GridSplitter
      x:Name="BottomSplitter"
      Grid.Row="4"
      Height="4"
      HorizontalAlignment="Stretch"
      Background="Transparent"
      ResizeBehavior="PreviousAndNext"
      ResizeDirection="Rows" />

    <!--  нижняя панель: слева таблица серверов, справа вывод; вторая вкладка — журнал.
          Карточка с зазором 4 от стен окна — тот же, что между страницей и панелью  -->
    <Border
      x:Name="BottomPanel"
      Grid.Row="5"
      Margin="4,0,4,4"
      Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
      BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="8">
      <!--  кнопки терминала и журнала — в одной строке с их ярлыками, правее них: отдельной
            строки под ярлыками нет, под таблицу и вывод остаётся больше места  -->
      <Grid Margin="12">
        <Grid>
          <controls:ResultsView x:Name="Terminal" DataContext="{Binding State.ActiveWorkspace.ResultsBatch}" />
          <controls:LogPanel x:Name="Log" Visibility="Collapsed" />
        </Grid>

        <StackPanel
          x:Name="BottomTabs"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Orientation="Horizontal"
          SizeChanged="OnBottomTabsSized">
          <RadioButton
            x:Name="TerminalTab"
            Checked="OnBottomTabChanged"
            Content="Терминал"
            IsChecked="True"
            Style="{StaticResource PanelTabStyle}" />
          <RadioButton
            x:Name="JournalTab"
            Checked="OnBottomTabChanged"
            Content="Журнал"
            Style="{StaticResource PanelTabStyle}" />
        </StackPanel>
      </Grid>
    </Border>

    <!--  слой для полёта ярлыка в архив: поверх всего окна, мышь сквозь него  -->
    <Canvas
      x:Name="FxLayer"
      Grid.RowSpan="6"
      Panel.ZIndex="1000"
      IsHitTestVisible="False" />
  </Grid>
</ui:FluentWindow>
