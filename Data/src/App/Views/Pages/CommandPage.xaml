<Page
  x:Class="MultiServerSync.Views.Pages.CommandPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  Title="Команда"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.CanContentScroll="False">

  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  правка избранного: окна подкрашены, чтобы не спутать с рабочими  -->
    <SolidColorBrush x:Key="EditTint" Color="#33E8B54A" />

    <!--  строка истории и избранного: невысокие, чтобы поле ввода было больше  -->
    <Style
      x:Key="SlimComboStyle"
      BasedOn="{StaticResource {x:Type ComboBox}}"
      TargetType="ComboBox">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
      Значки поверх поля ввода, в его правом верхнем углу: места на странице не занимают,
      а действие относится ровно к тому полю, над которым висят.
    -->
    <Style x:Key="EditorIconStyle" TargetType="Button">
      <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
      <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              CornerRadius="4"
              TextElement.Foreground="{TemplateBinding Foreground}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
              <!--  пока команда идёт, запуск погашен — видно, что второй раз не нажать  -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock
      Grid.Row="0"
      Grid.Column="0"
      Margin="0,0,4,0"
      VerticalAlignment="Center"
      FontSize="12"
      Text="История:" />
    <ComboBox
      x:Name="HistoryBox"
      Grid.Row="0"
      Grid.Column="1"
      IsEnabled="{Binding IsNotEditingSnippet, RelativeSource={RelativeSource AncestorType=Page}}"
      SelectionChanged="OnHistoryPicked"
      Style="{StaticResource SlimComboStyle}"
      ToolTip="Ранее выполнявшиеся команды — общие для всех вкладок. Крестик убирает строку из истории.">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--
              HorizontalAlignment обязателен: элемент с Stretch, упёршийся в MaxWidth,
              WPF центрует в оставшемся месте — в закрытом списке команда отъезжала
              от левого края поля на половину лишней ширины.
            -->
            <TextBlock
              Grid.Column="0"
              MinWidth="320"
              MaxWidth="760"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              FontFamily="Consolas"
              Text="{Binding Converter={StaticResource ShortLine}}"
              TextTrimming="CharacterEllipsis" />
            <Button
              x:Name="Remove"
              Grid.Column="1"
              Click="OnRemoveHistoryItem"
              Style="{StaticResource HistoryRemoveButtonStyle}" />
          </Grid>
          <DataTemplate.Triggers>
            <!--  в закрытом списке шаблон рисует выбранную строку — там крестик не нужен  -->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
              <Setter TargetName="Remove" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <!--  избранное: своя шпаргалка команд с описаниями, общая для всех вкладок  -->
    <TextBlock
      Grid.Row="1"
      Grid.Column="0"
      Margin="0,4,4,0"
      VerticalAlignment="Center"
      FontSize="12"
      Text="Избранное:" />
    <ComboBox
      x:Name="BookBox"
      Grid.Row="1"
      Grid.Column="1"
      IsEnabled="{Binding IsNotEditingSnippet, RelativeSource={RelativeSource AncestorType=Page}}"
      Margin="0,4,0,0"
      SelectionChanged="OnSnippetPicked"
      Style="{StaticResource SlimComboStyle}"
      ToolTip="Сохранённые команды с описанием — общие для всех вкладок. Выбор подставляет команду в окно, а запись из нескольких окон раскрывает их все. Карандаш открывает запись на правку прямо в окнах, крестик удаляет.">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <Grid ToolTip="{Binding Preview}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
              Grid.Column="0"
              MinWidth="320"
              MaxWidth="760"
              HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <TextBlock
                  FontWeight="SemiBold"
                  Text="{Binding Comment}"
                  TextTrimming="CharacterEllipsis" />
                <Border
                  Margin="8,0,0,0"
                  Padding="5,0"
                  VerticalAlignment="Center"
                  BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                  BorderThickness="1"
                  CornerRadius="3"
                  ToolTip="Многозадачная запись: при вставке раскроет все свои окна"
                  Visibility="{Binding IsMulti, Converter={StaticResource BoolToVis}}">
                  <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding MultiText}" />
                </Border>
              </StackPanel>
              <TextBlock
                x:Name="Line"
                FontFamily="Consolas"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Preview}"
                TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button
              x:Name="Edit"
              Grid.Column="1"
              VerticalAlignment="Center"
              Click="OnEditSnippet"
              Style="{StaticResource RowEditButtonStyle}" />

            <Button
              x:Name="Remove"
              Grid.Column="2"
              VerticalAlignment="Center"
              Click="OnRemoveSnippet"
              Style="{StaticResource HistoryRemoveButtonStyle}" />
          </Grid>
          <DataTemplate.Triggers>
            <!--  в закрытом списке остаётся только описание — строка не должна расти в высоту  -->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
              <Setter TargetName="Edit" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Remove" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <!--  окна команды: делят место поровну; правка избранного — те же окна, другим фоном  -->
    <Grid
      Grid.Row="2"
      Grid.Column="0"
      Grid.ColumnSpan="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!--  полоса правки избранного: пока она видна, работают только правка окон, «Сохранить» и «Отменить»  -->
      <Border
        x:Name="EditBar"
        Grid.Row="0"
        Margin="0,4,0,0"
        Padding="10,6"
        Background="{StaticResource EditTint}"
        BorderBrush="#E8B54A"
        BorderThickness="1"
        CornerRadius="4"
        Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Grid.Column="0"
            Margin="0,0,4,0"
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Text="Правка избранного:" />
          <ui:TextBox
            x:Name="EditNameBox"
            Grid.Column="1"
            PlaceholderText="название записи" />
          <ui:Button
            Grid.Column="2"
            Margin="4,0,4,0"
            Appearance="Primary"
            Click="OnSaveEdit"
            Content="Сохранить" />
          <ui:Button
            Grid.Column="3"
            Click="OnCancelEdit"
            Content="Отменить" />
        </Grid>
      </Border>

      <ItemsControl
        x:Name="StepsList"
        Grid.Row="1"
        Focusable="False"
        ItemsSource="{Binding Steps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,4,0,0">
              <ui:TextBox
                x:Name="Box"
                AcceptsReturn="True"
                AcceptsTab="True"
                ClearButtonEnabled="False"
                DataObject.Pasting="OnCommandBoxPasting"
                FontFamily="Consolas"
                GotKeyboardFocus="OnStepFocused"
                HorizontalScrollBarVisibility="Auto"
                Loaded="OnStepBoxLoaded"
                Padding="10,8,320,30"
                PlaceholderText="Например: systemctl restart nginx&#x0a;Можно вставлять многострочные скрипты любой длины — они уходят на сервер целиком."
                PreviewKeyDown="OnCommandKeyDown"
                Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="NoWrap"
                VerticalContentAlignment="Top"
                VerticalScrollBarVisibility="Auto" />

              <!--  значки поверх окна, в его правом верхнем углу  -->
              <StackPanel
                Margin="0,4,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                  Click="OnPasteStep"
                  Style="{StaticResource EditorIconStyle}"
                  ToolTip="Вставить из буфера — заменяет всё окно, чтобы вставка не приклеилась к прошлой команде">
                  <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="ClipboardPaste24" />
                </Button>

                <!--  на одном месте запуск и остановка: пока команда идёт, ▶ становится ■  -->
                <Button
                  x:Name="RunOne"
                  Click="OnRunStep"
                  IsEnabled="{Binding IsNotEditingSnippet, RelativeSource={RelativeSource AncestorType=Page}}"
                  Style="{StaticResource EditorIconStyle}"
                  ToolTip="Выполнить только это окно"
                  Visibility="{Binding DataContext.CommandBatch.IsIdle, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                  <ui:SymbolIcon
                    FontSize="{StaticResource IconGlyphSize}"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Symbol="Play24" />
                </Button>
                <Button
                  x:Name="RunBelow"
                  Click="OnRunFromStep"
                  IsEnabled="{Binding IsNotEditingSnippet, RelativeSource={RelativeSource AncestorType=Page}}"
                  Style="{StaticResource EditorIconStyle}"
                  ToolTip="Выполнить это окно и все ниже — по очереди, каждое после успешного предыдущего (Ctrl+Enter)">
                  <ui:SymbolIcon
                    FontSize="{StaticResource IconGlyphSize}"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Symbol="FastForward24" />
                </Button>
                <Button
                  Click="OnInterrupt"
                  Style="{StaticResource EditorIconStyle}"
                  ToolTip="{x:Static controls:StopButton.Hint}"
                  Visibility="{Binding DataContext.CommandBatch.IsRunning, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                  <ui:SymbolIcon
                    FontSize="{StaticResource IconGlyphSize}"
                    Foreground="#E0574A"
                    Symbol="Stop24" />
                </Button>
                <Button
                  x:Name="CopyOut"
                  Click="OnCopyOutput"
                  IsEnabled="{Binding IsNotEditingSnippet, RelativeSource={RelativeSource AncestorType=Page}}"
                  Style="{StaticResource EditorIconStyle}"
                  ToolTip="Копировать вывод (Ctrl+Shift+C) — то же, что «Копировать. Текущее окно» в терминале: весь вывод сервера, выбранного в таблице слева, со всеми окнами">
                  <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Copy24" />
                </Button>

                <Border
                  Width="1"
                  Height="20"
                  Margin="5,0,3,0"
                  VerticalAlignment="Center"
                  Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <Button
                  Click="OnAddSnippet"
                  IsEnabled="{Binding IsNotEditingSnippet, RelativeSource={RelativeSource AncestorType=Page}}"
                  Style="{StaticResource EditorIconStyle}"
                  ToolTip="В избранное — это окно. Существующее название перезапишет свою запись.">
                  <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Heart24" />
                </Button>
                <!--  два сердечка: весь набор окон одной записью  -->
                <Button
                  x:Name="SaveSet"
                  Click="OnAddSnippetSet"
                  IsEnabled="{Binding IsNotEditingSnippet, RelativeSource={RelativeSource AncestorType=Page}}"
                  Style="{StaticResource EditorIconStyle}"
                  ToolTip="В избранное — все окна одной записью. При вставке окна раскроются сами."
                  Visibility="{Binding CanSaveSet, Converter={StaticResource BoolToVis}}">
                  <Grid Width="24" Height="20">
                    <ui:SymbolIcon
                      Margin="0,0,6,0"
                      HorizontalAlignment="Left"
                      FontSize="16"
                      Symbol="Heart24" />
                    <ui:SymbolIcon
                      Margin="6,4,0,0"
                      HorizontalAlignment="Right"
                      FontSize="16"
                      Symbol="Heart24" />
                  </Grid>
                </Button>
                <Button
                  Click="OnClearStep"
                  Style="{StaticResource EditorIconStyle}"
                  ToolTip="Очистить окно">
                  <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Delete24" />
                </Button>

                <Border
                  Width="1"
                  Height="20"
                  Margin="5,0,3,0"
                  VerticalAlignment="Center"
                  Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <Button
                  Click="OnAddStep"
                  Style="{StaticResource EditorIconStyle}"
                  ToolTip="Добавить окно ниже — выполнится после этого">
                  <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Add24" />
                </Button>
                <Button
                  Click="OnRemoveStep"
                  Style="{StaticResource EditorIconStyle}"
                  ToolTip="Убрать это окно"
                  Visibility="{Binding IsMulti, Converter={StaticResource BoolToVis}}">
                  <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Subtract24" />
                </Button>
              </StackPanel>

              <!--  низ справа: sudo окна, статус, секундомер и номер — по ним видно, где встало  -->
              <StackPanel
                Margin="0,0,12,6"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal">
                <CheckBox
                  MinWidth="0"
                  Margin="0,0,14,0"
                  Padding="4,0,0,0"
                  VerticalAlignment="Center"
                  Content="sudo"
                  FontSize="12"
                  IsChecked="{Binding UseSudo, Mode=TwoWay}"
                  ToolTip="Это окно выполняется как sudo -S -p '' bash -s, пароль сервера подаётся на stdin" />
                <TextBlock
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  FontSize="12"
                  FontWeight="Bold"
                  Text="{Binding StatusText}" />
                <TextBlock
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  FontFamily="Consolas"
                  FontSize="12"
                  Text="{Binding ClockText}" />
                <TextBlock
                  x:Name="Number"
                  VerticalAlignment="Center"
                  FontSize="12"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{Binding NumberText}"
                  Visibility="{Binding IsMulti, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </Grid>

            <DataTemplate.Triggers>
              <!--  у последнего окна «это и все ниже» — то же самое, что «только это»  -->
              <DataTrigger Binding="{Binding HasBelow}" Value="False">
                <Setter TargetName="RunBelow" Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding DataContext.CommandBatch.IsRunning, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                <Setter TargetName="RunBelow" Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <!--  вывод общий на все окна — копировать его достаточно с первого  -->
              <DataTrigger Binding="{Binding IsFirst}" Value="False">
                <Setter TargetName="CopyOut" Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!--  «не вставлено» — посреди окон, крупно: в углу окна такую плашку не замечали  -->
      <controls:ActionToast
        x:Name="PasteToast"
        Grid.Row="1"
        Margin="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center" />
    </Grid>

    <Grid
      x:Name="BottomBar"
      Grid.Row="3"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Margin="0,4,0,0"
      IsEnabled="{Binding IsNotEditingSnippet, RelativeSource={RelativeSource AncestorType=Page}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <ui:Button
          Margin="0,0,4,0"
          Appearance="Primary"
          Click="OnRun"
          Content="Выполнить тут"
          Icon="{ui:SymbolIcon Play24}"
          IsEnabled="{Binding CommandBatch.IsIdle}"
          ToolTip="Все окна этой вкладки по очереди на её отмеченных серверах (Ctrl+Enter в первом окне)" />

        <ui:Button
          Appearance="Danger"
          Click="OnRunEverywhere"
          Content="Выполнить везде"
          Icon="{ui:SymbolIcon Play24}"
          IsEnabled="{Binding CommandBatch.IsIdle}"
          ToolTip="Запускает команды сразу во всех командных вкладках — каждая со своими окнами и серверами. Личные вкладки копирования не запускаются. Итог по каждой видно на её ярлыке." />
      </StackPanel>

      <TextBlock
        Grid.Column="1"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        FontSize="11"
        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
        Text="{Binding CommandSizeInfo}" />
    </Grid>
  </Grid>
</Page>
