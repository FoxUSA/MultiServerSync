<Page
  x:Class="MultiServerSync.Views.Pages.CommandPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:services="clr-namespace:MultiServerSync.Services"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:pages="clr-namespace:MultiServerSync.Views.Pages"
  Title="Команда"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.CanContentScroll="False">

  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  строка истории: невысокая, чтобы поле ввода было больше  -->
    <Style
      x:Key="SlimComboStyle"
      BasedOn="{StaticResource {x:Type ComboBox}}"
      TargetType="ComboBox">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

  </Page.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock
      Grid.Row="0"
      Grid.Column="0"
      Margin="0,0,4,0"
      VerticalAlignment="Center"
      FontSize="12"
      Text="История:" />
    <ComboBox
      x:Name="HistoryBox"
      Grid.Row="0"
      Grid.Column="1"
      ItemsSource="{Binding CommandHistory}"
      SelectionChanged="OnHistoryPicked"
      Style="{StaticResource SlimComboStyle}"
      ToolTip="Команды, выполненные в этой вкладке, без повторов. У строки — в избранное, скопировать и убрать из истории.">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--
              HorizontalAlignment обязателен: элемент с Stretch, упёршийся в MaxWidth,
              WPF центрует в оставшемся месте — в закрытом списке команда отъезжала
              от левого края поля на половину лишней ширины.
            -->
            <TextBlock
              Grid.Column="0"
              MinWidth="320"
              MaxWidth="760"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              FontFamily="Consolas"
              Text="{Binding Converter={StaticResource ShortLine}}"
              TextTrimming="CharacterEllipsis" />
            <Button
              x:Name="Book"
              Grid.Column="1"
              Click="OnBookHistoryItem"
              Style="{StaticResource RowIconButtonStyle}"
              ToolTip="Добавить в избранное">
              <ui:SymbolIcon FontSize="12" Symbol="Heart24" />
            </Button>
            <Button
              x:Name="Copy"
              Grid.Column="2"
              Click="OnCopyHistoryItem"
              Style="{StaticResource RowIconButtonStyle}"
              ToolTip="Скопировать команду">
              <ui:SymbolIcon FontSize="12" Symbol="Copy24" />
            </Button>
            <Button
              x:Name="Remove"
              Grid.Column="3"
              Click="OnRemoveHistoryItem"
              Style="{StaticResource HistoryRemoveButtonStyle}" />
          </Grid>
          <DataTemplate.Triggers>
            <!--  в закрытом списке шаблон рисует выбранную строку — там кнопки не нужны  -->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
              <Setter TargetName="Book" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Copy" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Remove" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <!--  окна команды: делят место поровну  -->
    <Grid
      Grid.Row="1"
      Grid.Column="0"
      Grid.ColumnSpan="2">

      <!--  окна делят высоту поровну, но не ниже своего минимума — дальше их листает прокрутка  -->
      <ScrollViewer
        x:Name="StepsScroll"
        Focusable="False"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <ItemsControl
          x:Name="StepsList"
          VerticalAlignment="Top"
          Focusable="False"
          ItemsSource="{Binding Steps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4,0,0" GotKeyboardFocus="OnStepFocused">
                <ui:TextBox
                  x:Name="Box"
                  controls:EmptyAreaSelect.IsOn="True"
                  AcceptsReturn="True"
                  AcceptsTab="True"
                  ClearButtonEnabled="False"
                  DataObject.Pasting="OnCommandBoxPasting"
                  FontFamily="Consolas"
                  HorizontalScrollBarVisibility="Auto"
                  Loaded="OnStepBoxLoaded"
                  Padding="10,8,240,44"
                  PlaceholderText="Можно вставлять многострочные скрипты любой длины — они уходят на сервер целиком."
                  PreviewKeyDown="OnCommandKeyDown"
                  Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                  TextWrapping="NoWrap"
                  VerticalContentAlignment="Top"
                  VerticalScrollBarVisibility="Auto" />

                <!--  личные команды вкладки копирования — окно в тусклой оранжевой рамке, как и её ярлык:
                      видно, что правишь команды после копирования, а не обычную команду  -->
                <Border
                  x:Name="PersonalRing"
                  BorderBrush="#80E07A1F"
                  BorderThickness="2"
                  CornerRadius="4"
                  IsHitTestVisible="False"
                  Visibility="Collapsed" />

                <!--  окно в фокусе при нескольких окнах — вся рамка цвета нижней линии поля, как на «Копировании» и «Скачивании»  -->
                <Border
                  x:Name="FocusRing"
                  BorderBrush="{DynamicResource TextControlFocusedBorderBrush}"
                  BorderThickness="2"
                  CornerRadius="4"
                  IsHitTestVisible="False"
                  Visibility="Collapsed" />

                <!--  мигает тусклым оранжевым, когда жмут кнопку, которой нечего делать  -->
                <Border
                  x:Name="Flash"
                  Background="#14E07A1F"
                  BorderBrush="#A0E07A1F"
                  BorderThickness="2"
                  CornerRadius="4"
                  IsHitTestVisible="False"
                  Opacity="0" />

                <!--  значки поверх окна, в его правом верхнем углу, в два ряда: запуск сверху, избранное и окна под ним  -->
                <StackPanel
                  Margin="0,4,8,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  SizeChanged="OnStepIconsResized">
                  <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                      x:Name="Paste"
                      Click="OnPasteStep"
                      Style="{StaticResource EditorIconStyle}"
                      ToolTip="Вставить из буфера — заменяет всё окно, чтобы вставка не приклеилась к прошлой команде">
                      <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="ClipboardPaste24" />
                    </Button>

                    <!--  на одном месте запуск и остановка: пока команда идёт, ▶ становится ■  -->
                    <Button
                      x:Name="RunOne"
                      Click="OnRunStep"
                      Style="{StaticResource EditorIconStyle}"
                      ToolTip="Выполнить только это окно"
                      Visibility="{Binding DataContext.CommandBatch.IsIdle, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                      <ui:SymbolIcon
                        FontSize="{StaticResource IconGlyphSize}"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Symbol="Play24" />
                    </Button>
                    <Button
                      x:Name="RunBelow"
                      Click="OnRunFromStep"
                      Style="{StaticResource EditorIconStyle}"
                      ToolTip="Выполнить это окно и все ниже — по очереди, каждое после успешного предыдущего (Ctrl+Enter)">
                      <ui:SymbolIcon
                        FontSize="{StaticResource IconGlyphSize}"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Symbol="FastForward24" />
                    </Button>
                    <Button
                      Click="OnInterrupt"
                      Style="{StaticResource EditorIconStyle}"
                      ToolTip="{x:Static controls:StopButton.Hint}"
                      Visibility="{Binding DataContext.CommandBatch.IsRunning, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                      <ui:SymbolIcon
                        FontSize="{StaticResource IconGlyphSize}"
                        Foreground="#E0574A"
                        Symbol="Stop24" />
                    </Button>
                    <Button
                      x:Name="CopyOut"
                      Click="OnCopyOutput"
                      Style="{StaticResource EditorIconStyle}"
                      ToolTip="Копировать вывод (Ctrl+Shift+C) — то же, что «Текущий лог» в журнале: весь вывод сервера, выбранного в таблице слева, со всеми окнами">
                      <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Copy24" />
                    </Button>

                    <Border
                      Width="1"
                      Height="20"
                      Margin="3,0,1,0"
                      VerticalAlignment="Center"
                      Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <Button
                      x:Name="Clear"
                      Click="OnClearStep"
                      Style="{StaticResource EditorIconStyle}"
                      ToolTip="Очистить окно">
                      <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Delete24" />
                    </Button>
                  </StackPanel>

                  <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                      Click="OnOpenBook"
                      Style="{StaticResource EditorIconStyle}"
                      ToolTip="Избранное: команда по щелчку встаёт в это окно, запись из нескольких окон раскрывает их все. Там же — добавить в избранное это окно или все окна.">
                      <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Heart24" />
                    </Button>

                    <Border
                      Width="1"
                      Height="20"
                      Margin="3,0,1,0"
                      VerticalAlignment="Center"
                      Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <Button
                      Click="OnAddStep"
                      Style="{StaticResource EditorIconStyle}"
                      ToolTip="Добавить окно ниже — выполнится после этого">
                      <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Add24" />
                    </Button>
                    <Button
                      Click="OnRemoveStep"
                      Style="{StaticResource EditorIconStyle}"
                      ToolTip="Убрать это окно"
                      Visibility="{Binding IsMulti, Converter={StaticResource BoolToVis}}">
                      <ui:SymbolIcon FontSize="{StaticResource IconGlyphSize}" Symbol="Subtract24" />
                    </Button>
                  </StackPanel>
                </StackPanel>

                <!--  низ справа: статус и секундомер — по ним видно, где встало  -->
                <StackPanel
                  Margin="0,0,12,6"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Orientation="Horizontal">
                  <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Bold"
                    Text="{Binding StatusText}" />
                  <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="12"
                    Text="{Binding ClockText}" />
                </StackPanel>

                <!--  низ слева: номер окна и его sudo  -->
                <StackPanel
                  Margin="12,0,0,6"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Orientation="Horizontal">
                  <!--  номер на тусклой оранжевой плашке с рамкой, как у истёкшего «Хранить лог», — чтобы глаз сразу находил окно  -->
                  <Border
                    Margin="0,0,10,0"
                    Padding="7,1,7,2"
                    VerticalAlignment="Center"
                    Background="#38E07A1F"
                    BorderBrush="#80E07A1F"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding IsMulti, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                      FontFamily="Consolas"
                      FontSize="12"
                      Text="{Binding NumberText}" />
                  </Border>
                  <CheckBox
                    MinWidth="0"
                    Padding="4,0,0,0"
                    VerticalAlignment="Center"
                    Content="sudo"
                    FontSize="12"
                    IsChecked="{Binding UseSudo, Mode=TwoWay}"
                    ToolTip="Это окно выполняется как sudo -S -p '' bash -s, пароль сервера подаётся на stdin" />
                </StackPanel>
              </Grid>

              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsPersonal, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                  <Setter TargetName="PersonalRing" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMulti}" Value="True" />
                    <Condition Binding="{Binding IsFocused}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <!--  кнопкам нечего делать — тусклые  -->
                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                  <Setter TargetName="RunOne" Property="pages:CommandPage.Idle" Value="True" />
                  <Setter TargetName="Clear" Property="pages:CommandPage.Idle" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTailEmpty}" Value="True">
                  <Setter TargetName="RunBelow" Property="pages:CommandPage.Idle" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.CommandBatch.HasResults, RelativeSource={RelativeSource AncestorType=Page}}" Value="False">
                  <Setter TargetName="CopyOut" Property="pages:CommandPage.Idle" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasClipboardText, RelativeSource={RelativeSource AncestorType=Page}}" Value="False">
                  <Setter TargetName="Paste" Property="pages:CommandPage.Idle" Value="True" />
                </DataTrigger>
                <!--  у последнего окна «это и все ниже» — то же самое, что «только это»  -->
                <DataTrigger Binding="{Binding HasBelow}" Value="False">
                  <Setter TargetName="RunBelow" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.CommandBatch.IsRunning, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                  <Setter TargetName="RunBelow" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!--  вывод общий на все окна — копировать его достаточно с первого  -->
                <DataTrigger Binding="{Binding IsFirst}" Value="False">
                  <Setter TargetName="CopyOut" Property="Visibility" Value="Collapsed" />
                  <!--  подсказка нужна один раз — в первом окне  -->
                  <Setter TargetName="Box" Property="ui:TextBox.PlaceholderText" Value="" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!--  «не вставлено» — посреди окон: в углу окна такую плашку не замечали  -->
      <controls:ActionToast
        x:Name="PasteToast"
        Margin="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center" />
    </Grid>

    <Grid
      x:Name="BottomBar"
      Grid.Row="2"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <ui:Button
          Margin="0,0,4,0"
          Appearance="Primary"
          Click="OnRun"
          Content="Выполнить"
          Icon="{ui:SymbolIcon Play24}"
          IsEnabled="{Binding CommandBatch.IsIdle}"
          ToolTip="Все окна этой вкладки по очереди на её отмеченных серверах. Со свитчем «Везде» — во всех командных вкладках сразу, после вопроса. Ctrl+Enter в окне — только эта вкладка">
          <!--  во всех окнах пусто — кнопка тусклая, но жмётся: нажатие мигает рамками окон  -->
          <ui:Button.Style>
            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
              <Style.Triggers>
                <DataTrigger Binding="{Binding AllStepsEmpty}" Value="True">
                  <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Button.Style>
        </ui:Button>

        <ui:ToggleSwitch
          x:Name="EverywhereSwitch"
          Margin="4,0,0,0"
          VerticalAlignment="Center"
          Content="Везде"
          IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=Everywhere, Mode=TwoWay}"
          Style="{StaticResource DangerSwitchStyle}"
          ToolTip="Включено — «Выполнить» запускает команды сразу во всех командных вкладках, каждая со своими окнами и серверами, после вопроса. Личные вкладки копирования не запускаются. Итог по каждой — на её ярлыке" />

      </StackPanel>

      <TextBlock
        Grid.Column="1"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        FontSize="11"
        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
        Text="{Binding CommandSizeInfo}" />
    </Grid>
  </Grid>
</Page>
