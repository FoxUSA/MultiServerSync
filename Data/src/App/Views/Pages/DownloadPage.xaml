<Page
  x:Class="MultiServerSync.Views.Pages.DownloadPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:services="clr-namespace:MultiServerSync.Services"
  Title="Скачивание"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.CanContentScroll="False">

  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--  общая таблица окон: номер окна, разделитель группы, строка пустого окна — одни с «Копированием»  -->
        <ResourceDictionary Source="/Themes/CopyWindowStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style
      x:Key="ToolButtonStyle"
      BasedOn="{StaticResource {x:Type ui:Button}}"
      TargetType="ui:Button">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    </ResourceDictionary>
  </Page.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="4" />
      <RowDefinition x:Name="BandRow" Height="Auto" MinHeight="138" />
    </Grid.RowDefinitions>

    <!--  сводка — в ряду кнопок, справа: отдельной строки под неё нет  -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Orientation="Horizontal">
      <!--  окон несколько — номер окна в фокусе: кнопки ряда, сводка и параметры работают с ним  -->
      <Border
        Height="28"
        MinWidth="34"
        Margin="0,0,4,0"
        Padding="7,0"
        Background="#26E07A1F"
        BorderBrush="#80E07A1F"
        BorderThickness="1"
        CornerRadius="4"
        ToolTip="Кнопки ряда, сводка и параметры — для этого окна. Другое окно — щелчок по его номеру"
        Visibility="{Binding IsMultiWindow, Converter={StaticResource BoolToVis}}">
        <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontFamily="Consolas"
          FontSize="12"
          Text="{Binding FocusedWindow.NumberText}" />
      </Border>
      <!--  «Выбрать на сервере» и «Исключения» под замком не гаснут: посмотреть можно, изменить — нет  -->
      <ui:Button
        Click="OnBrowseAdd"
        Content="Выбрать на сервере"
        Icon="{ui:SymbolIcon FolderOpen24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Обзор сервера: выделите файлы и папки (Ctrl, Shift) и нажмите «Выбрать». Ничего не выделено — берётся открытая папка" />
      <!--  заданы исключения — значок на зелёной плашке: видно, что не всё из списка скачается.
            Плашка выходит влево на свой отступ, чтобы значок стоял там же, где у соседних кнопок  -->
      <ui:Button
        Click="OnExcludes"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Что не скачивать: маски вроде *.log, node_modules, .git">
        <StackPanel Orientation="Horizontal">
          <Border Margin="-2,0,6,0" Style="{StaticResource ExcludeBadgeStyle}">
            <ui:SymbolIcon Style="{StaticResource ExcludeGlyphStyle}" />
          </Border>
          <TextBlock VerticalAlignment="Center" Text="Исключения" />
        </StackPanel>
      </ui:Button>
      <ui:Button
        controls:LockMute.IsOn="{Binding IsPaneLocked}"
        Click="OnClear"
        Content="Очистить"
        Icon="{ui:SymbolIcon Delete24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Убрать отмеченные строки, а если отметок нет — все. На сервере ничего не удаляется" />
      <ui:Button
        Click="OnRefresh"
        Content="Обновить"
        Icon="{ui:SymbolIcon ArrowClockwise24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Перечитать с серверов размер, число файлов и дату изменения; пока страница открыта, это происходит само каждые 30 секунд" />
    </StackPanel>
    </Grid>

    <!--  Таблица одна на все окна вкладки, как на «Копировании»: шапка общая, строки окна — группой под тонким
          разделителем с номером и названием. Строка таблицы — файл или папка на своём сервере, выбранные обзором;
          качаются строки с галочкой. Под таблицей — строки папки окон стопкой. Окно в фокусе — щелчком по номеру  -->
    <Border
      Grid.Row="1"
      Margin="0,4,0,0"
      Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="4">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <DataGrid
            x:Name="RowsGrid"
            BorderThickness="0"
            CanUserReorderColumns="False"
            CellStyle="{StaticResource AppDataGridCellStyle}"
            ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
            Loaded="OnWindowGridLoaded"
            MouseDoubleClick="OnGridDoubleClick"
            RowHeight="24"
            RowStyleSelector="{StaticResource WindowRowSelector}"
            Style="{StaticResource AppDataGridStyle}"
            VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.IsVirtualizingWhenGrouping="True">
            <DataGrid.GroupStyle>
              <GroupStyle ContainerStyle="{StaticResource WindowGroupStyle}" />
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn
                Width="26"
                MinWidth="26"
                CanUserResize="False"
                CellStyle="{StaticResource CheckColumnCellStyle}"
                HeaderStyle="{StaticResource CheckColumnHeaderStyle}">
                <DataGridTemplateColumn.Header>
                  <Viewbox
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <CheckBox
                      MinWidth="0"
                      MinHeight="0"
                      Margin="0"
                      Padding="0"
                      Click="OnToggleAll"
                      IsChecked="{Binding DataContext.AllWindowsDownloadsSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                      IsThreeState="True"
                      ToolTip="Отметить или снять все строки всех окон" />
                  </Viewbox>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Viewbox
                      Width="16"
                      Height="16"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                      <CheckBox
                        MinWidth="0"
                        MinHeight="0"
                        Margin="0"
                        Padding="0"
                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Viewbox>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!--  всё по содержимому, а путь забирает остаток ширины  -->
              <DataGridTextColumn
                Width="Auto"
                MaxWidth="220"
                Binding="{Binding ServerLabel}"
                Header="Сервер" />
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding Kind}"
                Header="Тип" />
              <DataGridTextColumn
                Width="Auto"
                MaxWidth="360"
                Binding="{Binding Name}"
                Header="Имя" />
              <!--  показывают надпись, а сортируются по значению — иначе даты по дню, а размеры по первой цифре  -->
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding SizeText}"
                Header="Размер"
                SortMemberPath="SizeBytes" />
              <!--  какие из четырёх видны — решает SizeColumns  -->
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding KeptSizeText}"
                Header="Размер*"
                SortMemberPath="KeptBytes"
                Visibility="Collapsed" />
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding FilesText}"
                Header="Файлов"
                SortMemberPath="FilesCount" />
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding KeptFilesText}"
                Header="Файлов*"
                SortMemberPath="KeptFiles"
                Visibility="Collapsed" />
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding ModifiedText}"
                Header="Дата изменения"
                SortMemberPath="Modified" />
              <!--  в конце строки — копировать и вписать путь, как в адресной строке «Проводника»  -->
              <DataGridTemplateColumn
                Width="*"
                MinWidth="150"
                Header="Путь на сервере"
                SortMemberPath="Path">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <StackPanel
                        Margin="4,0,2,0"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                        <Button
                          Click="OnCopyRowPath"
                          Style="{StaticResource RowPathButtonStyle}"
                          ToolTip="Копировать путь">
                          <ui:SymbolIcon FontSize="14" Symbol="Copy24" />
                        </Button>
                        <Button
                          controls:LockMute.IsOn="{Binding DataContext.IsPaneLocked, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          Click="OnEditRowPath"
                          Style="{StaticResource RowPathButtonStyle}"
                          ToolTip="Вписать другой путь на этом сервере">
                          <ui:SymbolIcon FontSize="14" Symbol="Edit24" />
                        </Button>
                        <Button
                          controls:LockMute.IsOn="{Binding DataContext.IsPaneLocked, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          Click="OnRemoveRow"
                          Style="{StaticResource RowPathButtonStyle}"
                          ToolTip="Убрать строку из списка — на сервере ничего не удаляется">
                          <ui:SymbolIcon FontSize="14" Symbol="Delete24" />
                        </Button>
                      </StackPanel>
                      <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding Path}"
                        TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            IsHitTestVisible="False"
            Text="Что скачивать — выберите файлы и папки кнопкой «Выбрать на сервере» или двойным щелчком здесь.">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Items.Count, ElementName=RowsGrid}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <!--  плюс единственного окна — под последней строкой, столбиком со значками строки; место ставит код.
                Окон несколько — плюс и минус у каждого на его разделителе  -->
          <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMultiWindow}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Button
              controls:LockMute.IsOn="{Binding IsPaneLocked}"
              Click="OnAddWindow"
              Style="{StaticResource RowPathButtonStyle}"
              ToolTip="Добавить окно ниже — выполнится после этого">
              <ui:SymbolIcon FontSize="18" Symbol="Add24" />
            </Button>
          </StackPanel>
        </Grid>

        <!--  строка папки одна — окна в фокусе: номер, «Обзор», «Открыть», папка  -->
        <Border
          Grid.Row="1"
          DataContext="{Binding FocusedWindow}"
          Padding="4"
          Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  номер окна в фокусе, как у «Открыть»: строка пути одна и переключается вместе с фокусом  -->
            <Border
              Grid.Column="0"
              MinWidth="34"
              Margin="0,0,4,0"
              Padding="7,0"
              Background="#26E07A1F"
              BorderBrush="#80E07A1F"
              BorderThickness="1"
              CornerRadius="4"
              ToolTip="Путь окна в фокусе. Другое окно — щелчок по его номеру в таблице"
              Visibility="{Binding IsMulti, Converter={StaticResource BoolToVis}}">
              <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                FontSize="12"
                Text="{Binding NumberText}" />
            </Border>

            <!--  вместо подписи «Куда скачать» — выбрать папку и открыть её, как «Обзор» и «Листинг» в «Копировании»  -->
            <StackPanel
              Grid.Column="1"
              Margin="0,0,4,0"
              Orientation="Horizontal">
              <!--  под замком не гаснет: посмотреть можно, выбрать — нет  -->
              <ui:Button
                Height="Auto"
                VerticalAlignment="Stretch"
                Click="OnPickFolder"
                Content="Обзор"
                Icon="{ui:SymbolIcon FolderOpen24}"
                Style="{StaticResource ToolButtonStyle}"
                ToolTip="Выбрать папку на этом компьютере, куда скачать" />
              <ui:Button
                Height="Auto"
                Margin="4,0,0,0"
                VerticalAlignment="Stretch"
                Click="OnOpenFolder"
                Content="Открыть"
                Icon="{ui:SymbolIcon Open24}"
                Style="{StaticResource ToolButtonStyle}"
                ToolTip="Открыть папку в проводнике" />
            </StackPanel>
            <!--  копировать путь — в конце поля; крестик очистки убран, чтобы не лёг под значок  -->
            <ui:TextBox
              Grid.Column="2"
              Padding="10,5,36,6"
              controls:LockMute.IsOn="{Binding IsPaneLocked}"
              ClearButtonEnabled="False"
              IsEnabled="{Binding IsNotPaneLocked}"
              FontSize="12"
              PlaceholderText="папка на этом компьютере"
              Text="{Binding LocalFolder, UpdateSourceTrigger=PropertyChanged}" />
            <Button
              Grid.Column="2"
              Margin="0,0,6,0"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Click="OnCopyLocalFolder"
              Style="{StaticResource RowPathButtonStyle}"
              ToolTip="Копировать путь">
              <ui:SymbolIcon FontSize="14" Symbol="Copy24" />
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!--  границу над нижней полосой двигают мышью  -->
    <GridSplitter
      Grid.Row="2"
      Height="4"
      HorizontalAlignment="Stretch"
      Background="Transparent"
      DragCompleted="OnBandMoved" />

    <!--  нижняя полоса, как на «Копировании»: слева пуск и параметры, справа мини-терминал  -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="BandLeft" Width="1*" MinWidth="345" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="2*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <Grid x:Name="BandLeftBlock" Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <StackPanel
      x:Name="RunRow"
      Grid.Row="0"
      Orientation="Horizontal">
      <!--  «Везде» решает, где пойдут «Выполнить» и «Сравнить»: эта вкладка или все вкладки раздела  -->
      <ui:Button
        Margin="0,0,8,0"
        Appearance="Primary"
        Click="OnDownload"
        Content="Выполнить"
        Icon="{ui:SymbolIcon ArrowDownload24}"
        IsEnabled="{Binding CopyBatch.IsIdle}"
        ToolTip="Пути всех окон этой вкладки, окна сверху вниз. Со свитчем «Везде» — на всех вкладках сразу, после вопроса" />

      <ui:Button
        x:Name="CompareButton"
        Click="OnCompare"
        Content="Сравнить"
        Icon="{ui:SymbolIcon BranchCompare24}"
        IsEnabled="{Binding CopyBatch.IsIdle}"
        ToolTip="Сверяет файлы сервера с папкой здесь по правилам из параметров и ничего не скачивает. В статусе — сошлось или нет, что именно отличается — в выводе" />

      <ui:ToggleSwitch
        x:Name="EverywhereSwitch"
        Margin="12,0,0,0"
        VerticalAlignment="Center"
        Content="Везде"
        IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=Everywhere, Mode=TwoWay}"
        Style="{StaticResource DangerSwitchStyle}"
        ToolTip="Включено — «Выполнить» скачивает сразу на всех вкладках, каждая со своими путями, папкой и серверами, после вопроса. «Сравнить» тоже идёт на всех. Итог по каждой — на её ярлыке" />
    </StackPanel>

        <!--  параметры — общий блок для «Копирования», «Скачивания» и «Проводника»  -->
        <controls:TransferOptionsPanel Grid.Row="1" Margin="0,4,0,0" Direction="Download" />
      </Grid>

      <GridSplitter
        Grid.Column="1"
        Width="4"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        DragCompleted="OnBandMoved" />

      <!--  высота полосы — по левой части: окна мини-терминала её не раздувают, а листаются  -->
      <controls:MiniTerminal
        Grid.Column="2"
        Height="{Binding ActualHeight, ElementName=BandLeftBlock}"
        VerticalAlignment="Top"
        TagRowHeight="{Binding ActualHeight, ElementName=RunRow}" />
    </Grid>
  </Grid>
</Page>
