<Page
  x:Class="MultiServerSync.Views.Pages.DownloadPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:services="clr-namespace:MultiServerSync.Services"
  Title="Скачивание"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.CanContentScroll="False">

  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style
      x:Key="ToolButtonStyle"
      BasedOn="{StaticResource {x:Type ui:Button}}"
      TargetType="ui:Button">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
  </Page.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="4" />
      <RowDefinition x:Name="BandRow" Height="Auto" MinHeight="138" />
    </Grid.RowDefinitions>

    <!--  сводка — в ряду кнопок, справа: отдельной строки под неё нет  -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Orientation="Horizontal">
      <ui:Button
        controls:LockMute.IsOn="{Binding IsPaneLocked}"
        Click="OnBrowseAdd"
        Content="Выбрать на сервере"
        Icon="{ui:SymbolIcon FolderOpen24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Обзор сервера: выделите файлы и папки (Ctrl, Shift) и нажмите «Выбрать». Ничего не выделено — берётся открытая папка" />
      <!--  заданы исключения — значок на зелёной плашке: видно, что не всё из списка скачается.
            Плашка выходит влево на свой отступ, чтобы значок стоял там же, где у соседних кнопок  -->
      <ui:Button
        controls:LockMute.IsOn="{Binding IsPaneLocked}"
        Click="OnExcludes"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Что не скачивать: маски вроде *.log, node_modules, .git">
        <StackPanel Orientation="Horizontal">
          <Border Margin="-2,0,6,0" Style="{StaticResource ExcludeBadgeStyle}">
            <ui:SymbolIcon Style="{StaticResource ExcludeGlyphStyle}" />
          </Border>
          <TextBlock VerticalAlignment="Center" Text="Исключения" />
        </StackPanel>
      </ui:Button>
      <ui:Button
        controls:LockMute.IsOn="{Binding IsPaneLocked}"
        Click="OnClear"
        Content="Очистить"
        Icon="{ui:SymbolIcon Delete24}"
        Style="{StaticResource ToolButtonStyle}" />
      <ui:Button
        Click="OnRefresh"
        Content="Обновить"
        Icon="{ui:SymbolIcon ArrowClockwise24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Перечитать с серверов размер, число файлов и дату изменения; пока страница открыта, это происходит само каждые 30 секунд" />
      <!--  резервирует в каждом окне плашку названия, справа от номера; видна, пока окон больше одного  -->
      <ui:Button
        Click="OnWindowNames"
        Content="Название"
        Icon="{ui:SymbolIcon Rename24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Показать или скрыть названия окон. Название меняется двойным щелчком по его плашке"
        Visibility="{Binding IsMultiWindow, Converter={StaticResource BoolToVis}}" />
      <controls:UndoButtons VerticalAlignment="Center" />
    </StackPanel>

      <TextBlock
        Grid.Column="1"
        Margin="12,0,0,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        FontSize="12"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding DownloadInfo}"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding DownloadInfo}" />
    </Grid>

    <!--  окна делят высоту поровну, но не ниже своего минимума — дальше их листает прокрутка, как окна «Команд».
          Окно — таблица и строка папки под ней; панель кнопок и параметры одни и показывают окно в фокусе.
          Строка таблицы — файл или папка на своём сервере, выбранные обзором; качаются строки с галочкой  -->
    <ScrollViewer
      x:Name="WindowsScroll"
      Grid.Row="1"
      Focusable="False"
      HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Auto">
      <ItemsControl
        x:Name="WindowsList"
        VerticalAlignment="Top"
        Focusable="False"
        ItemsSource="{Binding CopyWindows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid
              Margin="0,4,0,0"
              GotKeyboardFocus="OnWindowKeyboardFocus"
              PreviewMouseDown="OnWindowMouseDown">
              <Border
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0">
                    <DataGrid
                      BorderThickness="0"
                      CanUserReorderColumns="False"
                      CellStyle="{StaticResource AppDataGridCellStyle}"
                      ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
                      ItemsSource="{Binding Downloads}"
                      Loaded="OnWindowGridLoaded"
                      MouseDoubleClick="OnGridDoubleClick"
                      RowStyle="{StaticResource AppDataGridRowStyle}"
                      Style="{StaticResource AppDataGridStyle}"
                      VerticalScrollBarVisibility="Auto">
                      <DataGrid.Columns>
                        <DataGridTemplateColumn
                          Width="40"
                          MinWidth="40"
                          CellStyle="{StaticResource FirstColumnCellStyle}"
                          HeaderStyle="{StaticResource FirstColumnHeaderStyle}">
                          <DataGridTemplateColumn.Header>
                            <CheckBox
                              MinWidth="0"
                              MinHeight="0"
                              Margin="0"
                              Padding="0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Click="OnToggleAll"
                              IsChecked="{Binding DataContext.AllDownloadsSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                              IsThreeState="True"
                              ToolTip="Отметить или снять все строки" />
                          </DataGridTemplateColumn.Header>
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <CheckBox
                                MinWidth="0"
                                MinHeight="0"
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  всё по содержимому, а путь забирает остаток ширины  -->
                        <DataGridTextColumn
                          Width="Auto"
                          MaxWidth="220"
                          Binding="{Binding ServerLabel}"
                          Header="Сервер" />
                        <DataGridTextColumn
                          Width="Auto"
                          Binding="{Binding Kind}"
                          Header="Тип" />
                        <DataGridTextColumn
                          Width="Auto"
                          MaxWidth="360"
                          Binding="{Binding Name}"
                          Header="Имя" />
                        <!--  показывают надпись, а сортируются по значению — иначе даты по дню, а размеры по первой цифре  -->
                        <DataGridTextColumn
                          Width="Auto"
                          Binding="{Binding SizeText}"
                          Header="Размер"
                          SortMemberPath="SizeBytes" />
                        <DataGridTextColumn
                          Width="Auto"
                          Binding="{Binding ModifiedText}"
                          Header="Дата изменения"
                          SortMemberPath="Modified" />
                        <!--  в конце строки — копировать и вписать путь, как в адресной строке «Проводника»  -->
                        <DataGridTemplateColumn
                          Width="*"
                          MinWidth="150"
                          Header="Путь на сервере"
                          SortMemberPath="Path">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <DockPanel>
                                <StackPanel
                                  Margin="4,0,2,0"
                                  DockPanel.Dock="Right"
                                  Orientation="Horizontal">
                                  <Button
                                    Click="OnCopyRowPath"
                                    Style="{StaticResource RowPathButtonStyle}"
                                    ToolTip="Копировать путь">
                                    <ui:SymbolIcon FontSize="14" Symbol="Copy24" />
                                  </Button>
                                  <Button
                                    controls:LockMute.IsOn="{Binding DataContext.IsPaneLocked, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Click="OnEditRowPath"
                                    Style="{StaticResource RowPathButtonStyle}"
                                    ToolTip="Вписать другой путь на этом сервере">
                                    <ui:SymbolIcon FontSize="14" Symbol="Edit24" />
                                  </Button>
                                  <Button
                                    controls:LockMute.IsOn="{Binding DataContext.IsPaneLocked, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Click="OnRemoveRow"
                                    Style="{StaticResource RowPathButtonStyle}"
                                    ToolTip="Убрать строку из списка — на сервере ничего не удаляется">
                                    <ui:SymbolIcon FontSize="14" Symbol="Delete24" />
                                  </Button>
                                </StackPanel>
                                <TextBlock
                                  VerticalAlignment="Center"
                                  Text="{Binding Path}"
                                  TextTrimming="CharacterEllipsis" />
                              </DockPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="12"
                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                      IsHitTestVisible="False"
                      Text="Что скачивать — выберите файлы и папки кнопкой «Выбрать на сервере» или двойным щелчком здесь.">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Downloads.Count}" Value="0">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>

                    <!--  плюс и минус окна — под последней строкой, столбиком со значками строки; место ставит код  -->
                    <StackPanel
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Orientation="Horizontal">
                      <Button
                        controls:LockMute.IsOn="{Binding IsPaneLocked}"
                        Click="OnAddWindow"
                        Style="{StaticResource RowPathButtonStyle}"
                        ToolTip="Добавить окно ниже — выполнится после этого">
                        <ui:SymbolIcon FontSize="18" Symbol="Add24" />
                      </Button>
                      <Button
                        controls:LockMute.IsOn="{Binding IsPaneLocked}"
                        Click="OnRemoveWindow"
                        Style="{StaticResource RowPathButtonStyle}"
                        ToolTip="Убрать это окно"
                        Visibility="{Binding IsMulti, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon FontSize="18" Symbol="Subtract24" />
                      </Button>
                    </StackPanel>
                  </Grid>

                  <!--  низ окна: всё по центру между разделительной линией и нижней границей.
                        Слева номер, справа от него папка  -->
                  <Border
                    Grid.Row="1"
                    Padding="12,4,4,4"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <!--  номер и название — на тусклых оранжевых плашках с рамкой, как у окна команды.
                            Плашка названия всегда одной длины: длинное название ужимает шрифт  -->
                      <StackPanel
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding IsMulti, Converter={StaticResource BoolToVis}}">
                        <Border
                          Padding="7,1,7,2"
                          Background="#38E07A1F"
                          BorderBrush="#80E07A1F"
                          BorderThickness="1"
                          CornerRadius="4">
                          <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="12"
                            Text="{Binding NumberText}" />
                        </Border>
                        <Border
                          Width="114"
                          MinHeight="21"
                          Margin="4,0,0,0"
                          Padding="7,1,7,2"
                          Background="#38E07A1F"
                          BorderBrush="#80E07A1F"
                          BorderThickness="1"
                          CornerRadius="4"
                          MouseLeftButtonDown="OnWindowNameDown"
                          ToolTip="Двойной щелчок — изменить название окна"
                          Visibility="{Binding ShowsName, Converter={StaticResource BoolToVis}}">
                          <controls:FitTextBlock
                            VerticalAlignment="Center"
                            MaxFontSize="12"
                            MaxLines="1"
                            MinFontSize="6"
                            Text="{Binding NameText}"
                            TextWeight="Normal" />
                        </Border>
                      </StackPanel>

                      <TextBlock
                        Grid.Column="1"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="Куда скачать:" />
                      <!--  копировать путь — в конце поля; крестик очистки убран, чтобы не лёг под значок  -->
                      <ui:TextBox
                        Grid.Column="2"
                        Padding="10,5,36,6"
                        controls:LockMute.IsOn="{Binding IsPaneLocked}"
                        ClearButtonEnabled="False"
                        IsEnabled="{Binding IsNotPaneLocked}"
                        FontSize="12"
                        PlaceholderText="папка на этом компьютере"
                        Text="{Binding LocalFolder, UpdateSourceTrigger=PropertyChanged}" />
                      <Button
                        Grid.Column="2"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="OnCopyLocalFolder"
                        Style="{StaticResource RowPathButtonStyle}"
                        ToolTip="Копировать путь">
                        <ui:SymbolIcon FontSize="14" Symbol="Copy24" />
                      </Button>
                      <ui:Button
                        Grid.Column="3"
                        Margin="4,0,0,0"
                        Height="Auto"
                        VerticalAlignment="Stretch"
                        controls:LockMute.IsOn="{Binding IsPaneLocked}"
                        Click="OnPickFolder"
                        Content="Обзор…"
                        Icon="{ui:SymbolIcon FolderOpen24}"
                        Style="{StaticResource ToolButtonStyle}" />
                      <ui:Button
                        Grid.Column="4"
                        Margin="4,0,0,0"
                        Height="Auto"
                        VerticalAlignment="Stretch"
                        Click="OnOpenFolder"
                        Content="Открыть"
                        Icon="{ui:SymbolIcon Open24}"
                        Style="{StaticResource ToolButtonStyle}"
                        ToolTip="Открыть папку в проводнике" />
                    </Grid>
                  </Border>
                </Grid>
              </Border>

              <!--  окно в фокусе — рамка цвета нижней линии поля, как в «Командах»: панель кнопок и параметры показывают его.
                    Под замком её нет: в окне почти ничего нельзя  -->
              <Border
                x:Name="FocusRing"
                BorderBrush="{DynamicResource TextControlFocusedBorderBrush}"
                BorderThickness="2"
                CornerRadius="4"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

              <!--  окно встало на суммах — ненадолго красная рамка, как у ярлыка с ошибкой  -->
              <Border
                x:Name="FailRing"
                BorderBrush="#E85C5C"
                BorderThickness="2"
                CornerRadius="4"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMulti}" Value="True" />
                  <Condition Binding="{Binding IsFocused}" Value="True" />
                  <Condition Binding="{Binding IsPaneLocked}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMulti}" Value="True" />
                  <Condition Binding="{Binding IsFailed}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="FailRing" Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!--  границу над нижней полосой двигают мышью  -->
    <GridSplitter
      Grid.Row="2"
      Height="4"
      HorizontalAlignment="Stretch"
      Background="Transparent"
      DragCompleted="OnBandMoved" />

    <!--  нижняя полоса, как на «Копировании»: слева пуск и параметры, справа мини-терминал  -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="BandLeft" Width="1*" MinWidth="345" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="2*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <Grid x:Name="BandLeftBlock" Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <StackPanel
      x:Name="RunRow"
      Grid.Row="0"
      Orientation="Horizontal">
      <!--  «Везде» решает, где пойдут «Выполнить» и «Сравнить»: эта вкладка или все вкладки раздела  -->
      <ui:Button
        Margin="0,0,8,0"
        Appearance="Primary"
        Click="OnDownload"
        Content="Выполнить"
        Icon="{ui:SymbolIcon ArrowDownload24}"
        IsEnabled="{Binding CopyBatch.IsIdle}"
        ToolTip="Пути всех окон этой вкладки, окна сверху вниз. Со свитчем «Везде» — на всех вкладках сразу, после вопроса" />

      <ui:Button
        x:Name="CompareButton"
        Click="OnCompare"
        Content="Сравнить"
        Icon="{ui:SymbolIcon BranchCompare24}"
        IsEnabled="{Binding CopyBatch.IsIdle}"
        ToolTip="Сверяет файлы сервера с папкой здесь по правилам из параметров и ничего не скачивает. В статусе — сошлось или нет, что именно отличается — в выводе" />

      <ui:ToggleSwitch
        x:Name="EverywhereSwitch"
        Margin="12,0,0,0"
        VerticalAlignment="Center"
        Content="Везде"
        IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=Everywhere, Mode=TwoWay}"
        Style="{StaticResource DangerSwitchStyle}"
        ToolTip="Включено — «Выполнить» скачивает сразу на всех вкладках, каждая со своими путями, папкой и серверами, после вопроса. «Сравнить» тоже идёт на всех. Итог по каждой — на её ярлыке" />
    </StackPanel>

        <!--  параметры — общий блок для «Копирования», «Скачивания» и «Проводника»  -->
        <controls:TransferOptionsPanel Grid.Row="1" Margin="0,4,0,0" Direction="Download" />
      </Grid>

      <GridSplitter
        Grid.Column="1"
        Width="4"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        DragCompleted="OnBandMoved" />

      <!--  высота полосы — по левой части: окна мини-терминала её не раздувают, а листаются  -->
      <controls:MiniTerminal
        Grid.Column="2"
        Height="{Binding ActualHeight, ElementName=BandLeftBlock}"
        VerticalAlignment="Top"
        TagRowHeight="{Binding ActualHeight, ElementName=RunRow}" />
    </Grid>
  </Grid>
</Page>
