<Page
  x:Class="MultiServerSync.Views.Pages.DownloadPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:services="clr-namespace:MultiServerSync.Services"
  Title="Скачивание"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.CanContentScroll="False">

  <Page.Resources>
    <Style
      x:Key="ToolButtonStyle"
      BasedOn="{StaticResource {x:Type ui:Button}}"
      TargetType="ui:Button">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
  </Page.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Grid.Row="0"
      Margin="0,0,0,4"
      FontSize="12"
      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
      Text="{Binding DownloadInfo}" />

    <StackPanel Grid.Row="1" Orientation="Horizontal">
      <ui:Button
        Click="OnBrowseAdd"
        Content="Выбрать на сервере"
        Icon="{ui:SymbolIcon FolderOpen24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Обзор сервера: выделите файлы и папки (Ctrl, Shift) и нажмите «Выбрать». Ничего не выделено — берётся открытая папка" />
      <!--  заданы исключения — значок на зелёной плашке: видно, что не всё из списка скачается.
            Плашка выходит влево на свой отступ, чтобы значок стоял там же, где у соседних кнопок  -->
      <ui:Button
        Click="OnExcludes"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Что не скачивать: маски вроде *.log, node_modules, .git">
        <StackPanel Orientation="Horizontal">
          <Border Margin="-2,0,6,0" Style="{StaticResource ExcludeBadgeStyle}">
            <ui:SymbolIcon Style="{StaticResource ExcludeGlyphStyle}" />
          </Border>
          <TextBlock VerticalAlignment="Center" Text="Исключения" />
        </StackPanel>
      </ui:Button>
      <ui:Button
        Click="OnRemoveSelected"
        Content="Убрать строки"
        Icon="{ui:SymbolIcon Subtract24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Убрать выделенные пути из списка" />
      <ui:Button
        Click="OnClear"
        Content="Очистить"
        Icon="{ui:SymbolIcon Delete24}"
        Style="{StaticResource ToolButtonStyle}" />
      <ui:Button
        Click="OnRefresh"
        Content="Обновить"
        Icon="{ui:SymbolIcon ArrowClockwise24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Перечитать с серверов размер, число файлов и дату изменения; пока страница открыта, это происходит само каждые 30 секунд" />
    </StackPanel>

    <!--  таблица того же вида, что список файлов на «Копировании»: строка — файл или папка
          на своём сервере, выбранные обзором; качаются строки с галочкой  -->
    <Grid Grid.Row="2" Margin="0,4,0,0">
      <DataGrid
        x:Name="PathsList"
        CellStyle="{StaticResource AppDataGridCellStyle}"
        ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
        ItemsSource="{Binding Downloads}"
        MouseDoubleClick="OnRowDoubleClick"
        RowStyle="{StaticResource AppDataGridRowStyle}"
        Style="{StaticResource AppDataGridStyle}"
        VerticalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTemplateColumn
            Width="40"
            CellStyle="{StaticResource FirstColumnCellStyle}"
            HeaderStyle="{StaticResource FirstColumnHeaderStyle}">
            <DataGridTemplateColumn.Header>
              <CheckBox
                MinWidth="0"
                MinHeight="0"
                Margin="0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="OnToggleAll"
                IsChecked="{Binding DataContext.AllDownloadsSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                IsThreeState="True"
                ToolTip="Отметить или снять все строки" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox
                  MinWidth="0"
                  MinHeight="0"
                  Margin="0"
                  Padding="0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!--  всё по содержимому, а путь забирает остаток ширины  -->
          <DataGridTextColumn
            Width="Auto"
            MaxWidth="220"
            Binding="{Binding ServerLabel}"
            Header="Сервер" />
          <DataGridTextColumn
            Width="Auto"
            Binding="{Binding Kind}"
            Header="Тип" />
          <DataGridTextColumn
            Width="Auto"
            MaxWidth="360"
            Binding="{Binding Name}"
            Header="Имя" />
          <!--  показывают надпись, а сортируются по значению — иначе даты по дню, а размеры по первой цифре  -->
          <DataGridTextColumn
            Width="Auto"
            Binding="{Binding SizeText}"
            Header="Размер"
            SortMemberPath="SizeBytes" />
          <DataGridTextColumn
            Width="Auto"
            Binding="{Binding ModifiedText}"
            Header="Дата изменения"
            SortMemberPath="Modified" />
          <!--  в конце строки — копировать и вписать путь, как в адресной строке «Проводника»  -->
          <DataGridTemplateColumn
            Width="*"
            MinWidth="150"
            Header="Путь на сервере"
            SortMemberPath="Path">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <DockPanel>
                  <StackPanel
                    Margin="4,0,2,0"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                      Click="OnCopyRowPath"
                      Style="{StaticResource RowPathButtonStyle}"
                      ToolTip="Копировать путь">
                      <ui:SymbolIcon FontSize="14" Symbol="Copy24" />
                    </Button>
                    <Button
                      Click="OnEditRowPath"
                      Style="{StaticResource RowPathButtonStyle}"
                      ToolTip="Вписать другой путь на этом сервере">
                      <ui:SymbolIcon FontSize="14" Symbol="Edit24" />
                    </Button>
                    <Button
                      Click="OnRemoveRow"
                      Style="{StaticResource RowPathButtonStyle}"
                      ToolTip="Убрать строку из списка — на сервере ничего не удаляется">
                      <ui:SymbolIcon FontSize="14" Symbol="Delete24" />
                    </Button>
                  </StackPanel>
                  <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding Path}"
                    TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="12"
        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
        IsHitTestVisible="False"
        Text="Что скачивать — выберите файлы и папки кнопкой «Выбрать на сервере».">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Downloads.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <Grid Grid.Row="3" Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock
        Grid.Column="0"
        Margin="0,0,4,0"
        VerticalAlignment="Center"
        FontSize="12"
        Text="Куда скачать:" />
      <ui:TextBox
        Grid.Column="1"
        FontSize="12"
        PlaceholderText="папка на этом компьютере"
        Text="{Binding LocalFolder, UpdateSourceTrigger=PropertyChanged}" />
      <ui:Button
        Grid.Column="2"
        Margin="4,0,0,0"
        Height="Auto"
        VerticalAlignment="Stretch"
        Click="OnPickFolder"
        Content="Обзор…"
        Icon="{ui:SymbolIcon FolderOpen24}"
        Style="{StaticResource ToolButtonStyle}" />
      <ui:Button
        Grid.Column="3"
        Margin="4,0,0,0"
        Height="Auto"
        VerticalAlignment="Stretch"
        Click="OnOpenFolder"
        Content="Открыть"
        Icon="{ui:SymbolIcon Open24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Открыть папку в проводнике" />
    </Grid>

    <!--  параметры — общий блок для «Копирования», «Скачивания» и «Проводника»  -->
    <controls:TransferOptionsPanel Grid.Row="4" Margin="0,4,0,0" Direction="Download" />

    <StackPanel
      Grid.Row="5"
      Margin="0,4,0,0"
      Orientation="Horizontal">
      <!--  «Везде» решает, где пойдут «Выполнить» и «Сравнить»: эта вкладка или все вкладки раздела  -->
      <ui:Button
        Margin="0,0,8,0"
        Appearance="Primary"
        Click="OnDownload"
        Content="Выполнить"
        Icon="{ui:SymbolIcon ArrowDownload24}"
        IsEnabled="{Binding CopyBatch.IsIdle}"
        ToolTip="Пути этой вкладки с её отмеченных серверов. Со свитчем «Везде» — на всех вкладках сразу, после вопроса" />

      <ui:Button
        x:Name="CompareButton"
        Click="OnCompare"
        Content="Сравнить"
        Icon="{ui:SymbolIcon BranchCompare24}"
        IsEnabled="{Binding CopyBatch.IsIdle}"
        ToolTip="Сверяет файлы сервера с папкой здесь по правилам из параметров и ничего не скачивает. В статусе — сошлось или нет, что именно отличается — в выводе" />

      <ui:ToggleSwitch
        x:Name="EverywhereSwitch"
        Margin="12,0,0,0"
        VerticalAlignment="Center"
        Content="Везде"
        IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=Everywhere, Mode=TwoWay}"
        Style="{StaticResource DangerSwitchStyle}"
        ToolTip="Включено — «Выполнить» скачивает сразу на всех вкладках, каждая со своими путями, папкой и серверами, после вопроса. «Сравнить» тоже идёт на всех. Итог по каждой — на её ярлыке" />
    </StackPanel>

    <!--  плашка о нажатии — не в углу окна, а сразу справа от главной кнопки; место ставит Follow  -->
    <controls:ActionToast
      x:Name="BarToast"
      Grid.RowSpan="9"
      Grid.ColumnSpan="2" />
  </Grid>
</Page>
