<Page
  x:Class="MultiServerSync.Views.Pages.ExplorerPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Проводник"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.CanContentScroll="False">

  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Page.Resources>

  <!--  всё место — двум панелям, как в WinSCP: копирование и его параметры — кнопками на самих панелях  -->
  <Grid Margin="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  слева этот компьютер, справа сервер  -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <controls:FilePane x:Name="LocalPane" Grid.Column="0" />
      <controls:FilePane x:Name="RemotePane" Grid.Column="2" />
    </Grid>

    <!--  ход копирования  -->
    <Grid Grid.Row="1">
      <controls:TransferStrip
        x:Name="ProgressBox"
        Margin="0,4,0,0"
        Batch="{Binding DataContext.CopyBatch, RelativeSource={RelativeSource AncestorType=Page}}"
        DataContext="{Binding CopyBatch.Results[0], FallbackValue={x:Null}}"
        Visibility="{Binding DataContext.CopyBatch.IsRunning, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
    </Grid>
  </Grid>
</Page>
