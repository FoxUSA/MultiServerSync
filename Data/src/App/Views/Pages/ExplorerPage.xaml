<Page
  x:Class="MultiServerSync.Views.Pages.ExplorerPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Проводник"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.CanContentScroll="False">

  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  копирование между панелями: стрелка в сторону назначения и подпись словами  -->
    <Style
      x:Key="TransferButtonStyle"
      BasedOn="{StaticResource {x:Type ui:Button}}"
      TargetType="ui:Button">
      <Setter Property="Width" Value="92" />
      <Setter Property="Padding" Value="4,6" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  слева этот компьютер, справа сервер — как в WinSCP  -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <controls:FilePane x:Name="LocalPane" Grid.Column="0" />

      <StackPanel
        Grid.Column="1"
        Margin="4,0"
        VerticalAlignment="Center">
        <ui:Button
          x:Name="UploadButton"
          Click="OnUpload"
          IsEnabled="False"
          Style="{StaticResource TransferButtonStyle}"
          ToolTip="Выделенное слева — в открытую справа папку сервера">
          <StackPanel>
            <ui:SymbolIcon HorizontalAlignment="Center" Symbol="ArrowRight24" />
            <TextBlock TextAlignment="Center" Text="Скопировать&#x0a;на сервер" />
          </StackPanel>
        </ui:Button>
        <ui:Button
          x:Name="DownloadButton"
          Click="OnDownload"
          IsEnabled="False"
          Style="{StaticResource TransferButtonStyle}"
          ToolTip="Выделенное справа — в открытую слева папку компьютера">
          <StackPanel>
            <ui:SymbolIcon HorizontalAlignment="Center" Symbol="ArrowLeft24" />
            <TextBlock TextAlignment="Center" Text="Скопировать&#x0a;с сервера" />
          </StackPanel>
        </ui:Button>
      </StackPanel>

      <controls:FilePane x:Name="RemotePane" Grid.Column="2" />
    </Grid>

    <!--  параметры копирования — тот же блок, что у «Копирования» и «Скачивания», всегда на виду  -->
    <controls:TransferOptionsPanel
      x:Name="Options"
      Grid.Row="1"
      Margin="0,4,0,0"
      Direction="Both" />

    <!--  ход копирования  -->
    <Grid Grid.Row="2" Margin="0,4,0,0">
      <controls:TransferStrip
        x:Name="ProgressBox"
        Batch="{Binding DataContext.CopyBatch, RelativeSource={RelativeSource AncestorType=Page}}"
        DataContext="{Binding CopyBatch.Results[0], FallbackValue={x:Null}}"
        Visibility="{Binding DataContext.CopyBatch.IsRunning, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
    </Grid>
  </Grid>
</Page>
