<Page
  x:Class="MultiServerSync.Views.Pages.FilesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:services="clr-namespace:MultiServerSync.Services"
  Title="Копирование"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  AllowDrop="True"
  DragOver="OnDragOver"
  Drop="OnDrop"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.CanContentScroll="False">

  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--  общая таблица окон: номер окна, разделитель группы, строка пустого окна — одни с «Скачиванием»  -->
        <ResourceDictionary Source="/Themes/CopyWindowStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  опции ровными рядами: одинаковая высота, один отступ  -->

    <!--  выбор режима отправки: та же плотность, что и у галочек рядом  -->

    <Style
      x:Key="ToolButtonStyle"
      BasedOn="{StaticResource {x:Type ui:Button}}"
      TargetType="ui:Button">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    </ResourceDictionary>
  </Page.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="4" />
      <RowDefinition x:Name="BandRow" Height="Auto" MinHeight="138" />
    </Grid.RowDefinitions>

    <!--  сводка — в ряду кнопок, справа: отдельной строки под неё нет  -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Orientation="Horizontal">
      <!--  окон несколько — номер окна в фокусе: кнопки ряда, сводка и параметры работают с ним  -->
      <Border
        Height="28"
        MinWidth="34"
        Margin="0,0,4,0"
        Padding="7,0"
        Background="#26E07A1F"
        BorderBrush="#80E07A1F"
        BorderThickness="1"
        CornerRadius="4"
        ToolTip="Кнопки ряда, сводка и параметры — для этого окна. Другое окно — щелчок по его номеру"
        Visibility="{Binding IsMultiWindow, Converter={StaticResource BoolToVis}}">
        <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontFamily="Consolas"
          FontSize="12"
          Text="{Binding FocusedWindow.NumberText}" />
      </Border>
      <!--  «Открыть» и «Исключения» под замком не гаснут: посмотреть можно, изменить — нет  -->
      <ui:Button
        Click="OnAdd"
        Content="Открыть"
        Icon="{ui:SymbolIcon FolderOpen24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Открывает проводник. Выделяйте что угодно — файлы, папки, вперемешку, хоть Ctrl+A — и нажимайте «Добавить»" />
      <!--  заданы исключения — значок на зелёной плашке: видно, что не всё из списка поедет.
            Плашка выходит влево на свой отступ, чтобы значок стоял там же, где у соседних кнопок  -->
      <ui:Button
        Click="OnExcludes"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Что не копировать: маски вроде *.log, node_modules, .git">
        <StackPanel Orientation="Horizontal">
          <Border Margin="-2,0,6,0" Style="{StaticResource ExcludeBadgeStyle}">
            <ui:SymbolIcon Style="{StaticResource ExcludeGlyphStyle}" />
          </Border>
          <TextBlock VerticalAlignment="Center" Text="Исключения" />
        </StackPanel>
      </ui:Button>
      <ui:Button
        controls:LockMute.IsOn="{Binding IsPaneLocked}"
        Click="OnClearItems"
        Content="Очистить"
        Icon="{ui:SymbolIcon Delete24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Убрать отмеченные строки, а если отметок нет — все. Файлы не трогаются" />
      <ui:Button
        Click="OnRefreshItems"
        Content="Обновить"
        Icon="{ui:SymbolIcon ArrowClockwise24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Перечитать размер и дату изменения с диска" />
      <!--  окон несколько — у каждого могут быть свои серверы; надпись — что кнопка сделает  -->
      <ui:Button
        controls:LockMute.IsOn="{Binding IsPaneLocked}"
        Click="OnSeparateServers"
        Content="{Binding SeparateServersCaption}"
        Icon="{ui:SymbolIcon Server24}"
        ToolTip="Свои целевые серверы у каждого окна: номер окна в панели слева показывает и меняет его серверы"
        Visibility="{Binding IsMultiWindow, Converter={StaticResource BoolToVis}}">
        <!--  только появилась — оранжевая, пока человек не уйдёт с вкладки; цвета плашки сервера (ServerTagStyle)  -->
        <ui:Button.Style>
          <Style BasedOn="{StaticResource ToolButtonStyle}" TargetType="ui:Button">
            <Style.Triggers>
              <DataTrigger Binding="{Binding HintSeparateServers}" Value="True">
                <Setter Property="Background" Value="#26E07A1F" />
                <Setter Property="BorderBrush" Value="#80E07A1F" />
                <Setter Property="MouseOverBackground" Value="#38E07A1F" />
                <Setter Property="MouseOverBorderBrush" Value="#80E07A1F" />
                <Setter Property="PressedBackground" Value="#4AE07A1F" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ui:Button.Style>
      </ui:Button>
    </StackPanel>
    </Grid>

    <!--  Таблица одна на все окна вкладки: шапка общая, строки окна — группой под тонким разделителем с номером
          и названием. Под таблицей — строки пути окон стопкой. Окно в фокусе выбирается щелчком по номеру:
          кнопки сверху, сводка и параметры показывают его  -->
    <Border
      Grid.Row="1"
      Margin="0,4,0,0"
      Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="4">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <DataGrid
            x:Name="RowsGrid"
            BorderThickness="0"
            CanUserReorderColumns="False"
            CellStyle="{StaticResource AppDataGridCellStyle}"
            ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
            Loaded="OnWindowGridLoaded"
            MouseDoubleClick="OnGridDoubleClick"
            RowHeight="24"
            RowStyleSelector="{StaticResource WindowRowSelector}"
            Style="{StaticResource AppDataGridStyle}"
            VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.IsVirtualizingWhenGrouping="True">
            <DataGrid.GroupStyle>
              <GroupStyle ContainerStyle="{StaticResource WindowGroupStyle}" />
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn
                Width="26"
                MinWidth="26"
                CanUserResize="False"
                CellStyle="{StaticResource CheckColumnCellStyle}"
                HeaderStyle="{StaticResource CheckColumnHeaderStyle}">
                <DataGridTemplateColumn.Header>
                  <Viewbox
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <CheckBox
                      MinWidth="0"
                      MinHeight="0"
                      Margin="0"
                      Padding="0"
                      Click="OnToggleAllItems"
                      IsChecked="{Binding DataContext.AllWindowsItemsSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                      IsThreeState="True"
                      ToolTip="Отметить или снять все объекты всех окон" />
                  </Viewbox>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Viewbox
                      Width="16"
                      Height="16"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                      <CheckBox
                        MinWidth="0"
                        MinHeight="0"
                        Margin="0"
                        Padding="0"
                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Viewbox>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!--  всё по содержимому, а путь забирает остаток ширины  -->
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding Kind}"
                Header="Тип" />
              <DataGridTextColumn
                Width="Auto"
                MaxWidth="360"
                Binding="{Binding Name}"
                Header="Имя" />
              <!--
                Столбцы показывают готовую надпись, а сортируются по самому значению:
                по тексту «25.06.2026» сравнивается сначала день, и порядок выходит не по времени.
              -->
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding SizeText}"
                Header="Размер"
                SortMemberPath="SizeBytes" />
              <!--  какие из четырёх видны — решает SizeColumns  -->
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding KeptSizeText}"
                Header="Размер*"
                SortMemberPath="KeptBytes"
                Visibility="Collapsed" />
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding FilesText}"
                Header="Файлов"
                SortMemberPath="Files" />
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding KeptFilesText}"
                Header="Файлов*"
                SortMemberPath="KeptFiles"
                Visibility="Collapsed" />
              <DataGridTextColumn
                Width="Auto"
                Binding="{Binding ModifiedText}"
                Header="Дата изменения"
                SortMemberPath="Modified" />
              <!--  в конце строки — копировать и вписать путь, как в адресной строке «Проводника»  -->
              <DataGridTemplateColumn
                Width="*"
                MinWidth="150"
                Header="Локальный путь"
                SortMemberPath="FullPath">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <StackPanel
                        Margin="4,0,2,0"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                        <Button
                          Click="OnCopyItemPath"
                          Style="{StaticResource RowPathButtonStyle}"
                          ToolTip="Копировать путь">
                          <ui:SymbolIcon FontSize="14" Symbol="Copy24" />
                        </Button>
                        <Button
                          controls:LockMute.IsOn="{Binding DataContext.IsPaneLocked, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          Click="OnEditItemPath"
                          Style="{StaticResource RowPathButtonStyle}"
                          ToolTip="Вписать другой путь">
                          <ui:SymbolIcon FontSize="14" Symbol="Edit24" />
                        </Button>
                        <Button
                          controls:LockMute.IsOn="{Binding DataContext.IsPaneLocked, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          Click="OnRemoveItemRow"
                          Style="{StaticResource RowPathButtonStyle}"
                          ToolTip="Убрать строку из списка — сам файл не трогается">
                          <ui:SymbolIcon FontSize="14" Symbol="Delete24" />
                        </Button>
                      </StackPanel>
                      <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding FullPath}"
                        TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            IsHitTestVisible="False"
            Text="Список пуст — нажмите «Открыть», дважды щёлкните здесь или перетащите файлы в окно">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Items.Count, ElementName=RowsGrid}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <!--  плюс единственного окна — под последней строкой, столбиком со значками строки; место ставит код.
                Окон несколько — плюс и минус у каждого на его разделителе  -->
          <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMultiWindow}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Button
              controls:LockMute.IsOn="{Binding IsPaneLocked}"
              Click="OnAddWindow"
              Style="{StaticResource RowPathButtonStyle}"
              ToolTip="Добавить окно ниже — выполнится после этого">
              <ui:SymbolIcon FontSize="18" Symbol="Add24" />
            </Button>
          </StackPanel>
        </Grid>

        <!--  строка пути одна — окна в фокусе: номер, «Обзор», «Листинг», путь; общие предупреждения вкладки справа  -->
        <Border
          Grid.Row="1"
          DataContext="{Binding FocusedWindow}"
          Padding="4"
          Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" MinWidth="420" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  номер окна в фокусе, как у «Открыть»: строка пути одна и переключается вместе с фокусом  -->
            <Border
              Grid.Column="0"
              MinWidth="34"
              Margin="0,0,4,0"
              Padding="7,0"
              Background="#26E07A1F"
              BorderBrush="#80E07A1F"
              BorderThickness="1"
              CornerRadius="4"
              ToolTip="Путь окна в фокусе. Другое окно — щелчок по его номеру в таблице"
              Visibility="{Binding IsMulti, Converter={StaticResource BoolToVis}}">
              <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                FontSize="12"
                Text="{Binding NumberText}" />
            </Border>

            <Grid Grid.Column="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!--  вместо подписи «Путь на сервере» — что делать с путём: выбрать на сервере или показать его содержимое  -->
              <StackPanel
                Grid.Column="0"
                Margin="0,0,4,0"
                Orientation="Horizontal">
                <!--  под замком не гаснет: смотреть можно, выбрать — нет  -->
                <ui:Button
                  Height="Auto"
                  VerticalAlignment="Stretch"
                  Click="OnBrowse"
                  Content="Обзор"
                  Icon="{ui:SymbolIcon FolderOpen24}"
                  Style="{StaticResource ToolButtonStyle}"
                  ToolTip="Выбрать путь на сервере" />
                <ui:Button
                  Height="Auto"
                  Margin="4,0,0,0"
                  VerticalAlignment="Stretch"
                  Click="OnListing"
                  Content="Листинг"
                  Icon="{ui:SymbolIcon List24}"
                  Style="{StaticResource ToolButtonStyle}"
                  ToolTip="ls -la этого пути на отмеченных серверах — вывод в журнал" />
              </StackPanel>
              <!--  невидимое поле, как «Куда скачать» на «Скачивании», задаёт высоту строки: у списка своя больше  -->
              <ui:TextBox
                x:Name="PathHeight"
                Grid.Column="1"
                Padding="10,5,36,6"
                ClearButtonEnabled="False"
                Focusable="False"
                FontSize="12"
                IsHitTestVisible="False"
                Visibility="Hidden" />
              <ComboBox
                Grid.Column="1"
                Height="{Binding ActualHeight, ElementName=PathHeight}"
                MinHeight="0"
                Padding="10,0,10,0"
                controls:LockMute.IsOn="{Binding IsPaneLocked}"
                VerticalContentAlignment="Center"
                DropDownOpened="OnPathDropDownOpened"
                FontSize="12"
                IsEditable="True"
                IsTextSearchEnabled="False"
                IsEnabled="{Binding IsNotPaneLocked}"
                ItemsSource="{Binding Source={x:Static services:AppState.Current}, Path=Settings.RemotePathHistory}"
                Text="{Binding RemotePath, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Путь одинаков для всех отмеченных серверов этого окна. История общая для всех окон и вкладок, крестик убирает строку.">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                        Grid.Column="0"
                        MinWidth="280"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Text="{Binding}"
                        TextTrimming="CharacterEllipsis" />
                      <Button
                        x:Name="Remove"
                        Grid.Column="1"
                        Click="OnRemoveRemotePath"
                        Style="{StaticResource HistoryRemoveButtonStyle}" />
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                        <Setter TargetName="Remove" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <!--  копировать путь — внутри поля, слева от стрелки списка  -->
              <Button
                Grid.Column="1"
                Margin="0,0,34,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="OnCopyRemotePath"
                Style="{StaticResource RowPathButtonStyle}"
                ToolTip="Копировать путь">
                <ui:SymbolIcon FontSize="14" Symbol="Copy24" />
              </Button>
            </Grid>

            <Border
              Grid.Column="2"
              MaxWidth="520"
              Margin="4,0,0,0"
              Padding="10,4"
              VerticalAlignment="Stretch"
              Background="#26E07A1F"
              BorderBrush="#80E07A1F"
              BorderThickness="1"
              CornerRadius="4"
              Cursor="Hand"
              MouseLeftButtonUp="OnNoticeClick"
              ToolTip="Открыть личную вкладку команд"
              Visibility="{Binding DataContext.HasNotices, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
              <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding DataContext.Notices, RelativeSource={RelativeSource AncestorType=Page}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="#E07A1F"
                        Symbol="Warning24" />
                      <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#E07A1F"
                        Text="{Binding}"
                        TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!--  границу над нижней полосой двигают мышью  -->
    <GridSplitter
      Grid.Row="2"
      Height="4"
      HorizontalAlignment="Stretch"
      Background="Transparent"
      DragCompleted="OnBandMoved" />

    <!--  нижняя полоса: слева пуск и параметры, справа мини-терминал; граница между ними тоже двигается  -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="BandLeft" Width="1*" MinWidth="345" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="2*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <Grid x:Name="BandLeftBlock" Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <StackPanel
      x:Name="RunRow"
      Grid.Row="0"
      Orientation="Horizontal">
      <!--  «Везде» решает, где пойдут «Выполнить» и «Сравнить»: эта вкладка или все вкладки раздела  -->
      <ui:Button
        Margin="0,0,8,0"
        Appearance="Primary"
        Click="OnCopy"
        Content="Выполнить"
        Icon="{ui:SymbolIcon ArrowUpload24}"
        IsEnabled="{Binding CopyBatch.IsIdle}"
        ToolTip="Файлы всех окон этой вкладки на её отмеченные серверы, окна сверху вниз. Со свитчем «Везде» — на всех вкладках сразу, после вопроса" />

      <ui:Button
        x:Name="CompareButton"
        Click="OnCompare"
        Content="Сравнить"
        Icon="{ui:SymbolIcon BranchCompare24}"
        IsEnabled="{Binding CopyBatch.IsIdle}"
        ToolTip="Сверяет файлы вкладки с сервером по правилам из параметров и ничего не копирует. В статусе — сошлось или нет, что именно отличается — в выводе" />

      <ui:ToggleSwitch
        x:Name="EverywhereSwitch"
        Margin="12,0,0,0"
        VerticalAlignment="Center"
        Content="Везде"
        IsChecked="{Binding Source={x:Static services:AppState.Current}, Path=Everywhere, Mode=TwoWay}"
        Style="{StaticResource DangerSwitchStyle}"
        ToolTip="Включено — «Выполнить» копирует сразу на всех вкладках, каждая со своими файлами, путём и серверами, после вопроса. «Сравнить» тоже идёт на всех. Итог по каждой — на её ярлыке" />
    </StackPanel>

        <!--  параметры — общий блок для «Копирования», «Скачивания» и «Проводника»  -->
        <controls:TransferOptionsPanel Grid.Row="1" Margin="0,4,0,0" Direction="Upload" />
      </Grid>

      <GridSplitter
        Grid.Column="1"
        Width="4"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        DragCompleted="OnBandMoved" />

      <!--  высота полосы — по левой части: окна мини-терминала её не раздувают, а листаются  -->
      <controls:MiniTerminal
        Grid.Column="2"
        Height="{Binding ActualHeight, ElementName=BandLeftBlock}"
        VerticalAlignment="Top"
        TagRowHeight="{Binding ActualHeight, ElementName=RunRow}" />
    </Grid>
  </Grid>
</Page>
