<Page
  x:Class="MultiServerSync.Views.Pages.FilesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Копирование"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  AllowDrop="True"
  DragOver="OnDragOver"
  Drop="OnDrop"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.CanContentScroll="False">

  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  опции ровными рядами: одинаковая высота, один отступ  -->

    <!--  выбор режима отправки: та же плотность, что и у галочек рядом  -->

    <Style
      x:Key="ToolButtonStyle"
      BasedOn="{StaticResource {x:Type ui:Button}}"
      TargetType="ui:Button">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
  </Page.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Grid.Row="0"
      Margin="0,0,0,4"
      FontSize="12"
      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
      Text="{Binding TargetsInfo}" />

    <StackPanel Grid.Row="1" Orientation="Horizontal">
      <ui:Button
        Click="OnAdd"
        Content="Открыть"
        Icon="{ui:SymbolIcon FolderOpen24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Открывает проводник. Выделяйте что угодно — файлы, папки, вперемешку, хоть Ctrl+A — и нажимайте «Добавить»" />
      <ui:Button
        Click="OnExcludes"
        Content="{Binding ExcludeCaption}"
        Icon="{ui:SymbolIcon Filter24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Что не копировать: маски вроде *.log, node_modules, .git" />
      <ui:Button
        Click="OnRemoveSelected"
        Content="Убрать строки"
        Icon="{ui:SymbolIcon Subtract24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Убрать выделенные строки из списка" />
      <ui:Button
        Click="OnClearItems"
        Content="Очистить"
        Icon="{ui:SymbolIcon Delete24}"
        Style="{StaticResource ToolButtonStyle}" />
      <ui:Button
        Click="OnRefreshItems"
        Content="Обновить"
        Icon="{ui:SymbolIcon ArrowClockwise24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Перечитать размер и дату изменения с диска" />
      <TextBlock
        VerticalAlignment="Center"
        FontSize="11"
        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
        Text="или перетащите в окно"
        TextTrimming="CharacterEllipsis"
        ToolTip="Файлы и папки можно перетаскивать прямо в окно программы" />
    </StackPanel>

    <DataGrid
      x:Name="ItemsGrid"
      Grid.Row="2"
      Margin="0,4,0,0"
      CellStyle="{StaticResource AppDataGridCellStyle}"
      ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
      ItemsSource="{Binding Items}"
      RowStyle="{StaticResource AppDataGridRowStyle}"
      Style="{StaticResource AppDataGridStyle}"
      VerticalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTemplateColumn
          Width="40"
          CellStyle="{StaticResource FirstColumnCellStyle}"
          HeaderStyle="{StaticResource FirstColumnHeaderStyle}">
          <DataGridTemplateColumn.Header>
            <CheckBox
              MinWidth="0"
              MinHeight="0"
              Margin="0"
              Padding="0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Click="OnToggleAllItems"
              IsChecked="{Binding DataContext.AllItemsSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
              IsThreeState="True"
              ToolTip="Отметить или снять все объекты" />
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox
                MinWidth="0"
                MinHeight="0"
                Margin="0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!--  всё по содержимому, а путь забирает остаток ширины  -->
        <DataGridTextColumn
          Width="Auto"
          Binding="{Binding Kind}"
          Header="Тип" />
        <DataGridTextColumn
          Width="Auto"
          MaxWidth="360"
          Binding="{Binding Name}"
          Header="Имя" />
        <!--
          Столбцы показывают готовую надпись, а сортируются по самому значению:
          по тексту «25.06.2026» сравнивается сначала день, и порядок выходит не по времени.
        -->
        <DataGridTextColumn
          Width="Auto"
          Binding="{Binding SizeText}"
          Header="Размер"
          SortMemberPath="SizeBytes" />
        <DataGridTextColumn
          Width="Auto"
          Binding="{Binding ModifiedText}"
          Header="Дата изменения"
          SortMemberPath="Modified" />
        <DataGridTextColumn
          Width="*"
          MinWidth="150"
          Binding="{Binding FullPath}"
          Header="Локальный путь">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!--  слева путь на сервере, справа — плашка того, что требует внимания, пока не устранено  -->
    <Grid Grid.Row="3" Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
          Grid.Column="0"
          Margin="0,0,4,0"
          VerticalAlignment="Center"
          FontSize="12"
          Text="Путь на сервере:" />
        <ComboBox
          x:Name="RemotePathBox"
          Grid.Column="1"
          VerticalContentAlignment="Center"
          FontSize="12"
          IsEditable="True"
          Text="{Binding RemotePath, UpdateSourceTrigger=PropertyChanged}"
          ToolTip="Путь одинаков для всех отмеченных серверов этой вкладки. История общая для всех вкладок, крестик убирает строку.">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  MinWidth="280"
                  VerticalAlignment="Center"
                  FontFamily="Consolas"
                  Text="{Binding}"
                  TextTrimming="CharacterEllipsis" />
                <Button
                  x:Name="Remove"
                  Grid.Column="1"
                  Click="OnRemoveRemotePath"
                  Style="{StaticResource HistoryRemoveButtonStyle}" />
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                  <Setter TargetName="Remove" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ui:Button
          Grid.Column="2"
          Margin="4,0,0,0"
          Height="Auto"
          VerticalAlignment="Stretch"
          Click="OnBrowse"
          Content="Обзор на сервере…"
          Icon="{ui:SymbolIcon FolderOpen24}"
          Style="{StaticResource ToolButtonStyle}" />
      </Grid>

      <Border
        Grid.Column="1"
        Margin="4,0,0,0"
        Padding="10,4"
        VerticalAlignment="Stretch"
        Background="#1FE89A3C"
        BorderBrush="#E89A3C"
        BorderThickness="1"
        CornerRadius="4"
        Cursor="Hand"
        MouseLeftButtonUp="OnNoticeClick"
        ToolTip="Открыть личную вкладку команд"
        Visibility="{Binding HasNotices, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
        <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Notices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                  Grid.Column="0"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  FontSize="16"
                  Foreground="#E89A3C"
                  Symbol="Warning24" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="#E89A3C"
                  Text="{Binding}"
                  TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </Grid>

    <!--  параметры — общий блок для «Копирования», «Скачивания» и «Проводника»  -->
    <controls:TransferOptionsPanel Grid.Row="4" Margin="0,4,0,0" Direction="Upload" />

    <StackPanel
      Grid.Row="5"
      Margin="0,4,0,0"
      Orientation="Horizontal">
      <!--  обе кнопки есть на любой вкладке, включая первую  -->
      <ui:Button
        Margin="0,0,4,0"
        Appearance="Primary"
        Click="OnCopy"
        Content="Выполнить тут"
        Icon="{ui:SymbolIcon ArrowUpload24}"
        IsEnabled="{Binding CopyBatch.IsIdle}"
        ToolTip="Файлы этой вкладки на её отмеченные серверы" />

      <ui:Button
        x:Name="EverywhereButton"
        Appearance="Danger"
        Click="OnCopyEverywhere"
        Content="Выполнить везде"
        Icon="{ui:SymbolIcon ArrowUpload24}"
        IsEnabled="{Binding CopyBatch.IsIdle}"
        ToolTip="Запускает копирование сразу во всех вкладках — каждая со своими файлами, путём и серверами. Итог по каждой видно на её ярлыке." />
    </StackPanel>

    <!--  плашка о нажатии — не в углу окна, а сразу справа от главной кнопки; место ставит Follow  -->
    <controls:ActionToast
      x:Name="BarToast"
      Grid.RowSpan="9"
      Grid.ColumnSpan="2" />
  </Grid>
</Page>
