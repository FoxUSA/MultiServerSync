<Page
  x:Class="MultiServerSync.Views.Pages.FilesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Копирование"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  AllowDrop="True"
  DragOver="OnDragOver"
  Drop="OnDrop"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.CanContentScroll="False">

  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  опции ровными рядами: одинаковая высота, один отступ  -->
    <Style
      x:Key="OptionStyle"
      BasedOn="{StaticResource {x:Type CheckBox}}"
      TargetType="CheckBox">
      <Setter Property="Margin" Value="0,3,16,3" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!--  выбор режима отправки: та же плотность, что и у галочек рядом  -->
    <Style
      x:Key="ChoiceStyle"
      BasedOn="{StaticResource {x:Type RadioButton}}"
      TargetType="RadioButton">
      <Setter Property="Margin" Value="0,3,16,3" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
      x:Key="ToolButtonStyle"
      BasedOn="{StaticResource {x:Type ui:Button}}"
      TargetType="ui:Button">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </Page.Resources>

  <Grid Margin="20,12,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Grid.Row="0"
      Margin="0,0,0,8"
      FontSize="12"
      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
      Text="{Binding TargetsInfo}" />

    <StackPanel Grid.Row="1" Orientation="Horizontal">
      <ui:Button
        Click="OnAdd"
        Content="Открыть"
        Icon="{ui:SymbolIcon FolderOpen24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Открывает проводник. Выделяйте что угодно — файлы, папки, вперемешку, хоть Ctrl+A — и нажимайте «Добавить»" />
      <ui:Button
        Click="OnExcludes"
        Content="{Binding ExcludeCaption}"
        Icon="{ui:SymbolIcon Filter24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Что не копировать: маски вроде *.log, node_modules, .git" />
      <ui:Button
        Click="OnRemoveSelected"
        Content="Убрать строки"
        Icon="{ui:SymbolIcon Subtract24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Убрать выделенные строки из списка" />
      <ui:Button
        Click="OnClearItems"
        Content="Очистить"
        Icon="{ui:SymbolIcon Delete24}"
        Style="{StaticResource ToolButtonStyle}" />
      <ui:Button
        Click="OnRefreshItems"
        Content="Обновить"
        Icon="{ui:SymbolIcon ArrowClockwise24}"
        Style="{StaticResource ToolButtonStyle}"
        ToolTip="Перечитать размер и дату изменения с диска" />
      <TextBlock
        Margin="10,0,0,0"
        VerticalAlignment="Center"
        FontSize="11"
        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
        Text="или перетащите в окно"
        TextTrimming="CharacterEllipsis"
        ToolTip="Файлы и папки можно перетаскивать прямо в окно программы" />
    </StackPanel>

    <DataGrid
      x:Name="ItemsGrid"
      Grid.Row="2"
      Margin="0,8,0,0"
      CellStyle="{StaticResource AppDataGridCellStyle}"
      ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
      ItemsSource="{Binding Items}"
      RowStyle="{StaticResource AppDataGridRowStyle}"
      Style="{StaticResource AppDataGridStyle}"
      VerticalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTemplateColumn
          Width="40"
          CellStyle="{StaticResource FirstColumnCellStyle}"
          HeaderStyle="{StaticResource FirstColumnHeaderStyle}">
          <DataGridTemplateColumn.Header>
            <CheckBox
              MinWidth="0"
              MinHeight="0"
              Margin="0"
              Padding="0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Click="OnToggleAllItems"
              IsChecked="{Binding DataContext.AllItemsSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
              IsThreeState="True"
              ToolTip="Отметить или снять все объекты" />
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox
                MinWidth="0"
                MinHeight="0"
                Margin="0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!--  всё по содержимому, а путь забирает остаток ширины  -->
        <DataGridTextColumn
          Width="Auto"
          Binding="{Binding Kind}"
          Header="Тип" />
        <DataGridTextColumn
          Width="Auto"
          MaxWidth="360"
          Binding="{Binding Name}"
          Header="Имя" />
        <!--
          Столбцы показывают готовую надпись, а сортируются по самому значению:
          по тексту «25.06.2026» сравнивается сначала день, и порядок выходит не по времени.
        -->
        <DataGridTextColumn
          Width="Auto"
          Binding="{Binding SizeText}"
          Header="Размер"
          SortMemberPath="SizeBytes" />
        <DataGridTextColumn
          Width="Auto"
          Binding="{Binding ModifiedText}"
          Header="Дата изменения"
          SortMemberPath="Modified" />
        <DataGridTextColumn
          Width="*"
          MinWidth="150"
          Binding="{Binding FullPath}"
          Header="Локальный путь">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock
        Grid.Column="0"
        Margin="0,0,10,0"
        VerticalAlignment="Center"
        FontSize="12"
        Text="Путь на сервере:" />
      <ComboBox
        x:Name="RemotePathBox"
        Grid.Column="1"
        VerticalContentAlignment="Center"
        FontSize="12"
        IsEditable="True"
        Text="{Binding RemotePath, UpdateSourceTrigger=PropertyChanged}"
        ToolTip="Путь одинаков для всех отмеченных серверов этой вкладки. История общая для всех вкладок, крестик убирает строку.">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                MinWidth="280"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                Text="{Binding}"
                TextTrimming="CharacterEllipsis" />
              <Button
                x:Name="Remove"
                Grid.Column="1"
                Click="OnRemoveRemotePath"
                Style="{StaticResource HistoryRemoveButtonStyle}" />
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                <Setter TargetName="Remove" Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ui:Button
        Grid.Column="2"
        Margin="8,0,0,0"
        Click="OnBrowse"
        Content="Обзор на сервере…"
        Icon="{ui:SymbolIcon FolderOpen24}"
        Style="{StaticResource ToolButtonStyle}" />
    </Grid>

    <!--  параметры — ровной сеткой, а не вразнобой  -->
    <Border
      Grid.Row="4"
      Margin="0,10,0,0"
      Padding="12,8"
      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="4">
      <StackPanel>
        <TextBlock
          Margin="0,0,0,6"
          FontSize="11"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="ПАРАМЕТРЫ КОПИРОВАНИЯ" />

        <TextBlock
          Margin="0,0,0,2"
          FontSize="11"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="Отправлять на сервер:" />

        <UniformGrid Columns="2" Rows="2">
          <RadioButton
            Content="все отмеченные файлы"
            GroupName="SendMode"
            IsChecked="{Binding SendEverything, Mode=TwoWay}"
            Style="{StaticResource ChoiceStyle}"
            ToolTip="Каждый отмеченный файл отправляется заново, что бы ни лежало на сервере. Ничего не сверяется — дольше всего, но результат заведомо совпадает с локальным." />
          <RadioButton
            Content="только те, которых нет на сервере"
            GroupName="SendMode"
            IsChecked="{Binding SendMissingOnly, Mode=TwoWay}"
            Style="{StaticResource ChoiceStyle}"
            ToolTip="Существующие файлы не трогаются совсем, даже если они отличаются." />
          <RadioButton
            Content="отличающиеся по дате изменения"
            GroupName="SendMode"
            IsChecked="{Binding SendByDate, Mode=TwoWay}"
            Style="{StaticResource ChoiceStyle}"
            ToolTip="Файл отправляется, если дата изменения разошлась с серверной в любую сторону. Размер сверяется в любом случае, при любом из четырёх вариантов: недокачанный файл заменяется, что бы ни говорила его дата. Требует галочки «сохранять дату изменения» — иначе на сервере стоит время заливки и сверять нечего." />
          <RadioButton
            Content="отличающиеся по контрольной сумме"
            GroupName="SendMode"
            IsChecked="{Binding SendByHash, Mode=TwoWay}"
            Style="{StaticResource ChoiceStyle}"
            ToolTip="Перед копированием на сервере считается sha256sum всех файлов назначения, и отправляется только то, что отличается по содержимому. Даты при этом не смотрятся вообще. Надёжнее всего, но на больших объёмах это отдельная долгая сверка до начала копирования." />
        </UniformGrid>

        <Separator Margin="0,6,0,4" Opacity="0.4" />

        <UniformGrid Columns="2" Rows="1">
          <CheckBox
            Content="сохранять дату изменения"
            IsChecked="{Binding PreserveTimestamps, Mode=TwoWay}"
            Style="{StaticResource OptionStyle}"
            ToolTip="После загрузки файлу на сервере проставляется дата изменения локального оригинала" />
          <CheckBox
            Content="после копирования сверять суммы"
            IsChecked="{Binding VerifyChecksums, Mode=TwoWay}"
            Style="{StaticResource OptionStyle}"
            ToolTip="Проверка уже отправленного: после копирования на сервере запускается sha256sum и хеши сравниваются с локальными. Проверяются только те файлы, которые ушли в этот заход." />
        </UniformGrid>
      </StackPanel>
    </Border>

    <StackPanel
      Grid.Row="5"
      Margin="0,10,0,0"
      Orientation="Horizontal">
      <!--  обе кнопки есть на любой вкладке, включая первую  -->
      <ui:Button
        Margin="0,0,10,0"
        Appearance="Primary"
        Click="OnCopy"
        Content="Выполнить тут"
        Icon="{ui:SymbolIcon ArrowUpload24}"
        IsEnabled="{Binding CopyBatch.IsIdle}"
        ToolTip="Файлы этой вкладки на её отмеченные серверы" />

      <ui:Button
        Appearance="Danger"
        Click="OnCopyEverywhere"
        Content="Выполнить везде"
        Icon="{ui:SymbolIcon ArrowUpload24}"
        IsEnabled="{Binding CopyBatch.IsIdle}"
        ToolTip="Запускает копирование сразу во всех вкладках — каждая со своими файлами, путём и серверами. Итог по каждой видно на её ярлыке." />
    </StackPanel>
  </Grid>
</Page>
