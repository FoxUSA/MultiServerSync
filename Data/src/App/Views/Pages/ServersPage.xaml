<Page
  x:Class="MultiServerSync.Views.Pages.ServersPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:MultiServerSync.Views.Controls"
  Title="Серверы"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.CanContentScroll="False">

  <Page.Resources>
    <!--  колонки обеих таблиц одинаковые; галочка в шапке — своя у каждой, её ставит код  -->
    <DataTemplate x:Key="RowCheckTemplate">
      <CheckBox
        MinWidth="0"
        MinHeight="0"
        Margin="0"
        Padding="0"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>
  </Page.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="150" />
    </Grid.RowDefinitions>

    <!--  кнопки общие: действуют на выбранную таблицу (в рамке). Нижний зазор 4 до таблиц дают сами кнопки  -->
    <WrapPanel Grid.Row="0">
      <ui:Button
        Margin="0,0,4,4"
        Appearance="Primary"
        Click="OnAdd"
        Content="Добавить"
        Icon="{ui:SymbolIcon Add24}" />
      <ui:Button
        Margin="0,0,4,4"
        Click="OnTest"
        Content="Проверить связь"
        Icon="{ui:SymbolIcon PlugConnected24}" />
      <ui:Button
        Margin="0,0,4,4"
        Click="OnEdit"
        Content="Изменить"
        Icon="{ui:SymbolIcon Edit24}" />
      <ui:Button
        Margin="0,0,4,4"
        Click="OnDuplicate"
        Content="Дублировать"
        Icon="{ui:SymbolIcon Copy24}" />
      <ui:Button
        Margin="0,0,4,4"
        Click="OnDelete"
        Content="Удалить"
        Icon="{ui:SymbolIcon Delete24}" />
      <Separator Margin="0,0,4,4" />
      <ui:Button
        x:Name="MoveButton"
        Margin="0,0,4,4"
        Click="OnMove"
        Content="Перенести"
        Icon="{ui:SymbolIcon ArrowRight24}"
        ToolTip="Отмеченные серверы выбранной таблицы уходят в набор другой таблицы" />
      <ui:Button
        x:Name="CopyButton"
        Margin="0,0,4,4"
        Click="OnCopyOver"
        Content="Скопировать"
        Icon="{ui:SymbolIcon ArrowRight24}"
        ToolTip="Копии отмеченных серверов выбранной таблицы — в набор другой таблицы, оригиналы остаются на месте" />
      <controls:UndoButtons Margin="0,0,4,4" VerticalAlignment="Center" />
    </WrapPanel>

    <!--  два набора рядом, как панели «Проводника»: щелчок выбирает таблицу, ярлык наверху меняет её набор  -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid
        Grid.Column="0"
        Background="Transparent"
        PreviewMouseDown="OnLeftPicked">
        <DataGrid
          x:Name="LeftGrid"
          CellStyle="{StaticResource AppDataGridCellStyle}"
          ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
          GotKeyboardFocus="OnLeftPicked"
          ItemsSource="{Binding State.ServersLeft.Rows}"
          MouseDoubleClick="OnGridDoubleClick"
          RowStyle="{StaticResource AppDataGridRowStyle}"
          Style="{StaticResource AppDataGridStyle}"
          VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTemplateColumn
              Width="44"
              MinWidth="44"
              CellStyle="{StaticResource FirstColumnCellStyle}"
              CellTemplate="{StaticResource RowCheckTemplate}"
              HeaderStyle="{StaticResource FirstColumnHeaderStyle}">
              <DataGridTemplateColumn.Header>
                <CheckBox
                  MinWidth="0"
                  MinHeight="0"
                  Margin="0"
                  Padding="0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Click="OnToggleAllLeft"
                  IsChecked="{Binding DataContext.State.ServersLeft.AllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                  IsThreeState="True"
                  ToolTip="Отметить или снять все серверы набора" />
              </DataGridTemplateColumn.Header>
            </DataGridTemplateColumn>
            <DataGridTextColumn
              Width="Auto"
              Binding="{Binding Server.Name}"
              Header="Имя" />
            <DataGridTextColumn
              Width="Auto"
              Binding="{Binding Server.Host}"
              Header="IP / хост" />
            <DataGridTextColumn
              Width="Auto"
              Binding="{Binding Server.Port}"
              Header="Порт" />
            <DataGridTextColumn
              Width="Auto"
              Binding="{Binding Server.User}"
              Header="Пользователь" />
            <!--  заметки забирают всё оставшееся место; правятся в окне сервера  -->
            <DataGridTextColumn
              Width="*"
              MinWidth="100"
              Binding="{Binding Server.NotesLine}"
              Header="Заметки" />
          </DataGrid.Columns>
        </DataGrid>

        <!--  выбранная таблица — в синей рамке акцента, её набор наверху — в оранжевой; мышь рамка не ловит  -->
        <Border
          x:Name="LeftFrame"
          BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
          BorderThickness="2"
          CornerRadius="4"
          IsHitTestVisible="False"
          Visibility="Collapsed" />
      </Grid>

      <Grid
        Grid.Column="2"
        Background="Transparent"
        PreviewMouseDown="OnRightPicked">
        <DataGrid
          x:Name="RightGrid"
          CellStyle="{StaticResource AppDataGridCellStyle}"
          ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
          GotKeyboardFocus="OnRightPicked"
          ItemsSource="{Binding State.ServersRight.Rows}"
          MouseDoubleClick="OnGridDoubleClick"
          RowStyle="{StaticResource AppDataGridRowStyle}"
          Style="{StaticResource AppDataGridStyle}"
          VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTemplateColumn
              Width="44"
              MinWidth="44"
              CellStyle="{StaticResource FirstColumnCellStyle}"
              CellTemplate="{StaticResource RowCheckTemplate}"
              HeaderStyle="{StaticResource FirstColumnHeaderStyle}">
              <DataGridTemplateColumn.Header>
                <CheckBox
                  MinWidth="0"
                  MinHeight="0"
                  Margin="0"
                  Padding="0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Click="OnToggleAllRight"
                  IsChecked="{Binding DataContext.State.ServersRight.AllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                  IsThreeState="True"
                  ToolTip="Отметить или снять все серверы набора" />
              </DataGridTemplateColumn.Header>
            </DataGridTemplateColumn>
            <DataGridTextColumn
              Width="Auto"
              Binding="{Binding Server.Name}"
              Header="Имя" />
            <DataGridTextColumn
              Width="Auto"
              Binding="{Binding Server.Host}"
              Header="IP / хост" />
            <DataGridTextColumn
              Width="Auto"
              Binding="{Binding Server.Port}"
              Header="Порт" />
            <DataGridTextColumn
              Width="Auto"
              Binding="{Binding Server.User}"
              Header="Пользователь" />
            <DataGridTextColumn
              Width="*"
              MinWidth="100"
              Binding="{Binding Server.NotesLine}"
              Header="Заметки" />
          </DataGrid.Columns>
        </DataGrid>

        <Border
          x:Name="RightFrame"
          BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
          BorderThickness="2"
          CornerRadius="4"
          IsHitTestVisible="False"
          Visibility="Collapsed" />
      </Grid>
    </Grid>
  </Grid>
</Page>
