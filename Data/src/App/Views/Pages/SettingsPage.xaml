<Page
  x:Class="MultiServerSync.Views.Pages.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Настройки"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.CanContentScroll="False">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12">
      <TextBlock
        Margin="0,0,0,4"
        FontSize="24"
        FontWeight="SemiBold"
        Text="Настройки" />

      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Info24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Версия программы" />
            <TextBlock
              x:Name="ManifestPathText"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardControl.Header>
        <TextBlock
          x:Name="VersionText"
          VerticalAlignment="Center"
          FontWeight="SemiBold" />
      </ui:CardControl>

      <!--  обновление: само окно с шагами и полосой — то же, что открывает кнопка в шапке  -->
      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowDownload24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Обновление программы" />
            <TextBlock
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="Проверяется при каждом запуске. Заменяются Data и MultiServerSync.exe, UserData не трогается"
              TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:Button
          MinWidth="200"
          Click="OnUpdateClick"
          Content="Проверить обновления"
          Icon="{ui:SymbolIcon ArrowSync24}" />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Globe24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Страница утилиты" />
            <TextBlock
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="https://byfox.dev/multiserversync/" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:Button
          MinWidth="200"
          Click="OnOpenSite"
          Content="Открыть" />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Тема оформления" />
            <TextBlock
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="Светлая, тёмная или как в системе" />
          </StackPanel>
        </ui:CardControl.Header>
        <ComboBox
          x:Name="ThemeBox"
          Width="180"
          SelectionChanged="OnThemeChanged">
          <ComboBoxItem Content="Тёмная" Tag="Dark" />
          <ComboBoxItem Content="Светлая" Tag="Light" />
          <ComboBoxItem Content="Как в системе" Tag="System" />
        </ComboBox>
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Flash24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Одновременных подключений" />
            <TextBlock
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="Сколько серверов обрабатывать параллельно" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:NumberBox
          x:Name="ParallelBox"
          Width="140"
          ClearButtonEnabled="False"
          Maximum="64"
          Minimum="1"
          ValueChanged="OnNumbersChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Timer24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Таймаут подключения, сек" />
            <TextBlock
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="Сколько ждать установления SSH-сессии" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:NumberBox
          x:Name="ConnectTimeoutBox"
          Width="140"
          ClearButtonEnabled="False"
          Maximum="600"
          Minimum="5"
          ValueChanged="OnNumbersChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Clock24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Таймаут команды, сек" />
            <TextBlock
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="Максимальное время выполнения одной команды" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:NumberBox
          x:Name="CommandTimeoutBox"
          Width="140"
          ClearButtonEnabled="False"
          Maximum="86400"
          Minimum="5"
          ValueChanged="OnNumbersChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ShieldCheckmark24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Защита от двойного запуска команды" />
            <TextBlock
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="Ту же команду в течение 3 секунд после окончания — только повторным нажатием"
              TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch x:Name="RepeatGuardSwitch" Click="OnRepeatGuardChanged" />
      </ui:CardControl>

      <TextBlock
        Margin="0,0,0,4"
        FontSize="18"
        FontWeight="SemiBold"
        Text="Расположение файлов" />

      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Folder24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="UserData — настройки, серверы, вкладки, логи" />
            <TextBlock
              x:Name="UserDataPathText"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:Button
          Click="OnOpenUserData"
          Content="Открыть"
          Icon="{ui:SymbolIcon FolderOpen24}" />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Apps24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Data — программа и библиотеки" />
            <TextBlock
              x:Name="DataPathText"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:Button
          Click="OnOpenData"
          Content="Открыть"
          Icon="{ui:SymbolIcon FolderOpen24}" />
      </ui:CardControl>

      <!--  пароли в servers.json всегда зашифрованы; выбирается только чем  -->
      <ui:CardControl Icon="{ui:SymbolIcon LockClosed24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Пароли серверов" />
            <TextBlock
              x:Name="ProtectionText"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal">
          <ui:Button
            x:Name="ChangeMasterButton"
            Margin="0,0,4,0"
            Click="OnChangeMaster"
            Content="Сменить пароль" />
          <ComboBox
            x:Name="ProtectionBox"
            MinWidth="200"
            SelectionChanged="OnProtectionChanged">
            <ComboBoxItem Content="Учётная запись Windows" Tag="Windows" />
            <ComboBoxItem Content="Мастер-пароль" Tag="Master" />
          </ComboBox>
        </StackPanel>
      </ui:CardControl>
    </StackPanel>
  </ScrollViewer>
</Page>
